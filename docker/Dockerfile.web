# ============================================================================
# Dockerfile.web — Multi-stage build for AuraOS Next.js web application
#
# Stages:
#   1. deps    — Install all workspace dependencies (frozen lockfile)
#   2. build   — Build the Next.js app with standalone output
#   3. runner  — Minimal production image (node:20-alpine, ~100MB)
#
# Usage:
#   docker build -f docker/Dockerfile.web -t auraos-web:latest .
#   docker run -p 3000:3000 --env-file .env auraos-web:latest
# ============================================================================

# ---- Stage 1: deps ----------------------------------------------------------
FROM node:20-alpine AS deps

# Install pnpm and libc compatibility for native modules
RUN apk add --no-cache libc6-compat curl && \
    npm install -g pnpm@8

WORKDIR /app

# Copy workspace manifests first (better layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json ./

# Copy package.json files for all workspace packages
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
COPY packages/@aura/auth/package.json ./packages/@aura/auth/
COPY packages/@aura/cache/package.json ./packages/@aura/cache/
COPY packages/@aura/config/package.json ./packages/@aura/config/
COPY packages/@aura/database/package.json ./packages/@aura/database/
COPY packages/@aura/events/package.json ./packages/@aura/events/
COPY packages/@aura/i18n/package.json ./packages/@aura/i18n/
COPY packages/@aura/messaging/package.json ./packages/@aura/messaging/
COPY packages/@aura/monitoring/package.json ./packages/@aura/monitoring/
COPY packages/@aura/scheduler/package.json ./packages/@aura/scheduler/
COPY packages/@aura/search/package.json ./packages/@aura/search/
COPY packages/@aura/types/package.json ./packages/@aura/types/
COPY packages/@aura/ui/package.json ./packages/@aura/ui/
COPY packages/@aura/utils/package.json ./packages/@aura/utils/

# Install ALL dependencies (including devDeps needed for Prisma generate)
RUN pnpm install --frozen-lockfile

# ---- Stage 2: build ---------------------------------------------------------
FROM node:20-alpine AS build

ARG NODE_ENV=production
ARG NEXT_TELEMETRY_DISABLED=1
ARG BUILD_SHA=unknown

ENV NODE_ENV=${NODE_ENV}
ENV NEXT_TELEMETRY_DISABLED=${NEXT_TELEMETRY_DISABLED}
ENV BUILD_SHA=${BUILD_SHA}

RUN apk add --no-cache libc6-compat && \
    npm install -g pnpm@8

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules 2>/dev/null || true

# Copy source code
COPY . .

# Generate Prisma client
RUN pnpm --filter @aura/database prisma generate

# Build shared packages that the web app depends on
RUN pnpm --filter @aura/types build || true
RUN pnpm --filter @aura/utils build || true
RUN pnpm --filter @aura/config build || true

# Build the Next.js app (standalone output configured in next.config.js)
RUN pnpm --filter web build

# ---- Stage 3: runner --------------------------------------------------------
FROM node:20-alpine AS runner

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Security: run as non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

WORKDIR /app

# Copy standalone Next.js output
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

# Expose port
EXPOSE 3000

USER nextjs

# Health check — calls /api/health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

CMD ["node", "apps/web/server.js"]
