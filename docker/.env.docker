# Docker Environment Configuration Template
# Copy this file to .env in the root directory and update values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_DB=auraos
POSTGRES_USER=auraos
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# Prisma Database URL (constructed from above)
DATABASE_URL=postgresql://auraos:change_this_password@postgres:5432/auraos?schema=public

# Test database (if needed)
DATABASE_TEST_URL=postgresql://auraos:change_this_password@postgres:5432/auraos_test?schema=public

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_URL=redis://:change_this_redis_password@redis:6379
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379
REDIS_ENABLED=true

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Generate secure random strings for production:
# openssl rand -base64 32
JWT_SECRET=change_this_to_a_very_long_random_string_minimum_32_characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SIGNUP=false
ENABLE_MFA=true
ENABLE_SSO=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# MONITORING & ERROR TRACKING (Optional)
# =============================================================================
# Sentry DSN (leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# =============================================================================
# DOCKER STARTUP OPTIONS
# =============================================================================
# Run database migrations on startup
RUN_MIGRATIONS=true

# Seed database on first startup (disable after first run)
SEED_DATABASE=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# WEB SERVER PORTS
# =============================================================================
WEB_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# DEVELOPMENT TOOLS (Optional - use with docker-compose --profile dev)
# =============================================================================
PGADMIN_EMAIL=admin@auraos.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_COMMANDER_PORT=8081

# =============================================================================
# EMAIL (Optional - if using email features)
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@auraos.com

# =============================================================================
# FILE STORAGE (Optional - AWS S3)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_S3_PRESIGNED_URL_EXPIRATION=3600

# =============================================================================
# ADDITIONAL SERVICES (Optional)
# =============================================================================
# Add any additional service configurations here
