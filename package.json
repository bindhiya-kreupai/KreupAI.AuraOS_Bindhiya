{
  "name": "kreupai-hcm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "verify": "node verify-setup.js",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "nav:check": "node scripts/nav-smoke.js",
    "check:tenant-isolation": "node scripts/check-tenant-isolation.mjs",
    "check:authz-coverage": "node scripts/check-authorization-coverage.mjs",
    "check:query-perf": "node scripts/check-query-perf.mjs",
    "check:api-contract": "node scripts/generate-api-contract.mjs --check",
    "check:mobile-drift": "node scripts/check-mobile-contract-drift.mjs",
    "check:all": "pnpm check:tenant-isolation && pnpm check:authz-coverage && pnpm check:query-perf && pnpm check:api-contract && pnpm check:mobile-drift",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "prisma": "^7.8.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.7.0",
    "turbo": "^2.6.1",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7"
    }
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
