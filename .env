# Database Configuration (Prisma uses DATABASE_URL)
# Using Supabase connection pooler (IPv4 compatible) - PORT 6543 for transaction mode
# Direct connection on port 5432 for migrations and better reliability
DATABASE_URL="postgresql://postgres.wifwncfxcmnytogddrnr:SHohDaAm2G9Wm2n9@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.wifwncfxcmnytogddrnr:SHohDaAm2G9Wm2n9@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
PG_URI="postgresql://postgres.wifwncfxcmnytogddrnr:SHohDaAm2G9Wm2n9@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"
PG_HOST=aws-1-ap-south-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.wifwncfxcmnytogddrnr
PG_PASSWORD=SHohDaAm2G9Wm2n9
pool_mode=transaction

# JWT Configuration
JWT_SECRET=your_super_long_random_secret_key_123456
JWT_EXPIRES_IN="24h"        # Access token expiration (e.g., 15m, 1h, 24h)
JWT_REFRESH_EXPIRES_IN="7d" # Refresh token expiration (e.g., 7d, 30d)

# Application Configuration
NODE_ENV="development"       # development | production | test
PORT="3006"                  # Application port

# Security Configuration
BCRYPT_SALT_ROUNDS="10"      # Number of salt rounds for bcrypt

# ===========================================
# Redis Cache Configuration
# ===========================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="auraos_redis_2024"

# Optional: Email Configuration (for notifications)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="noreply@example.com"

# Optional: AWS S3 Configuration (for file uploads)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="your-bucket-name"

# Optional: Sentry Configuration (for error tracking)
# SENTRY_DSN="your-sentry-dsn"
# SENTRY_ENVIRONMENT="production"

# ===========================================
# RabbitMQ Message Queue Configuration
# ===========================================
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="auraos"
RABBITMQ_PASSWORD="auraos_rabbit_2024"
RABBITMQ_VHOST="/auraos"

# ===========================================
# Elasticsearch Configuration
# ===========================================
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""

# ===========================================
# OAuth2 Providers Configuration
# ===========================================
# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft Azure AD
AZURE_AD_CLIENT_ID="your-azure-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
AZURE_AD_TENANT_ID="common"

# Okta
OKTA_DOMAIN="your-domain.okta.com"
OKTA_CLIENT_ID="your-okta-client-id"
OKTA_CLIENT_SECRET="your-okta-client-secret"

# ===========================================
# SAML Configuration
# ===========================================
SAML_ENTRY_POINT="https://your-idp.com/sso/saml"
SAML_ISSUER="auraos"
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----"
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----"

# ===========================================
# APM & Monitoring (Datadog) Configuration
# ===========================================
DD_SERVICE="auraos-api"
DD_ENV="development"
DD_VERSION="1.0.0"
DD_AGENT_HOST="localhost"
DD_TRACE_ENABLED="true"
DD_PROFILING_ENABLED="false"
DD_RUNTIME_METRICS_ENABLED="true"
DD_LOG_LEVEL="info"
DD_TRACE_SAMPLE_RATE="1.0"

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"   # Max requests per window

# ===========================================
# Feature Flags
# ===========================================
ENABLE_MFA="true"
ENABLE_SSO="true"
ENABLE_AUDIT_LOGGING="true"
ENABLE_SEARCH="true"
ENABLE_QUEUE="true"
ENABLE_EVENTS="true"
