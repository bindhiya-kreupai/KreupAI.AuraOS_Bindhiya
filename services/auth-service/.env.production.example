# ============================================================================
# auth-service — Production Environment Template
# ============================================================================
#
# Each service has its own .env.production.example with the env vars it
# requires at boot. Per #51, the dev tooling sources the root .env so values
# defined once at the workspace root propagate to every services/* process.
#
# In production, real values live in your secrets manager (see #26). Generate
# cryptographic keys with:  openssl rand -base64 32
#
# The service refuses to boot without JWT_SECRET (config.ts).
# ============================================================================

NODE_ENV="production"
PORT="3001"
HOST="0.0.0.0"
GRPC_PORT="50051"

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"

# ---------------------------------------------------------------------------
# Redis (session store, rate-limit counter)
# ---------------------------------------------------------------------------
REDIS_URL="redis://redis.internal:6379"
REDIS_PASSWORD="REPLACE_WITH_redis_password"

# ---------------------------------------------------------------------------
# JWT (REQUIRED — service throws FATAL on missing JWT_SECRET)
# ---------------------------------------------------------------------------
JWT_SECRET="REPLACE_WITH_openssl_rand_base64_32"
JWT_EXPIRY="1h"
REFRESH_TOKEN_EXPIRY="7d"

# ---------------------------------------------------------------------------
# OAuth2 providers (required only if ENABLE_SSO=true)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://auraos.example.com/api/auth/callback/google"

AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"
AZURE_REDIRECT_URI="https://auraos.example.com/api/auth/callback/microsoft"

OKTA_DOMAIN=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_REDIRECT_URI="https://auraos.example.com/api/auth/callback/okta"

# ---------------------------------------------------------------------------
# SAML SP
# ---------------------------------------------------------------------------
SAML_ENTRY_POINT=""
SAML_ISSUER="auraos"
SAML_IDP_CERT=""
SAML_SP_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# MFA
# ---------------------------------------------------------------------------
ENABLE_MFA="true"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ---------------------------------------------------------------------------
# Datadog APM
# ---------------------------------------------------------------------------
DD_TRACE_ENABLED="true"
DD_SERVICE="auth-service"
DD_ENV="production"
DD_VERSION="1.0.0"
DD_AGENT_HOST="datadog-agent.internal"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS="12"

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_SSO="false"
ENABLE_AUDIT_LOGGING="true"
