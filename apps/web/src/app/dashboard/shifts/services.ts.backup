// Shift Management Services - API Integrated
import { APIClient } from '@/lib/api-client';
import type {
  Shift,
  ShiftAssignment,
  ShiftPattern,
  ShiftTemplate,
  ShiftSwapRequest,
  ShiftCoverageRequest,
  ShiftPreference,
  ShiftSchedule,
  ShiftBid,
