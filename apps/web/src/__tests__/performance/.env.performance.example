# Performance Testing Environment Configuration
# Copy this file to .env.performance and configure for your environment

# ============================================================================
# Application URLs
# ============================================================================
BASE_URL=http://localhost:3006
API_URL=http://localhost:3006/api/v1

# ============================================================================
# Test Users
# These users should exist in your test database
# Created by: pnpm prisma db seed
# ============================================================================
ADMIN_EMAIL=admin@e2etest.com
ADMIN_PASSWORD=Test@1234

MANAGER_EMAIL=manager@e2etest.com
MANAGER_PASSWORD=Test@1234

USER_EMAIL=user@e2etest.com
USER_PASSWORD=Test@1234

# ============================================================================
# Database Configuration
# Used for test data setup/teardown
# ============================================================================
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auraos_test

# ============================================================================
# Performance Test Settings
# ============================================================================

# Default virtual users (can be overridden per test)
VUS=10

# Default test duration (can be overridden per test)
DURATION=5m

# Think time between user actions (in seconds)
THINK_TIME_MIN=1
THINK_TIME_MAX=3

# Load test profile to use (smoke, load, stress, spike, soak, breakpoint)
PROFILE=load

# ============================================================================
# Optional Tests
# Set to 'true' to include in run-all-tests.sh
# ============================================================================
STRESS_TEST=false
SPIKE_TEST=false
SOAK_TEST=false

# ============================================================================
# Performance Thresholds
# Override default thresholds (in milliseconds)
# ============================================================================

# Authentication
THRESHOLD_LOGIN_P95=300

# Employee APIs
THRESHOLD_EMPLOYEE_LIST_P95=400
THRESHOLD_EMPLOYEE_GET_P95=300
THRESHOLD_EMPLOYEE_CREATE_P95=500

# Payroll APIs
THRESHOLD_PAYSLIP_LIST_P95=500
THRESHOLD_PAYSLIP_GET_P95=400
THRESHOLD_PAYROLL_PROCESS_P95=5000

# Reports APIs
THRESHOLD_REPORT_LIST_P95=400
THRESHOLD_REPORT_GENERATE_P95=1000

# Dashboard
THRESHOLD_DASHBOARD_P95=600

# Error rate threshold (percentage, 0-100)
THRESHOLD_ERROR_RATE=1

# ============================================================================
# Reporting
# ============================================================================

# Enable detailed logging
VERBOSE=false

# Export results format (json, csv, influxdb)
EXPORT_FORMAT=json

# Results directory
RESULTS_DIR=results

# ============================================================================
# Advanced Settings
# ============================================================================

# Connection pool settings
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30000

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1000

# ============================================================================
# CI/CD Integration
# ============================================================================

# Set to 'true' when running in CI/CD
CI=false

# Fail build on performance regression
FAIL_ON_REGRESSION=false

# Regression tolerance (percentage)
REGRESSION_TOLERANCE=10

# Baseline file for regression comparison
BASELINE_FILE=baselines/baseline-v1.0.0.json

# Current version for tagging results
VERSION=dev
