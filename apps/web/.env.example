# =============================================================================
# AuraOS Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in the required values
# Never commit .env to version control
#

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development # Options: development, test, production

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/auraos?schema=public

# Test Database (Optional - auto-generated from DATABASE_URL if not set)
# Used for running tests in isolation from development data
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/auraos_test?schema=public

# -----------------------------------------------------------------------------
# JWT Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Generate secure secrets using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long

# Token expiration times
JWT_EXPIRES_IN=15m           # Access token: 15 minutes
JWT_REFRESH_EXPIRES_IN=7d    # Refresh token: 7 days

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Email Configuration (Optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@auraos.com

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Error Tracking - Sentry (Optional but Recommended)
# -----------------------------------------------------------------------------
# Server-side Sentry DSN (keep secret - not prefixed with NEXT_PUBLIC_)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Client-side Sentry DSN (public - prefixed with NEXT_PUBLIC_)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Environment name for Sentry (production, staging, development)
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry auth token for uploading source maps (CI/CD only)
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Sentry organization and project
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# Datadog API key for monitoring (alternative to Sentry)
# DATADOG_API_KEY=your-datadog-api-key

# -----------------------------------------------------------------------------
# AWS S3 Storage (Optional)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=auraos-uploads

# -----------------------------------------------------------------------------
# OAuth/SSO Configuration (Optional)
# -----------------------------------------------------------------------------
# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SIGNUP=true           # Allow new user registration
ENABLE_MFA=true              # Enable multi-factor authentication
ENABLE_SSO=false             # Enable SSO authentication

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100           # Max requests per window
RATE_LIMIT_WINDOW=900000     # Window duration in ms (15 minutes)

# -----------------------------------------------------------------------------
# Deployment Information (Auto-populated by Vercel)
# -----------------------------------------------------------------------------
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app
# VERCEL_GIT_COMMIT_SHA=abc123

# =============================================================================
# Notes:
# =============================================================================
#
# 1. Required Variables:
#    - DATABASE_URL
#    - JWT_SECRET
#    - JWT_REFRESH_SECRET
#
# 2. Generate secure secrets:
#    openssl rand -base64 32
#
# 3. Database Setup:
#    pnpm --filter web db:migrate
#    pnpm --filter web db:seed
#
# 4. Environment Validation:
#    The app validates all environment variables on startup
#    Check apps/web/src/lib/config/env.ts for the schema
#
# =============================================================================
