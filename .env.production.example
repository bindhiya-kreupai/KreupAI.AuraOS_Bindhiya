# ============================================================================
# AuraOS — Production Environment Template
# ============================================================================
#
# DO NOT COMMIT a real .env.production with actual values. This file is the
# template; the real values belong in your secrets manager (AWS Secrets
# Manager, HashiCorp Vault, Doppler, 1Password). See issue #26 for the
# secrets-manager wiring plan.
#
# Generate the cryptographic keys (JWT_SECRET, MFA_ENCRYPTION_KEY, etc.)
# with:  openssl rand -base64 32
#
# Required-in-production env vars are validated at startup by
# apps/web/src/lib/config/env.ts — the app refuses to boot if any are
# missing.
# ============================================================================

NODE_ENV="production"
PORT="3006"
NEXT_PUBLIC_APP_URL="https://auraos.example.com"

# ---------------------------------------------------------------------------
# Database (Supabase pooler URL for the app, direct URL for migrations)
# ---------------------------------------------------------------------------
# DATABASE_URL goes through PgBouncer (port 6543 on Supabase)
# DIRECT_URL bypasses PgBouncer (port 5432) — required for Prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication & crypto (ALL REQUIRED in production)
# ---------------------------------------------------------------------------
JWT_SECRET="REPLACE_WITH_openssl_rand_base64_32"
JWT_REFRESH_SECRET="REPLACE_WITH_openssl_rand_base64_32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"

# Encryption-at-rest keys (Phase 1 #28 — app refuses to start without these)
MFA_ENCRYPTION_KEY="REPLACE_WITH_openssl_rand_base64_32"
SSN_ENCRYPTION_KEY="REPLACE_WITH_openssl_rand_base64_32"

# ---------------------------------------------------------------------------
# Redis (required in production — sessions, refresh tokens, audit buffer)
# ---------------------------------------------------------------------------
REDIS_URL="rediss://USER:PASSWORD@HOST:6380"
REDIS_PASSWORD="REPLACE_WITH_REAL_PASSWORD"

# ---------------------------------------------------------------------------
# Observability (Phase 3 #41 + #45)
# ---------------------------------------------------------------------------
SENTRY_DSN="https://PUBLIC_KEY@SENTRY_HOST/PROJECT_ID"
SENTRY_ENVIRONMENT="production"

DATADOG_API_KEY="REPLACE_WITH_REAL_DD_API_KEY"
DD_TRACE_ENABLED="true"
DD_SERVICE="auraos-web"
DD_ENV="production"
DD_VERSION="REPLACE_WITH_GIT_SHA"
DD_AGENT_HOST="datadog-agent.kreupai.svc.cluster.local"
DD_RUNTIME_METRICS_ENABLED="true"
DD_PROFILING_ENABLED="false"
DD_TRACE_SAMPLE_RATE="0.1"
DD_LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# RabbitMQ (jobs, audit pipeline, notifications)
# ---------------------------------------------------------------------------
RABBITMQ_HOST="rabbitmq.kreupai.svc.cluster.local"
RABBITMQ_PORT="5672"
RABBITMQ_USER="auraos"
RABBITMQ_PASSWORD="REPLACE_WITH_REAL_PASSWORD"
RABBITMQ_VHOST="/auraos"

# ---------------------------------------------------------------------------
# Elasticsearch (audit search, employee directory)
# ---------------------------------------------------------------------------
ELASTICSEARCH_NODE="https://elasticsearch.kreupai.svc.cluster.local:9200"
ELASTICSEARCH_USERNAME="auraos"
ELASTICSEARCH_PASSWORD="REPLACE_WITH_REAL_PASSWORD"

# ---------------------------------------------------------------------------
# Microservices (use in-cluster service DNS, not localhost)
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL="http://auth-service.kreupai.svc.cluster.local:3001"
EMPLOYEE_SERVICE_URL="http://employee-service.kreupai.svc.cluster.local:3001"
DOCUMENT_SERVICE_URL="http://document-service.kreupai.svc.cluster.local:3002"
NOTIFICATION_SERVICE_URL="http://notification-service.kreupai.svc.cluster.local:3003"
INTEGRATION_SERVICE_URL="http://integration-service.kreupai.svc.cluster.local:3004"
PAYROLL_SERVICE_URL="http://payroll-service.kreupai.svc.cluster.local:3005"
ANALYTICS_SERVICE_URL="http://analytics-service.kreupai.svc.cluster.local:3007"
AI_SERVICE_URL="http://ai-service.kreupai.svc.cluster.local:3000"
SCHEDULING_SERVICE_URL="http://scheduling-service.kreupai.svc.cluster.local:3009"
WORKFLOW_SERVICE_URL="http://workflow-service.kreupai.svc.cluster.local:3010"

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_SIGNUP="false"
ENABLE_MFA="true"
ENABLE_SSO="false"
ENABLE_AUDIT_LOGGING="true"
ENABLE_EVENTS="true"
ENABLE_QUEUE="true"
ENABLE_SEARCH="true"

# ---------------------------------------------------------------------------
# WPS / MoHRE Integration (Phase 2 #34 — required ONLY for UAE WPS)
# ---------------------------------------------------------------------------
# Set to "true" ONLY after the real MoHRE/bank gateway client is implemented.
# Leaving false makes WpsService.submitToMOHRE() refuse with a clear error.
WPS_MOHRE_INTEGRATION_ENABLED="false"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"          # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# ---------------------------------------------------------------------------
# OAuth / SSO (only required when ENABLE_SSO=true; at least one provider)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID="REPLACE"
# GOOGLE_CLIENT_SECRET="REPLACE"
# AZURE_AD_CLIENT_ID="REPLACE"
# AZURE_AD_CLIENT_SECRET="REPLACE"
# AZURE_AD_TENANT_ID="common"
# OKTA_DOMAIN="REPLACE.okta.com"
# OKTA_CLIENT_ID="REPLACE"
# OKTA_CLIENT_SECRET="REPLACE"

# ---------------------------------------------------------------------------
# SAML (only required when SAML SSO is configured)
# ---------------------------------------------------------------------------
# SAML_ENTRY_POINT="https://idp.example.com/sso"
# SAML_ISSUER="auraos"
# SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nMIIDXjCCAk... etc \n-----END CERTIFICATE-----"
# SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg... etc \n-----END PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# S3 / object storage (uploads, exports, payslip PDFs)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID="REPLACE"
# AWS_SECRET_ACCESS_KEY="REPLACE"
# AWS_REGION="me-central-1"
# AWS_S3_BUCKET="auraos-prod-uploads"

# ---------------------------------------------------------------------------
# SMTP (transactional emails — onboarding, password reset, payroll notifs)
# ---------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="REPLACE"
# SMTP_PASSWORD="REPLACE"
# SMTP_FROM="no-reply@auraos.example.com"

# ---------------------------------------------------------------------------
# Deployment metadata (typically set by CI, not by you)
# ---------------------------------------------------------------------------
# VERCEL_ENV (auto)
# VERCEL_URL (auto)
# VERCEL_GIT_COMMIT_SHA (auto)
