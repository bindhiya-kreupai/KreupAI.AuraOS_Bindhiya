# Env files — NEVER commit anything with real secrets.
# All variants of .env are ignored. Real secrets belong in the secrets
# manager (see docs/SECRETS.md). Only .env.example and .env.production.example
# are committed (they contain placeholders only).
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
# Allow the templates
!.env.example
!.env.production.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

