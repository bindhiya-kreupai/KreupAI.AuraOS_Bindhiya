// ============================================================================
// 24. EOSB (END OF SERVICE BENEFITS) / GRATUITY
// ============================================================================

model EOSBCalculation {
  id              String              @id @default(uuid())
  tenantId        String
  employeeId      String
  calculationDate DateTime            @default(now())
  calculationType EOSBCalculationType

  // Employee Details at Calculation
  countryCode     String
  joiningDate     DateTime
  lastWorkingDate DateTime?
  yearsOfService  Decimal
  monthsOfService Int
  daysOfService   Int

  // Salary Details
  basicSalary Decimal
  totalSalary Decimal
  dailyRate   Decimal

  // Calculation Breakdown
  firstPeriodYears   Decimal @default(0)
  firstPeriodAmount  Decimal @default(0)
  secondPeriodYears  Decimal @default(0)
  secondPeriodAmount Decimal @default(0)
  grossAmount        Decimal

  // Adjustments
  terminationType   TerminationType
  resignationFactor Decimal         @default(1) // 1/3, 2/3, or 1
  deductions        Decimal         @default(0) // Any deductions

  // Final Amount
  netAmount Decimal
  currency  String  @default("AED")

  // Status
  status     EOSBStatus @default(CALCULATED)
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?

  notes              String?
  calculationDetails Json? // Detailed breakdown

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("aura_eosb_calculation")
}

enum EOSBCalculationType {
  ESTIMATE // For planning/preview
  FINAL // Final calculation for settlement
  ADJUSTMENT // Correction to previous calculation
}

enum TerminationType {
  RESIGNATION // Employee-initiated
  TERMINATION // Employer-initiated (with cause)
  TERMINATION_WITHOUT_CAUSE // Employer-initiated (without cause)
  END_OF_CONTRACT // Fixed-term contract expiry
  RETIREMENT // Retirement
  DEATH // Death of employee
  DISABILITY // Permanent disability
  MUTUAL_AGREEMENT // Mutual termination
}

enum EOSBStatus {
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

