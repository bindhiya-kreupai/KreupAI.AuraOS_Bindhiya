  totalEmployerContribution   Decimal @default(0)
  totalPensionContribution    Decimal @default(0)
  totalSanedContribution      Decimal @default(0)
  totalOccupationalHazards    Decimal @default(0)
  grandTotal                  Decimal @default(0)

