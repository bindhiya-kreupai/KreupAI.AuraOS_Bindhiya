model Company {
  id          String       @id(map: "Company_pkey") @default(uuid())
  tenantId    String
  code        String
  name        String
  taxId       String?
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], map: "Company_tenantId_fkey")
  departments Department[]
  employees   Employee[]
  locations   Location[]

  @@unique([tenantId, code], map: "Company_tenantId_code_key")
  @@map("aura_company")
}

model Department {
  id                        String              @id(map: "Department_pkey") @default(uuid())
  companyId                 String
  code                      String
  name                      String
  parentId                  String?
  costCenterId              String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now()) @updatedAt
  createdBy                 String?
  updatedBy                 String?
  deletedAt                 DateTime?
  isDeleted                 Boolean             @default(false)
  company                   Company             @relation(fields: [companyId], references: [id], map: "Department_companyId_fkey")
  costCenter                CostCenter?         @relation(fields: [costCenterId], references: [id], map: "Department_costCenterId_fkey")
  parent                    Department?         @relation("DeptHierarchy", fields: [parentId], references: [id], map: "Department_parentId_fkey")
  children                  Department[]        @relation("DeptHierarchy")
  employees                 Employee[]
  newEmploymentHistory      EmploymentHistory[] @relation("NewDepartment")
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousDepartment")
  Position                  Position[]

  @@unique([companyId, code], map: "Department_companyId_code_key")
  @@map("aura_department")
}

model CostCenter {
  id          String       @id(map: "CostCenter_pkey") @default(uuid())
  code        String       @unique(map: "CostCenter_code_key")
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean      @default(false)
  departments Department[]

  @@map("aura_cost_center")
}

model Country {
  id        String    @id(map: "Country_pkey") @default(uuid())
  isoCode   String    @unique(map: "Country_isoCode_key")
  name      String
  currency  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  addresses Address[]
  states    State[]

  @@map("aura_country")
}

model State {
  id        String    @id(map: "State_pkey") @default(uuid())
  countryId String
  code      String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  addresses Address[]
  cities    City[]
  country   Country   @relation(fields: [countryId], references: [id], map: "State_countryId_fkey")

  @@map("aura_state")
}

model City {
  id        String    @id(map: "City_pkey") @default(uuid())
  stateId   String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  addresses Address[]
  state     State     @relation(fields: [stateId], references: [id], map: "City_stateId_fkey")

  @@map("aura_city")
}

model Address {
  id         String     @id @default(uuid())
  line1      String
  line2      String?
  postalCode String
  cityId     String
  stateId    String
  countryId  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  isDeleted  Boolean    @default(false)
  city       City       @relation(fields: [cityId], references: [id], map: "Address_cityId_fkey")
  country    Country    @relation(fields: [countryId], references: [id], map: "Address_countryId_fkey")
  state      State      @relation(fields: [stateId], references: [id], map: "Address_stateId_fkey")
  employees  Employee[]
  locations  Location[]
  positions  Position[]

  @@map("aura_address")
}

model Location {
  id                        String              @id(map: "Location_pkey") @default(uuid())
  companyId                 String
  code                      String
  name                      String
  type                      LocationType
  addressId                 String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now()) @updatedAt
  createdBy                 String?
  updatedBy                 String?
  deletedAt                 DateTime?
  isDeleted                 Boolean             @default(false)
  assets                    Asset[]
  employees                 Employee[]
  newEmploymentHistory      EmploymentHistory[] @relation("NewLocation")
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousLocation")
  address                   Address             @relation(fields: [addressId], references: [id], map: "Location_addressId_fkey")
  company                   Company             @relation(fields: [companyId], references: [id], map: "Location_companyId_fkey")
  Position                  Position[]

  @@map("aura_location")
}

model JobFunction {
  id          String      @id(map: "JobFunction_pkey") @default(uuid())
  code        String
  name        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean     @default(false)
  jobFamilies JobFamily[]

  @@map("aura_job_function")
}

model JobFamily {
  id          String       @id(map: "JobFamily_pkey") @default(uuid())
  functionId  String
  code        String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean      @default(false)
  function    JobFunction  @relation(fields: [functionId], references: [id], map: "JobFamily_functionId_fkey")
  jobProfiles JobProfile[]

  @@map("aura_job_family")
}

model JobProfile {
  id                        String              @id(map: "JobProfile_pkey") @default(uuid())
  familyId                  String
  code                      String
  title                     String
  description               String?
  gradeId                   String?
  status                    String              @default("Active")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now()) @updatedAt
  createdBy                 String?
  updatedBy                 String?
  deletedAt                 DateTime?
  isDeleted                 Boolean             @default(false)
  employees                 Employee[]
  newEmploymentHistory      EmploymentHistory[] @relation("NewJobProfile")
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousJobProfile")
  family                    JobFamily           @relation(fields: [familyId], references: [id], map: "JobProfile_familyId_fkey")
  Position                  Position[]

  @@map("aura_job_profile")
}

model Grade {
  id                        String              @id(map: "Grade_pkey") @default(uuid())
  code                      String
  name                      String
  level                     Int
  isDeleted                 Boolean             @default(false)
  deletedAt                 DateTime?
  createdBy                 String?
  updatedBy                 String?
  tenantId                  String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now())
  employees                 Employee[]
  newEmploymentHistory      EmploymentHistory[] @relation("NewGrade")
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousGrade")
  Position                  Position[]

  @@map("aura_grade")
}

model Employee {
  id                   String                @id(map: "Employee_pkey") @default(uuid())
  userId               String?               @unique(map: "Employee_userId_key")
  employeeCode         String                @unique(map: "Employee_employeeCode_key")
  firstName            String
  lastName             String
  email                String                @unique(map: "Employee_email_key")
  companyId            String
  departmentId         String
  locationId           String
  jobProfileId         String
  gradeId              String
  managerId            String?
  statusId             String
  typeId               String
  joiningDate          DateTime
  addressId            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  positionId           String?
  salaryStructureId    String?
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  isDeleted            Boolean               @default(false)
  confirmationRequests ConfirmationRequest[] @relation("EmployeeConfirmation")
  emergencyContacts    EmergencyContact[]
  address              Address?              @relation(fields: [addressId], references: [id], map: "Employee_addressId_fkey")
  company              Company               @relation(fields: [companyId], references: [id], map: "Employee_companyId_fkey")
  department           Department            @relation(fields: [departmentId], references: [id], map: "Employee_departmentId_fkey")
  grade                Grade                 @relation(fields: [gradeId], references: [id], map: "Employee_gradeId_fkey")
  jobProfile           JobProfile            @relation(fields: [jobProfileId], references: [id], map: "Employee_jobProfileId_fkey")
  location             Location              @relation(fields: [locationId], references: [id], map: "Employee_locationId_fkey")
  manager              Employee?             @relation("ManagerReports", fields: [managerId], references: [id], map: "Employee_managerId_fkey")
  reports              Employee[]            @relation("ManagerReports")
  position             Position?             @relation("CurrentPosition", fields: [positionId], references: [id], map: "Employee_positionId_fkey")
  status               EmployeeStatus        @relation(fields: [statusId], references: [id], map: "Employee_statusId_fkey")
  type                 EmploymentType        @relation(fields: [typeId], references: [id], map: "Employee_typeId_fkey")
  user                 User?                 @relation(fields: [userId], references: [id], map: "Employee_userId_fkey")
  employeeLifeEvents   EmployeeLifeEvent[]   @relation("EmployeeLifeEvents")
  employmentHistory    EmploymentHistory[]   @relation("EmployeeHistory")
  exitRequests         ExitRequest[]         @relation("EmployeeExits")
  garnishments         Garnishment[]
  hsaFsaAccounts       HSAFSAAccount[]
  idcards              IDCard[]              @relation("EmployeeIDCards")
  letters              Letter[]              @relation("EmployeeLetters")
  probationTrackings   ProbationTracking[]   @relation("EmployeeProbation")
  taxDocuments         TaxDocument[]
  wpsRecords           WPSRecord[]

  @@map("aura_employee")
}

model EmployeeStatus {
  id          String     @id(map: "EmployeeStatus_pkey") @default(uuid())
  code        String     @unique(map: "EmployeeStatus_code_key")
  name        String
  description String?
  status      String     @default("Active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean    @default(false)
  employees   Employee[]
  positions   Position[]

  @@map("aura_employee_status")
}

model EmploymentType {
  id          String     @id(map: "EmploymentType_pkey") @default(uuid())
  code        String     @unique(map: "EmploymentType_code_key")
  name        String
  description String?
  status      String     @default("Active")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean    @default(false)
  employees   Employee[]
  positions   Position[]

  @@map("aura_employment_type")
}

model EmployeeNumberSequence {
  id         String    @id @default(uuid())
  tenantId   String
  companyId  String
  prefix     String
  nextNumber Int       @default(1)
  padding    Int       @default(5)
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  isDeleted  Boolean   @default(false)

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@map("aura_employee_number_sequence")
}

model EmployeeMasterDataDraft {
  id                   String    @id @default(uuid())
  tenantId             String
  onboardingInstanceId String?
  offerId              String?
  employeeId           String?
  status               String    @default("DRAFT")
  masterData           Json
  validationSnapshot   Json
  duplicateSnapshot    Json?
  submittedBy          String?
  submittedAt          DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  activatedBy          String?
  activatedAt          DateTime?
  rejectionReason      String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?

  @@index([tenantId])
  @@index([onboardingInstanceId])
  @@index([offerId])
  @@index([employeeId])
  @@index([status])
  @@map("aura_employee_master_data_draft")
}

model EmployeeIdentification {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  countryCode     String
  identifierType  String
  identifierValue String
  issueDate       DateTime?
  expiryDate      DateTime?
  isPrimary       Boolean   @default(false)
  sourceDraftId   String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  @@unique([tenantId, identifierType, identifierValue], map: "aura_employee_identification_tenantId_identifierType_identifier")
  @@index([tenantId])
  @@index([employeeId])
  @@index([countryCode])
  @@index([identifierType])
  @@map("aura_employee_identification")
}

model EmployeeLifecycleEvent {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  eventType    String
  payload      Json
  status       String    @default("PENDING")
  publishedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)

  @@index([tenantId])
  @@index([employeeId])
  @@index([eventType])
  @@index([status])
  @@map("aura_employee_lifecycle_event")
}

model User {
  id                  String               @id(map: "User_pkey") @default(uuid())
  email               String               @unique(map: "User_email_key")
  password            String
  tenantId            String
  status              String               @default("Active")
  mfaEnabled          Boolean              @default(false)
  lastLogin           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  firstName           String?
  lastName            String?
  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  auditLogs           AuditLog[]
  employee            Employee?
  mfaSecret           MFASecret?
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], map: "User_tenantId_fkey")
  deactivations       UserDeactivation[]
  delegatedFrom       UserDelegation[]     @relation("Delegatee")
  delegatedTo         UserDelegation[]     @relation("Delegator")
  roles               UserRole[]
  sessions            UserSession[]

  @@map("aura_user")
}

model Role {
  id          String           @id(map: "Role_pkey") @default(uuid())
  name        String
  description String?
  tenantId    String?
  code        String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], map: "Role_tenantId_fkey")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code], map: "Role_tenantId_code_key")
  @@index([code], map: "Role_code_idx")
  @@index([isActive], map: "Role_isActive_idx")
  @@index([tenantId], map: "Role_tenantId_idx")
  @@map("aura_role")
}

model UserRole {
  id         String    @id(map: "UserRole_pkey") @default(uuid())
  userId     String
  roleId     String
  tenantId   String
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  isDeleted  Boolean   @default(false)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "UserRole_roleId_fkey")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], map: "UserRole_tenantId_fkey")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserRole_userId_fkey")

  @@unique([userId, roleId], map: "UserRole_userId_roleId_key")
  @@index([expiresAt], map: "UserRole_expiresAt_idx")
  @@index([roleId], map: "UserRole_roleId_idx")
  @@index([tenantId], map: "UserRole_tenantId_idx")
  @@index([userId], map: "UserRole_userId_idx")
  @@map("aura_user_role")
}

model Permission {
  id          String           @id(map: "Permission_pkey") @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  updatedAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action], map: "Permission_resource_action_key")
  @@index([resource], map: "Permission_resource_idx")
  @@map("aura_permission")
}

model RolePermission {
  id           String     @id(map: "RolePermission_pkey") @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  isDeleted    Boolean    @default(false)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "RolePermission_permissionId_fkey")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "RolePermission_roleId_fkey")

  @@unique([roleId, permissionId], map: "RolePermission_roleId_permissionId_key")
  @@index([permissionId], map: "RolePermission_permissionId_idx")
  @@index([roleId], map: "RolePermission_roleId_idx")
  @@map("aura_role_permission")
}

model PasswordResetToken {
  id        String    @id(map: "PasswordResetToken_pkey") @default(uuid())
  userId    String
  token     String    @unique(map: "PasswordResetToken_token_key")
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  ipAddress String?
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordResetToken_userId_fkey")

  @@index([expiresAt], map: "PasswordResetToken_expiresAt_idx")
  @@index([userId], map: "PasswordResetToken_userId_idx")
  @@map("aura_password_reset_token")
}

model MFASecret {
  id          String    @id(map: "MFASecret_pkey") @default(uuid())
  userId      String    @unique(map: "MFASecret_userId_key")
  secret      String?
  backupCodes Json?
  phoneNumber String?
  method      String    @default("totp")
  isEnabled   Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "MFASecret_userId_fkey")

  @@index([userId], map: "MFASecret_userId_idx")
  @@map("aura_mfa_secret")
}

model RefreshToken {
  id        String    @id(map: "RefreshToken_pkey") @default(uuid())
  token     String    @unique(map: "RefreshToken_token_key")
  userId    String
  expiresAt DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_userId_fkey")

  @@index([token], map: "RefreshToken_token_idx")
  @@index([userId], map: "RefreshToken_userId_idx")
  @@map("aura_refresh_token")
}

model Currency {
  id        String    @id(map: "Currency_pkey") @default(uuid())
  code      String    @unique(map: "Currency_code_key")
  name      String
  symbol    String
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("aura_currency")
}

model Language {
  id        String    @id(map: "Language_pkey") @default(uuid())
  code      String    @unique(map: "Language_code_key")
  name      String
  isRTL     Boolean   @default(false)
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("aura_language")
}

model DocumentType {
