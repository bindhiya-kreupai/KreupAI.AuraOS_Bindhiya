// ============================================================================
// 24. GENERIC TENANT SETTINGS (per-module key/value store)
// ============================================================================
//
// Single source of truth for per-tenant per-module configuration. Each module
// page (`/api/<module>/settings`) reads and writes here instead of returning
// hardcoded defaults. The handler merges DB rows over its module default map
// so adding a new field is a code-only change and existing tenants see the
// new default without a migration.

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  module    String   // 'coreHr' | 'finance' | 'helpdesk' | 'health-safety' | …
  key       String
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
  @@map("aura_tenant_setting")
}

