  jurisdiction    String?
  transferMechanism String? // SCC_2021_914 | BCR | ADEQUACY | NONE
  reviewedAt      DateTime?
  reviewedById    String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)

  @@index([tenantId])
  @@index([status])
  @@index([effectiveTo])
  @@map("aura_data_processing_agreement")
}

// ============================================================================
// v2.0 — DEVOPS / SLO-SLI (#100)
// ============================================================================

// SLO definition. Per-service / per-route latency or error-rate target.
// Burn-down rates and alert routing live in the observability platform;
// this row is the source of truth for the target.
model ServiceLevelObjective {
  id              String   @id @default(uuid())
  tenantId        String?  // null = platform-wide SLO
  serviceName     String   // payroll-engine | leave-engine | attendance-api | ...
  indicatorType   String   // LATENCY_P95 | LATENCY_P99 | ERROR_RATE | AVAILABILITY | THROUGHPUT
  routePattern    String?  // optional: GET /api/v1/employees/:id
  targetValue     Float    // 99.95 for availability; 250 for p95 ms latency
  unit            String   // PCT | MS | RPS | COUNT
  errorBudgetWindow String   @default("30d") // 7d | 30d | 90d
  ownerTeam       String
  runbookUrl      String?
  alertChannel    String?
  description     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)

  @@index([tenantId])
  @@index([serviceName])
  @@index([indicatorType])
  @@map("aura_service_level_objective")
}

// Incident record. Captures every SEV-1/2 paging event for postmortem.
// Closes the loop between an SLO burn and the postmortem doc.
model Incident {
  id              String   @id @default(uuid())
  tenantId        String?
  incidentNumber  String   // INC-2026-001
  title           String
  severity        String   // SEV1 | SEV2 | SEV3 | SEV4
  status          String   @default("OPEN") // OPEN | INVESTIGATING | MITIGATED | RESOLVED | POSTMORTEM_PUBLISHED
  detectedAt      DateTime
  acknowledgedAt  DateTime?
  mitigatedAt     DateTime?
  resolvedAt      DateTime?
  postmortemUrl   String?
  commanderUserId String?
  rootCause       String?  @db.Text
  affectedServices String[] @default([])
  customerImpact  String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@unique([tenantId, incidentNumber])
  @@index([tenantId])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("aura_incident")
}

// ============================================================================
// v4.0 — AI GOVERNANCE & MLOps (#115) — EU AI Act 2024/1689 deadline Aug 2026
// ============================================================================

// Model card — required by EU AI Act for every "high-risk" HR AI system
// (hiring, promotion, comp, performance prediction, attrition risk).
// Stored versioned: each retrain creates a new ModelCard row.
model AIModelCard {
  id              String   @id @default(uuid())
  tenantId        String?  // null = platform-wide model
  modelName       String   // attrition-risk-v3 | resume-parser | promotion-recommender | ...
  modelVersion    String   // semver
  modelType       String   // CLASSIFIER | REGRESSOR | LLM | EMBEDDING | RANKER
  riskTier        String   @default("HIGH") // UNACCEPTABLE | HIGH | LIMITED | MINIMAL (per EU AI Act Annex III)
  intendedUse     String   @db.Text
  prohibitedUse   String?  @db.Text
  trainingData    Json     @default("{}") // data sources, date range, license
  performanceMetrics Json  @default("{}") // {accuracy, f1, auc, ...}
  fairnessMetrics Json     @default("{}") // {demographic_parity, equal_opp, ...}
  knownLimitations String? @db.Text
  validatorUserId String?
  validatedAt     DateTime?
  publishedAt     DateTime?
  deprecatedAt    DateTime?
  status          String   @default("DRAFT") // DRAFT | UNDER_REVIEW | PUBLISHED | DEPRECATED | RECALLED
  cardUrl         String?  // signed link to the full PDF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)

  biasAudits      AIBiasAudit[]

  @@unique([tenantId, modelName, modelVersion])
  @@index([tenantId])
  @@index([modelName])
  @@index([riskTier])
  @@index([status])
  @@map("aura_ai_model_card")
}

// Bias audit run — required for "high-risk" HR systems before deployment
// AND on a recurring schedule per EU AI Act § 14 (human oversight) +
// § 15 (accuracy, robustness, cybersecurity).
model AIBiasAudit {
  id              String   @id @default(uuid())
  tenantId        String?
  modelCardId     String
  modelCard       AIModelCard @relation(fields: [modelCardId], references: [id])
  auditDate       DateTime
  auditor         String   // user, vendor, or internal team
  cohorts         Json     @default("[]") // [{name: "gender:F", n: 1024, positiveRate: 0.32}, ...]
  metric          String   // DEMOGRAPHIC_PARITY | EQUAL_OPPORTUNITY | DISPARATE_IMPACT_RATIO | CALIBRATION
  passed          Boolean
  worstCohortGap  Float?   // largest absolute disparity between cohorts
  threshold       Float?   // configured fail threshold (e.g., 0.8 for 4/5ths rule)
  findings        String?  @db.Text
  remediationPlan String?  @db.Text
  reportUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  @@index([modelCardId])
  @@index([tenantId])
  @@index([passed])
  @@index([auditDate])
  @@map("aura_ai_bias_audit")
}

// ============================================================================
// v4.0 — SECOPS WAF/SIEM (#113) — stub models for SecOps event ingestion
