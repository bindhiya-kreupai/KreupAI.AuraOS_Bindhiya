// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. ORGANIZATION STRUCTURE (Multi-Entity, Multi-Tenant Support)
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., "ACME_CORP"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  userRoles UserRole[]

  // WPS Relations
  wpsConfigurations WPSConfiguration[]
  wpsSubmissions    WPSSubmission[]
  wpsRecords        WPSRecord[]
  wpsAuditLogs      WPSAuditLog[]
}

model Company {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String // e.g., "US_HQ"
  name     String
  taxId    String? // EIN, VAT, etc.

  locations   Location[]
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String
  name      String
  parentId  String? // For hierarchy (e.g., Engineering -> Backend)
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  employees                 Employee[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousDepartment")
  newEmploymentHistory      EmploymentHistory[] @relation("NewDepartment")
  Position                  Position[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

model CostCenter {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  departments Department[]
}

// ============================================================================
// 2. LOCATION MASTER
// ============================================================================

model Country {
  id       String @id @default(uuid())
  isoCode  String @unique // US, IN, UK
  name     String
  currency String // USD, INR

  states    State[]
  addresses Address[]
}

model State {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  code      String // CA, NY
  name      String

  cities    City[]
  addresses Address[]

  @@index([countryId])
}

model City {
  id      String @id @default(uuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  name    String

  addresses Address[]

  @@index([stateId])
}

model Address {
  id         String  @id @default(uuid())
  line1      String
  line2      String?
  postalCode String
  cityId     String
  city       City    @relation(fields: [cityId], references: [id])
  stateId    String
  state      State   @relation(fields: [stateId], references: [id])
  countryId  String
  country    Country @relation(fields: [countryId], references: [id])

  locations Location[]
  employees Employee[] // Home address
  positions Position[]
}

model Location {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String // e.g., "NYC_OFFICE"
  name      String
  type      LocationType // HEADQUARTERS, BRANCH, REMOTE_HUB
  addressId String
  address   Address      @relation(fields: [addressId], references: [id])

  employees                 Employee[]
  assets                    Asset[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousLocation")
  newEmploymentHistory      EmploymentHistory[] @relation("NewLocation")
  Position                  Position[]

  @@index([companyId])
  @@index([type])
}

enum LocationType {
  HEADQUARTERS
  BRANCH
  REMOTE_HUB
  WAREHOUSE
  PLANT
}

// ============================================================================
// 3. JOB ARCHITECTURE
// ============================================================================

model JobFunction {
  id   String @id @default(uuid())
  code String // e.g., "ENG"
  name String // e.g., "Engineering"

  jobFamilies JobFamily[]
}

model JobFamily {
  id         String      @id @default(uuid())
  functionId String
  function   JobFunction @relation(fields: [functionId], references: [id])
  code       String // e.g., "SW_DEV"
  name       String // e.g., "Software Development"

  jobProfiles JobProfile[]
}

model JobProfile {
  id          String    @id @default(uuid())
  familyId    String
  family      JobFamily @relation(fields: [familyId], references: [id])
  gradeId     String?
  grade       Grade?    @relation(fields: [gradeId], references: [id])
  code        String // e.g., "SENIOR_FE"
  title       String // e.g., "Senior Frontend Engineer"
  description String?
  status      String    @default("Active")

  employees                 Employee[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousJobProfile")
  newEmploymentHistory      EmploymentHistory[] @relation("NewJobProfile")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Position  Position[]

  @@index([familyId])
  @@index([gradeId])
  @@index([status])
}

model Grade {
  id    String @id @default(uuid())
  code  String // e.g., "L4"
  name  String // e.g., "Level 4"
  level Int // Numeric level for hierarchy comparison

  employees                 Employee[]
  profiles                  JobProfile[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousGrade")
  newEmploymentHistory      EmploymentHistory[] @relation("NewGrade")
  Position                  Position[]
}

// ============================================================================
// 4. EMPLOYEE MASTER (The Core)
// ============================================================================

model Employee {
  id     String  @id @default(uuid())
  userId String? @unique // Link to auth user
  user   User?   @relation(fields: [userId], references: [id])

  // Identity
  employeeCode String @unique
  firstName    String
  lastName     String
  email        String @unique

  // Organization Links (Normalized)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])

  // Job Links (Normalized)
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id])
  gradeId      String
  grade        Grade      @relation(fields: [gradeId], references: [id])

  // Manager (Self-Relation)
  managerId String?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id])
  reports   Employee[] @relation("ManagerReports")

  // Position
  positionId String?
  position   Position? @relation("CurrentPosition", fields: [positionId], references: [id])

  // Status
  // Status
  statusId    String
  status      EmployeeStatus @relation(fields: [statusId], references: [id])
  typeId      String
  type        EmploymentType @relation(fields: [typeId], references: [id])
  joiningDate DateTime

  // Personal
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // Relations to other modules
  employeeLifeEvents   EmployeeLifeEvent[]   @relation("EmployeeLifeEvents")
  idcards              IDCard[]              @relation("EmployeeIDCards")
  letters              Letter[]              @relation("EmployeeLetters")
  exitRequests         ExitRequest[]         @relation("EmployeeExits")
  probationTrackings   ProbationTracking[]   @relation("EmployeeProbation")
  confirmationRequests ConfirmationRequest[] @relation("EmployeeConfirmation")

  // WPS Relations
  wpsRecords           WPSRecord[]

  // Additional Relations
  emergencyContacts    EmergencyContact[]
  garnishments         Garnishment[]
  hsaFsaAccounts       HSAFSAAccount[]
  taxDocuments         TaxDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([locationId])
  @@index([statusId])
  @@index([managerId])
  @@index([jobProfileId])
  @@index([gradeId])
  @@index([companyId, statusId])
  @@index([joiningDate])
}

model EmployeeStatus {
  id          String  @id @default(uuid())
  code        String  @unique // ACTIVE, PROBATION
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
  positions Position[]
}

model EmploymentType {
  id          String  @id @default(uuid())
  code        String  @unique // FULL_TIME, PART_TIME
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
  positions Position[]
}

// ============================================================================
// 5. SYSTEM / AUTH
// ============================================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hashed
  firstName String?
  lastName  String?
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employee Employee?

  // User Management Fields
  status     String    @default("Active") // Active, Inactive, Suspended
  mfaEnabled Boolean   @default(false)
  lastLogin  DateTime?

  // Relations
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  delegatedTo         UserDelegation[]     @relation("Delegator")
  delegatedFrom       UserDelegation[]     @relation("Delegatee")
  deactivations       UserDeactivation[]
  passwordResetTokens PasswordResetToken[]
  mfaSecret           MFASecret?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Role assignments
  roles UserRole[]

  @@index([tenantId])
  @@index([email, tenantId])
  @@index([status])
  @@index([tenantId, status])
}

// ============================================================================
// 5B. ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  tenantId    String? // null for system-wide roles
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  code        String // SUPER_ADMIN, ADMIN, HR_MANAGER, etc.
  name        String
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  tenantId   String
  assignedBy String? // User ID who assigned this role
  assignedAt DateTime  @default(now())
  expiresAt  DateTime? // Optional: For temporary role assignments

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Permission {
  id          String   @id @default(uuid())
  resource    String // users, employees, departments, etc.
  action      String // create, read, update, delete, manage
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// 5C. Password Reset
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed token for security
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  ipAddress String? // Track where reset was requested from

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// 5D. Multi-Factor Authentication (MFA)
model MFASecret {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String?   // Encrypted TOTP secret for authenticator apps
  backupCodes Json?     // Array of hashed backup codes
  phoneNumber String?   // For SMS-based MFA (future)
  method      String    @default("totp") // totp, sms, email
  isEnabled   Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([token])
}

// ============================================================================
// 6. MASTER DATA (General & System)
// ============================================================================

model Currency {
  id     String @id @default(uuid())
  code   String @unique // USD, EUR
  name   String
  symbol String
  status String @default("Active") // Active, Inactive
}

model Language {
  id     String  @id @default(uuid())
  code   String  @unique // en, es
  name   String
  isRTL  Boolean @default(false)
  status String  @default("Active")
}

model DocumentType {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  description String?
  isRequired  Boolean            @default(false)
  status      String             @default("Active")
  documents   EmployeeDocument[]
}

// ============================================================================
// 7. ORGANIZATION MASTERS
// ============================================================================

model BusinessUnit {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  head   String?
  status String  @default("Active")
}

model Designation {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  gradeId     String?
  description String?
  status      String  @default("Active")
}

// ============================================================================
// 8. EMPLOYMENT MASTERS
// ============================================================================

model Skill {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  category    String?
  description String?
  status      String  @default("Active")
}

model Competency {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  status      String  @default("Active")
}

// ============================================================================
// 9. TIME & LEAVE MASTERS
// ============================================================================

model LeaveType {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  isPaid Boolean @default(true)
  status String  @default("Active")
}

model ShiftType {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  startTime String
  endTime   String
  status    String @default("Active")
}

model Holiday {
  id     String @id @default(uuid())
  name   String
  date   String // YYYY-MM-DD
  type   String // National, Regional
  status String @default("Active")
}

// ============================================================================
// 9.5 ATTENDANCE & WORKFORCE MANAGEMENT
// ============================================================================

// Time Tracking - Clock In/Out Records
model AttendancePunch {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  punchDate  DateTime
  punchTime  DateTime
  punchType  String // CLOCK_IN, CLOCK_OUT, BREAK_START, BREAK_END
  location   String? // GPS coordinates or location name
  device     String? // Mobile, Web, Biometric
  ipAddress  String?
  photo      String? // Photo capture URL
  notes      String?

  // Verification
  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  // Regularization
  isRegularized        Boolean @default(false)
  regularizedBy        String?
  regularizationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([punchDate])
  @@index([punchType])
}

// Daily Attendance Summary
model AttendanceRecord {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  date       DateTime

  // Shift Info
  shiftId        String?
  shiftStartTime DateTime?
  shiftEndTime   DateTime?

  // Actual Times
  clockIn  DateTime?
  clockOut DateTime?

  // Calculated Hours
  workHours     Float @default(0)
  breakHours    Float @default(0)
  overtimeHours Float @default(0)

  // Status
  status     String // PRESENT, ABSENT, HALF_DAY, LATE, EARLY_OUT, ON_LEAVE, HOLIDAY, WEEK_OFF
  isLate     Boolean @default(false)
  isEarlyOut Boolean @default(false)

  // Regularization
  isRegularized    Boolean @default(false)
  regularizationId String?

  // Approval
  approvalStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     String?
  approvedAt     DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// Shift Definitions
model Shift {
  id          String  @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?

  // Timing
  startTime       String // HH:MM format
  endTime         String // HH:MM format
  graceInMinutes  Int    @default(0)
  graceOutMinutes Int    @default(0)

  // Break Configuration
  breakDuration Int     @default(0) // Minutes
  isPaidBreak   Boolean @default(true)

  // Work Hours
  workHours   Float // Standard work hours
  weekendDays String[] // e.g., ["Saturday", "Sunday"]

  // Overtime
  overtimeAllowed  Boolean @default(false)
  maxOvertimeHours Float   @default(0)

  // Flexibility
  isFlexible Boolean @default(false)
  flexWindow Int     @default(0) // Minutes of flex allowed

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignments ShiftAssignment[]
  rosters     ShiftRoster[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
}

// Employee Shift Assignments
model ShiftAssignment {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String
  shiftId    String
  shift      Shift  @relation(fields: [shiftId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive   Boolean @default(true)
  assignedBy String?
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([effectiveFrom])
}

// Shift Roster (Weekly/Monthly Planning)
model ShiftRoster {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String
  shiftId    String
  shift      Shift  @relation(fields: [shiftId], references: [id])

  rosterDate DateTime

  // Override shift times if needed
  customStartTime String?
  customEndTime   String?

  isWeekOff Boolean @default(false)
  isHoliday Boolean @default(false)

  status String @default("SCHEDULED") // SCHEDULED, COMPLETED, SWAPPED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId, rosterDate])
  @@index([tenantId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([rosterDate])
}

// Shift Swap Requests
model ShiftSwapRequest {
  id          String @id @default(uuid())
  tenantId    String
  requestorId String // Employee requesting swap
  swapWithId  String // Employee to swap with

  requestorDate    DateTime
  requestorShiftId String

  swapWithDate    DateTime
  swapWithShiftId String

  reason String

  // Approval Workflow
  status           String    @default("PENDING") // PENDING, APPROVED_BY_PEER, APPROVED_BY_MANAGER, REJECTED, COMPLETED
  swapWithApproval String    @default("PENDING") // PENDING, APPROVED, REJECTED
  managerApproval  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([requestorId])
  @@index([swapWithId])
  @@index([status])
}

// Overtime Management
model OvertimeRequest {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  overtimeDate DateTime
  startTime    DateTime
  endTime      DateTime

  totalHours Float

  // Type
  overtimeType String // REGULAR, HOLIDAY, WEEKEND

  // Justification
  reason          String
  workDescription String?
  project         String?

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  // Compensation
  compensationType String? // PAID, COMP_OFF
  isCompensated    Boolean   @default(false)
  compensatedAt    DateTime?

  // Actual
  actualHours Float?
  verifiedBy  String?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([overtimeDate])
  @@index([status])
}

// Attendance Regularization Requests
model AttendanceRegularization {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  date DateTime

  // What needs regularization
  regularizationType String // MISSED_PUNCH, EARLY_OUT, LATE_IN, WRONG_PUNCH

  // Requested Times
  requestedClockIn  DateTime?
  requestedClockOut DateTime?

  // Justification
  reason      String
  attachments String[] @default([])

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// Comp-Off (Compensatory Off) Management
model CompOffRequest {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  // Earned from overtime/holiday work
  earnedDate  DateTime
  earnedHours Float

  // Usage
  status String @default("EARNED") // EARNED, APPLIED, APPROVED, AVAILED, EXPIRED, CANCELLED

  // When applying comp-off as leave
  appliedDate DateTime?
  expiryDate  DateTime

  // Approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([expiryDate])
}

// ============================================================================
// 10. PAYROLL & FINANCE MASTERS
// ============================================================================

model TaxRegime {
  id      String @id @default(uuid())
  code    String @unique
  name    String
  country String
  status  String @default("Active")
}

model PayComponent {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  type   String // Earning, Deduction
  status String @default("Active")
}

model Bank {
  id          String  @id @default(uuid())
  name        String
  swiftCode   String
  branchName  String?
  countryCode String? // ISO codde e.g. AE, IN (Optional for migration safety, backfill later)
  status      String  @default("Active")
}

// ============================================================================
// 11. SYSTEM MASTERS
// ============================================================================

// Note: Role model moved to section 5B (RBAC) for better organization

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  group       String
  description String?
}

// ============================================================================
// 12. EXTENDED MASTERS
// ============================================================================

model EducationLevel {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  status      String  @default("Active")
}

model Relationship {
  id     String @id @default(uuid())
  name   String @unique
  type   String // Immediate, Extended
  status String @default("Active")
}

model ExitReason {
  id     String @id @default(uuid())
  reason String @unique
  type   String // Voluntary, Involuntary
  status String @default("Active")
}

// ============================================================================
// 13. USER MANAGEMENT SUITE
// ============================================================================

model AccessControl {
  id        String   @id @default(uuid())
  name      String
  type      String // IP_RANGE, TIME_WINDOW
  value     String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordPolicy {
  id                  String   @id @default(uuid())
  minLength           Int      @default(8)
  requireUppercase    Boolean  @default(true)
  requireLowercase    Boolean  @default(true)
  requireNumbers      Boolean  @default(true)
  requireSpecialChars Boolean  @default(true)
  expiryDays          Int      @default(90)
  historyCount        Int      @default(5)
  lockoutAttempts     Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SSOConfig {
  id          String   @id @default(uuid())
  enabled     Boolean  @default(false)
  provider    String // SAML, OIDC
  issuerUrl   String?
  ssoUrl      String?
  certificate String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ipAddress  String
  device     String?
  browser    String?
  location   String?
  lastActive DateTime @default(now())
  status     String   @default("Active") // Active, Idle, Revoked
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([lastActive])
}
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // LOGIN, CREATE, UPDATE, DELETE
  entityType String
  entityId   String?
  metadata   Json?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@index([action])
  @@index([entityType])
  @@index([userId, timestamp])
}

model UserDelegation {
  id          String   @id @default(uuid())
  delegatorId String
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegateeId String
  delegatee   User     @relation("Delegatee", fields: [delegateeId], references: [id])
  role        String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("Scheduled") // Active, Scheduled, Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegatorId])
  @@index([delegateeId])
  @@index([status])
  @@index([startDate, endDate])
}

model License {
  id        String   @id @default(uuid())
  name      String   @unique // Core HR, Payroll
  total     Int
  used      Int      @default(0)
  type      String // Per User, Per Recruiter
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDeactivation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  reason        String?
  deactivatedBy String
  deactivatedAt DateTime @default(now())
}

model MFAConfig {
  id               String   @id @default(uuid())
  enabled          Boolean  @default(false)
  enforceForAdmins Boolean  @default(true)
  enforceForAll    Boolean  @default(false)
  methods          Json // { authenticatorApp: true, sms: false, ... }
  gracePeriodDays  Int      @default(7)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// 14. RECRUITMENT MODULE
// ============================================================================

model JobPosting {
  id          String    @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  status      String    @default("Draft")
  description String?
  postedDate  DateTime?

  // Metrics
  views   Int @default(0)
  clicks  Int @default(0)
  applies Int @default(0)

  // Channels (Stored as JSON)
  channels Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateApplications CandidateApplication[]

  @@index([status])
  @@index([department])
  @@index([location])
  @@index([postedDate])
}

// ============================================================================
// 15. COMPETENCY LIBRARY MODULE
// ============================================================================

model CompetencyCategory {
  id          String   @id @default(uuid())
  code        String   @unique // TECHNICAL, LEADERSHIP, BEHAVIORAL, FUNCTIONAL, CORE
  name        String
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competencies  CompetencyCatalog[]
  subcategories CompetencySubcategory[]
}

model CompetencySubcategory {
  id         String             @id @default(uuid())
  categoryId String
  category   CompetencyCategory @relation(fields: [categoryId], references: [id])
  code       String
  name       String
  status     String             @default("Active")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  competencies CompetencyCatalog[]

  @@unique([categoryId, code])
}

model CompetencyCatalog {
  id            String                 @id @default(uuid())
  code          String                 @unique
  name          String
  categoryId    String
  category      CompetencyCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   CompetencySubcategory? @relation(fields: [subcategoryId], references: [id])
  description   String?                @db.Text
  status        String                 @default("Active") // Active, Draft, Archived, Under Review
  version       String                 @default("1.0")
  owner         String?
  usageCount    Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  // Relations
  proficiencyDescriptors CompetencyProficiencyDescriptor[]
  applicableRoles        CompetencyRoleMapping[]
  relatedCompetencies    CompetencyRelation[]              @relation("SourceCompetency")
  relatedTo              CompetencyRelation[]              @relation("RelatedCompetency")
  assessmentCriteria     CompetencyAssessmentCriteria[]
  developmentResources   CompetencyDevelopmentResource[]
  jobCompetencyMappings  JobCompetencyMapping[]
  skillAssessments       SkillAssessmentCompetency[]
  gapAnalysisItems       GapAnalysisItem[]
}

model CompetencyProficiencyDescriptor {
  id           String            @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  levelId      String
  level        ProficiencyLevel  @relation(fields: [levelId], references: [id])
  description  String?           @db.Text
  behaviors    Json? // Array of behavior strings
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([competencyId, levelId])
}

model CompetencyRelation {
  id                  String            @id @default(uuid())
  sourceCompetencyId  String
  sourceCompetency    CompetencyCatalog @relation("SourceCompetency", fields: [sourceCompetencyId], references: [id], onDelete: Cascade)
  relatedCompetencyId String
  relatedCompetency   CompetencyCatalog @relation("RelatedCompetency", fields: [relatedCompetencyId], references: [id], onDelete: Cascade)
  relationType        String            @default("Related") // Related, Prerequisite, Complementary
  createdAt           DateTime          @default(now())

  @@unique([sourceCompetencyId, relatedCompetencyId])
}

model CompetencyRoleMapping {
  id           String            @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  roleName     String // Job role name
  createdAt    DateTime          @default(now())

  @@unique([competencyId, roleName])
}

model CompetencyAssessmentCriteria {
  id           String            @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  criteria     String
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
}

model CompetencyDevelopmentResource {
  id           String            @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  title        String
  type         String // Course, Book, Workshop, Certification, On-the-job
  url          String?
  provider     String?
  duration     String?
  cost         Float?
  createdAt    DateTime          @default(now())
}

// ============================================================================
// 16. PROFICIENCY LEVELS / FRAMEWORKS
// ============================================================================

model ProficiencyFramework {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  type        String   @default("Standard") // Standard, Custom, Industry
  isDefault   Boolean  @default(false)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels ProficiencyLevel[]
}

model ProficiencyLevel {
  id          String               @id @default(uuid())
  frameworkId String
  framework   ProficiencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code        String
  name        String // Foundational, Developing, Proficient, Advanced, Expert
  levelNumber Int // 1, 2, 3, 4, 5
  description String?              @db.Text
  color       String? // For UI display
  icon        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  competencyDescriptors CompetencyProficiencyDescriptor[]
  jobCompetencyMappings JobCompetencyMapping[]
  assessmentResults     SkillAssessmentResult[]
  gapAnalysisItems      GapAnalysisItem[]
  gapAnalysisTargets    GapAnalysisItem[]                 @relation("TargetLevel")

  @@unique([frameworkId, levelNumber])
  @@unique([frameworkId, code])
}

// ============================================================================
// 17. JOB COMPETENCY MAPPING
// ============================================================================

model JobRole {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  departmentId String?
  description  String?  @db.Text
  level        String? // Entry, Mid, Senior, Lead, Executive
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competencyMappings JobCompetencyMapping[]
  skillAssessments   SkillAssessment[]
}

model JobCompetencyMapping {
  id              String            @id @default(uuid())
  jobRoleId       String
  jobRole         JobRole           @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  competencyId    String
  competency      CompetencyCatalog @relation(fields: [competencyId], references: [id])
  requiredLevelId String
  requiredLevel   ProficiencyLevel  @relation(fields: [requiredLevelId], references: [id])
  weight          Float             @default(1.0) // Importance weight 0-1
  isRequired      Boolean           @default(true) // Required vs Preferred
  effectiveFrom   DateTime          @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([jobRoleId, competencyId])
}

// ============================================================================
// 18. SKILL ASSESSMENT
// ============================================================================

model SkillAssessment {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?   @db.Text
  type        String // Self, Manager, 360, Peer
  status      String    @default("Draft") // Draft, In Progress, Completed, Cancelled
  employeeId  String? // Target employee
  jobRoleId   String?
  jobRole     JobRole?  @relation(fields: [jobRoleId], references: [id])
  cycleId     String?
  assessorIds Json? // Array of assessor IDs for 360/peer
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  competencies SkillAssessmentCompetency[]
  results      SkillAssessmentResult[]
}

model SkillAssessmentCompetency {
  id           String            @id @default(uuid())
  assessmentId String
  assessment   SkillAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id])
  weight       Float             @default(1.0)
  createdAt    DateTime          @default(now())

  @@unique([assessmentId, competencyId])
}

model SkillAssessmentResult {
  id            String           @id @default(uuid())
  assessmentId  String
  assessment    SkillAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId  String
  assessorId    String? // Who provided this rating
  assessorType  String? // Self, Manager, Peer
  ratingLevelId String
  ratingLevel   ProficiencyLevel @relation(fields: [ratingLevelId], references: [id])
  comments      String?          @db.Text
  evidence      String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([assessmentId, competencyId, assessorId])
}

// ============================================================================
// 19. GAP ANALYSIS & DEVELOPMENT PLANS
// ============================================================================

model GapAnalysis {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  type         String // Individual, Team, Department, Organization
  targetType   String? // Employee, Department, Team
  targetId     String? // ID of employee/department/team
  status       String   @default("Active")
  analysisDate DateTime @default(now())
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items           GapAnalysisItem[]
  developmentPlan DevelopmentPlan?
}

model GapAnalysisItem {
  id             String            @id @default(uuid())
  gapAnalysisId  String
  gapAnalysis    GapAnalysis       @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)
  competencyId   String
  competency     CompetencyCatalog @relation(fields: [competencyId], references: [id])
  currentLevelId String
  currentLevel   ProficiencyLevel  @relation(fields: [currentLevelId], references: [id])
  targetLevelId  String
  targetLevel    ProficiencyLevel  @relation("TargetLevel", fields: [targetLevelId], references: [id])
  gapScore       Float // Calculated gap
  priority       String            @default("Medium") // Critical, High, Medium, Low
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([gapAnalysisId, competencyId])
}

model DevelopmentPlan {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  description   String?      @db.Text
  type          String // Individual, Team, Department, Organization
  targetType    String? // Employee, Department, Team
  targetId      String?
  gapAnalysisId String?      @unique
  gapAnalysis   GapAnalysis? @relation(fields: [gapAnalysisId], references: [id])
  status        String       @default("Draft") // Draft, Active, In Progress, Completed, Cancelled
  startDate     DateTime?
  endDate       DateTime?
  budget        Float?
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  activities DevelopmentActivity[]
  milestones DevelopmentMilestone[]
}

model DevelopmentActivity {
  id                String          @id @default(uuid())
  developmentPlanId String
  developmentPlan   DevelopmentPlan @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)
  name              String
  type              String // Training, Course, Mentoring, Workshop, Certification, On-the-job
  provider          String?
  description       String?         @db.Text
  duration          String?
  estimatedCost     Float?
  actualCost        Float?
  startDate         DateTime?
  endDate           DateTime?
  completedAt       DateTime?
  status            String          @default("Planned") // Planned, In Progress, Completed, Cancelled
  competencyIds     Json? // Array of competency IDs this activity addresses
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DevelopmentMilestone {
  id                String          @id @default(uuid())
  developmentPlanId String
  developmentPlan   DevelopmentPlan @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  targetDate        DateTime
  completedAt       DateTime?
  status            String          @default("Pending") // Pending, Achieved, Missed
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ============================================================================
// 20. MENA COMPLIANCE - LABOUR LAW ENGINE
// ============================================================================

model LabourLawConfig {
  id            String    @id @default(uuid())
  countryCode   String // ISO country code: AE, SA, BH, QA, OM, KW, IN
  countryName   String
  countryNameAr String? // Arabic name
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Working Hours Configuration
  standardHoursPerDay     Int  @default(8)
  standardHoursPerWeek    Int  @default(48)
  ramadanHoursPerDay      Int? // Reduced hours during Ramadan
  ramadanHoursPerWeek     Int?
  maxOvertimeHoursPerDay  Int?
  maxOvertimeHoursPerYear Int?

  // Overtime Rates (as percentage, e.g., 125 = 125%)
  overtimeRateNormal  Decimal  @default(125)
  overtimeRateNight   Decimal  @default(150)
  overtimeRateHoliday Decimal  @default(150)
  overtimeRateFriday  Decimal? // Friday work rate
  nightShiftStart     String? // e.g., "21:00"
  nightShiftEnd       String? // e.g., "04:00"

  // Probation
  maxProbationDays       Int  @default(90)
  probationExtensionDays Int?
  probationNoticeDays    Int  @default(14)

  // Leave Entitlements (in days)
  annualLeaveFirstYear      Int  @default(21)
  annualLeaveAfterYears     Int  @default(30)
  annualLeaveThresholdYears Int  @default(5) // Years after which higher entitlement
  sickLeaveFullPay          Int  @default(15)
  sickLeaveHalfPay          Int  @default(30)
  sickLeaveUnpaid           Int  @default(45)
  maternityLeaveDays        Int  @default(60)
  maternityLeaveFullPay     Int  @default(45)
  maternityLeaveHalfPay     Int  @default(15)
  paternityLeaveDays        Int  @default(5)
  bereavementLeaveSpouse    Int  @default(5)
  bereavementLeaveFamily    Int  @default(3)
  hajjLeaveDays             Int? // Muslim pilgrimage leave
  hajjLeaveMinServiceYears  Int?
  studyLeaveDays            Int?
  marriageLeaveDays         Int?
  iddahLeaveDays            Int? // Widow waiting period (4 months 10 days = 130)

  // EOSB / Gratuity Configuration
  eosbFirstPeriodYears   Int      @default(5)
  eosbFirstPeriodDays    Int      @default(21) // Days per year for first period
  eosbAfterPeriodDays    Int      @default(30) // Days per year after first period
  eosbMaxMonths          Int? // Maximum cap in months (e.g., 24 = 2 years)
  eosbResignationFactor1 Decimal? // Factor for resignation (1-3 years)
  eosbResignationFactor2 Decimal? // Factor for resignation (3-5 years)
  eosbMinServiceMonths   Int      @default(12) // Minimum service for eligibility

  // Social Insurance Rates (as percentage)
  socialInsuranceEmployeeRate Decimal?
  socialInsuranceEmployerRate Decimal?
  socialInsuranceMaxWage      Decimal? // Contribution cap
  pensionEmployeeRate         Decimal?
  pensionEmployerRate         Decimal?
  unemploymentEmployeeRate    Decimal?
  unemploymentEmployerRate    Decimal?
  occupationalHazardsRate     Decimal?

  // Additional Settings
  weekendDays      Json? // e.g., ["Friday", "Saturday"]
  workWeekStartDay String @default("Sunday")
  currencyCode     String

  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, effectiveFrom])
  @@index([countryCode])
  @@index([status])
}

// ============================================================================
// 21. WPS (WAGE PROTECTION SYSTEM) - UAE
// ============================================================================

model WPSConfiguration {
  id                 String   @id @default(uuid())
  tenantId           String
  companyId          String
  companyName        String   @db.VarChar(200)
  wpsAgentCode       String   @db.VarChar(50) // WPS Agent/Bank code
  employerCode       String   @db.VarChar(50) // Ministry of Labour employer code
  bankCode           String   @db.VarChar(10) // Routing bank code
  bankName           String   @db.VarChar(100)
  bankBranchCode     String?  @db.VarChar(20)
  molEstablishmentId String?  @db.VarChar(50) // Ministry of Labour establishment ID
  wpsFilePrefix      String   @default("WPS") @db.VarChar(10)

  // Contact Information
  contactPerson      String   @db.VarChar(100)
  contactEmail       String   @db.VarChar(150)
  contactPhone       String   @db.VarChar(20)

  // Configuration Settings
  isActive           Boolean  @default(true)
  autoSubmit         Boolean  @default(false) // Auto-submit to MoL portal
  submissionDay      Int      @default(1) // Day of month for submission (1-28)
  reminderDays       Int      @default(3) // Days before to send reminder

  // Validation Rules
  maxSalaryAmount    Decimal  @default(999999999.99) @db.Decimal(15, 2)
  minSalaryAmount    Decimal  @default(0.01) @db.Decimal(15, 2)
  requireLabourCard  Boolean  @default(true)

  // Metadata
  createdBy          String
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions        WPSSubmission[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@index([isActive])
}

model WPSSubmission {
  id                  String           @id @default(uuid())
  tenantId            String
  wpsConfigId         String
  wpsConfig           WPSConfiguration @relation(fields: [wpsConfigId], references: [id])
  payrollRunId        String?          // Link to PayrollRun if integrated
  payrollMonth        String           @db.VarChar(7) // YYYY-MM format
  payrollYear         Int
  salaryMonth         String           @db.VarChar(20) // "JAN2025" format for SIF
  submissionDate      DateTime?
  status              WPSStatus        @default(PENDING)

  // File Information
  sifFileName         String?          @db.VarChar(255)
  sifFileUrl          String?          @db.Text
  sifFileSize         Int?             // File size in bytes
  sifFileChecksum     String?          @db.VarChar(64) // MD5/SHA256 checksum
  responseFileName    String?          @db.VarChar(255)
  responseFileUrl     String?          @db.Text
  molReferenceNumber  String?          @db.VarChar(100)
  molResponseDate     DateTime?

  // Summary Statistics
  totalRecords        Int              @default(0)
  totalAmount         Decimal          @default(0) @db.Decimal(15, 2)
  successCount        Int              @default(0)
  failureCount        Int              @default(0)

  // Status Management
  submittedBy         String?
  submittedAt         DateTime?
  approvedBy          String?
  approvedAt          DateTime?

  // Validation & Errors
  validationErrors    Json?            // Array of validation issues
  processingErrors    Json?            // Array of processing errors
  rejectionReasons    Json?            // Reasons if rejected by WPS
  errorSummary        String?          @db.Text

  // Retry Logic
  retryCount          Int              @default(0)
  lastRetryAt         DateTime?
  maxRetries          Int              @default(3)

  // Metadata
  notes               String?          @db.Text
  createdBy           String
  updatedBy           String?
  processedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records             WPSRecord[]

  @@unique([tenantId, payrollRunId])
  @@index([tenantId])
  @@index([wpsConfigId])
  @@index([payrollRunId])
  @@index([payrollMonth])
  @@index([status])
  @@index([submissionDate])
  @@index([createdAt])
}

model WPSRecord {
  id                  String          @id @default(uuid())
  tenantId            String
  submissionId        String
  submission          WPSSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  employeeId          String

  // Employee WPS Details (snapshot at submission time)
  agentId             String          @db.VarChar(50) // WPS Agent ID
  labourCardNumber    String          @db.VarChar(50) // Employee Labour Card
  personCode          String          @db.VarChar(50) // Person Code from MoL
  employeeName        String          @db.VarChar(200)
  passportNumber      String?         @db.VarChar(50)
  nationality         String          @db.VarChar(50)
  bankRoutingCode     String          @db.VarChar(20)
  accountNumber       String          @db.VarChar(50)
  ibanNumber          String?         @db.VarChar(34) // IBAN if available

  // Salary Details
  basicSalary         Decimal         @db.Decimal(15, 2)
  allowances          Decimal         @default(0) @db.Decimal(15, 2)
  deductions          Decimal         @default(0) @db.Decimal(15, 2)
  netSalary           Decimal         @db.Decimal(15, 2)
  leaveSalary         Decimal         @default(0) @db.Decimal(15, 2)

  // Payment Details
  salaryMonth         String          @db.VarChar(20) // "JAN2025" format
  workingDays         Int             @default(30)
  actualDays          Int             @default(30)

  // Record Status
  status              WPSRecordStatus @default(PENDING)
  validationStatus    String          @default("PENDING") @db.VarChar(20)
  validationErrors    Json?           // Array of field-level validation errors

  // MoL Response
  molStatus           String?         @db.VarChar(50)
  errorCode           String?         @db.VarChar(20)
  errorMessage        String?         @db.Text
  processedDate       DateTime?

  // Line Number in SIF File
  lineNumber          Int

  // Metadata
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            Employee        @relation(fields: [employeeId], references: [id])

  @@unique([submissionId, employeeId])
  @@index([tenantId])
  @@index([submissionId])
  @@index([employeeId])
  @@index([status])
  @@index([labourCardNumber])
  @@index([lineNumber])
}

model WPSAuditLog {
  id                  String      @id @default(uuid())
  tenantId            String
  submissionId        String?
  recordId            String?

  // Action Details
  action              String      @db.VarChar(100)  // CREATE, UPDATE, SUBMIT, APPROVE, REJECT
  actionType          String      @db.VarChar(50)   // CONFIGURATION, SUBMISSION, RECORD
  description         String      @db.Text

  // Actor Information
  userId              String
  userName            String      @db.VarChar(200)
  userRole            String      @db.VarChar(50)
  ipAddress           String?     @db.VarChar(45)
  userAgent           String?     @db.Text

  // Change Tracking
  oldValue            Json?
  newValue            Json?
  changedFields       Json?       // Array of changed field names

  // Status Change
  oldStatus           String?     @db.VarChar(50)
  newStatus           String?     @db.VarChar(50)

  // Metadata
  timestamp           DateTime    @default(now())

  // Relations
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([submissionId])
  @@index([recordId])
  @@index([action])
  @@index([userId])
  @@index([timestamp])
}

enum WPSStatus {
  PENDING             // Initial state, submission created
  VALIDATING          // Running pre-submission validations
  VALIDATION_FAILED   // Validation errors found
  VALIDATED           // Passed all validations
  READY               // Ready for submission
  SUBMITTED           // Submitted to MoL portal
  PROCESSING          // MoL is processing
  ACCEPTED            // Fully accepted by MoL
  REJECTED            // Fully rejected by MoL
  PARTIALLY_ACCEPTED  // Partially accepted (some records failed)
  COMPLETED           // Processing complete
  FAILED              // System failure
  CANCELLED           // Submission cancelled
}

enum WPSRecordStatus {
  PENDING           // Record created, not validated
  VALID             // Passed all validations
  INVALID           // Failed validation
  SUBMITTED         // Submitted to MoL
  ACCEPTED          // Accepted by MoL
  REJECTED          // Rejected by MoL
  CORRECTED         // Corrected after rejection
}

