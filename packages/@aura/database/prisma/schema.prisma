// Per-tenant data residency. The platform routes Prisma queries to the
// corresponding regional cluster based on tenant.regionConfig.primaryRegion.
model TenantRegionConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  primaryRegion   String   // us-east-1 | ap-south-1 | eu-west-1 | me-south-1 | ...
  replicaRegions  String[] @default([])
  dataResidency   String   // STRICT | RELAXED | PROHIBITED_REGIONS
  prohibitedRegions String[] @default([])
  encryptionKeyArn String?  // tenant-specific CMK ARN for cross-region encryption
  effectiveFrom   DateTime @default(now())
  lastVerifiedAt  DateTime?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([primaryRegion])
  @@index([dataResidency])
  @@map("aura_tenant_region_config")
}

// FinOps cost record — one row per (tenant, region, service, day) rollup.
// Lives independently of the cloud provider's billing because chargeback /
// showback per-tenant requires our own attribution model.
model CloudCostRecord {
  id              String   @id @default(uuid())
  tenantId        String?
  region          String
  service         String   // COMPUTE | STORAGE | DB | NETWORK | OBSERVABILITY | ML | LICENSE
  resourceTag     String?
  day             DateTime @db.Date
  costAmount      Decimal
  currency        String   @default("USD")
  unitsConsumed   Float?
  unitMeasure     String?  // vCPU-hours | GB-month | GB-egress | requests | tokens
  provider        String   // AWS | GCP | AZURE | SUPABASE | DATADOG | OPENAI
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([region])
  @@index([service])
  @@index([day])
  @@index([tenantId, day])
  @@index([provider])
  @@map("aura_cloud_cost_record")
}

// Budget alert — fires when actual or forecast spend exceeds threshold.
model CostBudget {
  id              String   @id @default(uuid())
  tenantId        String?
  name            String
  scope           String   // TENANT | SERVICE | REGION | PLATFORM
  scopeValue      String?
  monthlyBudget   Decimal
  currency        String   @default("USD")
  alertThresholdPct Int    @default(80)
  forecastThresholdPct Int @default(100)
  ownerEmail      String?
  isActive        Boolean  @default(true)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([tenantId])
  @@index([scope, scopeValue])
  @@map("aura_cost_budget")
}

// ============================================================================
// v2.0 — DISASTER RECOVERY (#96)
// ============================================================================

// Recorded outcome of a DR drill (restore + smoke + cutover). Drives the
// RPO/RTO scorecard and certifies that backups are actually restorable.
model DRDrill {
  id              String   @id @default(uuid())
  tenantId        String?
  name            String
  scope           String   // FULL | PARTIAL | RUNBOOK_TEST | TABLETOP
  rpoTargetMin    Int      // recovery point objective (minutes of data loss tolerated)
  rtoTargetMin    Int      // recovery time objective (minutes to restore)
  actualRpoMin    Int?     // observed
  actualRtoMin    Int?     // observed
  startedAt       DateTime
  completedAt     DateTime?
  outcome         String   @default("PLANNED") // PLANNED | IN_PROGRESS | PASS | FAIL | INCONCLUSIVE
  notes           String?  @db.Text
  runbookVersion  String?
  ownerUserId     String?
  metadata        Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([tenantId])
  @@index([scope])
  @@index([outcome])
  @@index([startedAt])
  @@map("aura_dr_drill")
}

// Backup metadata — per-job evidence record. Worker writes one row per
// successful backup; restore drills reference these by id.
model BackupRun {
  id              String   @id @default(uuid())
  tenantId        String?  // null = platform-wide backup
  jobName         String   // db-full | db-wal | redis-rdb | objectstore-sync | etc.
  status          String   @default("SUCCESS") // SUCCESS | FAILED | PARTIAL
  startedAt       DateTime
  finishedAt      DateTime?
  durationSec     Int?
  sizeBytes       BigInt?
  checksum        String?
  storageLocation String?  // s3://... or gs://...
  expiresAt       DateTime?
  errorMessage    String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([jobName])
  @@index([status])
  @@index([startedAt])
  @@map("aura_backup_run")
}

// ============================================================================
// v2.0 — SECURITY, COMPLIANCE & DATA GOVERNANCE (#99)
// ============================================================================

// DSAR — Data Subject Access Request (GDPR Art. 15, CCPA, UAE PDPL).
// Captures the request, the response artifact, and the SLA clock.
model DSARRequest {
  id            String   @id @default(uuid())
  tenantId      String
  subjectType   String   @default("EMPLOYEE") // EMPLOYEE | CANDIDATE | DEPENDENT | EX_EMPLOYEE | OTHER
  subjectId     String?
  subjectEmail  String
  requestType   String   // ACCESS | DELETION | RECTIFICATION | PORTABILITY | OBJECTION | RESTRICTION
  status        String   @default("RECEIVED") // RECEIVED | VERIFYING | IN_PROGRESS | FULFILLED | REJECTED | EXTENDED
  legalBasis    String?  // GDPR_ART_15 | CCPA | UAE_PDPL_ART_18 | KSA_PDPL_ART_X | ...
  receivedAt    DateTime @default(now())
  dueBy         DateTime // SLA deadline (jurisdiction-specific; GDPR 30 days)
  fulfilledAt   DateTime?
  extendedAt    DateTime?
  extensionReason String?
  rejectionReason String?
  artifactUrl   String?  // signed link to the export package
  reviewedById  String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)

  @@index([tenantId])
  @@index([status])
  @@index([dueBy])
  @@index([subjectEmail])
  @@map("aura_dsar_request")
}

// Consent record — for processing personal data under each legal basis.
// Versioned: each new privacy policy version requires a fresh consent row.
model ConsentRecord {
  id              String   @id @default(uuid())
  tenantId        String
  subjectId       String
  subjectType     String   @default("EMPLOYEE")
  purpose         String   // PAYROLL | RECRUITMENT | MARKETING | ANALYTICS | THIRD_PARTY_SHARING
  policyVersion   String
  legalBasis      String   // CONSENT | CONTRACT | LEGAL_OBLIGATION | LEGITIMATE_INTERESTS | VITAL_INTERESTS | PUBLIC_TASK
  granted         Boolean
  grantedAt       DateTime?
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?  @db.Text
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([subjectId])
  @@index([purpose])
  @@index([policyVersion])
  @@map("aura_consent_record")
}

// Data Processing Agreement (DPA) with a vendor / sub-processor.
// Required by GDPR Art. 28 for any third party processing personal data
// on the controller's behalf.
model DataProcessingAgreement {
  id              String   @id @default(uuid())
  tenantId        String
