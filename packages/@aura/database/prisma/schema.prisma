// ============================================================================
// 26. PAYROLL CONFIGURATION & PROCESSING
// ============================================================================

model PayrollConfiguration {
  id          String @id @default(uuid())
  tenantId    String
  companyId   String
  countryCode String

  // Pay Cycle
  payCycleType String @default("Monthly") // Monthly, Bi-weekly, Weekly
  payDay       Int    @default(28) // Day of month for payment
  cutoffDay    Int    @default(25) // Attendance cutoff day

  // Components
  componentsConfig Json? // Configurable pay components

  // Statutory
  enableWPS  Boolean @default(false)
  enableGOSI Boolean @default(false)
  enablePF   Boolean @default(false)
  enableESI  Boolean @default(false)
  enableTDS  Boolean @default(false)

  // Calculations
  overtimeCalculationBase String @default("Basic") // Basic, Gross
  leaveEncashmentBase     String @default("Basic")
  gratuityCalculationBase String @default("Basic")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRuns PayrollRun[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@map("aura_payroll_configuration")
}

model PayrollRun {
  id           String               @id @default(uuid())
  tenantId     String
  configId     String
  config       PayrollConfiguration @relation(fields: [configId], references: [id])
  payrollMonth String // YYYY-MM format
  status       PayrollRunStatus     @default(DRAFT)

  // Processing Dates
  processedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  // Approvals
  approvedBy    String?
  approvalLevel Int     @default(0)

  // Summary
  totalEmployees    Int     @default(0)
  totalGrossSalary  Decimal @default(0)
  totalDeductions   Decimal @default(0)
  totalNetSalary    Decimal @default(0)
  totalEmployerCost Decimal @default(0) // Including employer contributions
  currency          String  @default("AED")

  notes     String?
  createdBy String
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  payslips Payslip[]

  @@unique([tenantId, configId, payrollMonth])
  @@index([tenantId])
  @@index([payrollMonth])
  @@index([status])
  @@index([configId])
  @@map("aura_payroll_run")
}

model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employeeCode String
  employeeName String

  // Salary Structure
  basicSalary Decimal

  // Earnings (stored as JSON for flexibility)
  earnings      Json // Array of { code, name, amount }
  totalEarnings Decimal

  // Deductions
  deductions      Json // Array of { code, name, amount }
  totalDeductions Decimal

  // Statutory (separate for clarity)
  employeePF             Decimal @default(0)
  employeeESI            Decimal @default(0)
  employeePension        Decimal @default(0)
  employeeTDS            Decimal @default(0)
  employeeSaned          Decimal @default(0)
  totalStatutoryEmployee Decimal @default(0)

  employerPF             Decimal @default(0)
  employerESI            Decimal @default(0)
  employerPension        Decimal @default(0)
  employerGOSI           Decimal @default(0)
  totalStatutoryEmployer Decimal @default(0)

  // Net
  grossSalary Decimal
  netSalary   Decimal

  // Metadata
  workingDays    Int     @default(0)
  paidDays       Decimal @default(0)
  lopDays        Decimal @default(0) // Loss of Pay
  overtimeHours  Decimal @default(0)
  overtimeAmount Decimal @default(0)

  // Status
  status PayslipStatus @default(DRAFT)
  pdfUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, payrollRunId])
  @@map("aura_payslip")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

