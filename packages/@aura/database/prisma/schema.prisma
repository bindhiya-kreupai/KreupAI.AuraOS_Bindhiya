// EMPLOYMENT HISTORY MODULE
// ========================================

model EmploymentHistory {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  employee   Employee @relation("EmployeeHistory", fields: [employeeId], references: [id], onDelete: Cascade)

  // Change Details
  changeType    String // PROMOTION, DEMOTION, TRANSFER, LATERAL_MOVE, NEW_HIRE, TERMINATION, REHIRE, HIRE, PROBATION_START, PROBATION_CONFIRMATION, DEPARTMENT_TRANSFER, POSITION_CHANGE, GRADE_CHANGE, COMPENSATION_CHANGE, MANAGER_CHANGE, LOCATION_CHANGE, LEAVE_OF_ABSENCE, RETURN_FROM_LEAVE, STATUS_CHANGE
  effectiveDate DateTime
  reason        String?
  notes         String?

  // Previous State (Before Change)
  previousDepartmentId   String?
  previousDepartment     Department? @relation("PreviousDepartment", fields: [previousDepartmentId], references: [id])
  previousPositionId     String?
  previousJobProfileId   String?
  previousJobProfile     JobProfile? @relation("PreviousJobProfile", fields: [previousJobProfileId], references: [id])
  previousGradeId        String?
  previousGrade          Grade?      @relation("PreviousGrade", fields: [previousGradeId], references: [id])
  previousLocationId     String?
  previousLocation       Location?   @relation("PreviousLocation", fields: [previousLocationId], references: [id])
  previousManagerId      String?
  previousSalary         Decimal?    @db.Decimal(15, 2)
  previousEmploymentType String?
  previousStatusId       String?
  newStatusId            String?

  // New State (After Change)
  newDepartmentId   String?
  newDepartment     Department? @relation("NewDepartment", fields: [newDepartmentId], references: [id])
  newPositionId     String?
  newJobProfileId   String?
  newJobProfile     JobProfile? @relation("NewJobProfile", fields: [newJobProfileId], references: [id])
  newGradeId        String?
  newGrade          Grade?      @relation("NewGrade", fields: [newGradeId], references: [id])
  newLocationId     String?
  newLocation       Location?   @relation("NewLocation", fields: [newLocationId], references: [id])
  newManagerId      String?
  newSalary         Decimal?    @db.Decimal(15, 2)
  newEmploymentType String?

  // Flexible before/after snapshots (for non-FK data like allowances, custom fields)
  beforeValues  Json?
  afterValues   Json?

  // Actor (who recorded the event)
  actorId  String?

  // Approval Workflow
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  status      String    @default("COMPLETED") // PENDING, APPROVED, REJECTED, COMPLETED

  // Provenance
  sourceType     String?  @default("MANUAL") // MANUAL, SYSTEM_TRIGGER, IMPORT, MIGRATION, API, WORKFLOW
  sourceMetadata Json?
  isBackfilled   Boolean  @default(false)

  // Metadata
  isAutoGenerated Boolean   @default(false) // True if created by system trigger
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  isDeleted       Boolean   @default(false)

  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, changeType])
  @@index([tenantId, effectiveDate])
  @@index([changeType])
  @@index([effectiveDate])
  @@index([status])
  @@index([tenantId, status])
  @@index([isBackfilled])
  @@index([isDeleted])
  @@map("aura_employment_history")
}

