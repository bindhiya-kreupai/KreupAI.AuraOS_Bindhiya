// ============================================================================
// FMLA & EXTENDED LEAVE MANAGEMENT (#111)
// ============================================================================
// US federal mandate: employers with ≥50 employees must track FMLA.
// 12 work-weeks (480 hours) of unpaid leave per 12-month period for
// qualifying reasons. State analogs (CFRA, OFLA, PFML) plug into the
// same state machine via the `framework` discriminator.

model FMLACase {
  id                  String   @id @default(uuid())
  tenantId            String
  employeeId          String
  framework           String   @default("FMLA") // FMLA | CFRA | OFLA | PFML | INTL_EQUIVALENT
  reason              String   // BIRTH | ADOPTION | FOSTER_CARE | SELF_SERIOUS | FAMILY_SERIOUS | MILITARY_EXIGENCY | MILITARY_CAREGIVER
  // Eligibility snapshot at request time — captured because eligibility
  // criteria depend on tenure (≥1yr) + hours worked (≥1,250) at the moment
  // of request. Stored to make audit reproducible.
  hoursWorkedPrev12Mo Int?     // employer hours-worked threshold check (1,250)
  tenureMonths        Int?     // 12-month employment check
  eligible            Boolean  @default(true)
  ineligibilityReason String?

  // 12-month tracking method (per US DOL § 825.200(b))
  trackingMethod      String   @default("ROLLING_BACKWARD")
  // CALENDAR_YEAR | FIXED_FISCAL | EMPLOYEE_ANNIVERSARY | ROLLING_FORWARD | ROLLING_BACKWARD
  periodStart         DateTime
  periodEnd           DateTime

  // Entitlement accounting (in hours — work the math in hours to handle
  // both continuous and intermittent leave uniformly)
  entitlementHours    Int      @default(480)  // standard 12 work-weeks × 40h
  usedHours           Int      @default(0)
  remainingHours      Int      @default(480)

  requestedAt         DateTime @default(now())
  startDate           DateTime
  expectedEndDate     DateTime?
  actualEndDate       DateTime?
  status              String   @default("DRAFT") // DRAFT | NOTICE_SENT | CERTIFIED | APPROVED | ACTIVE | INTERMITTENT | EXHAUSTED | COMPLETED | DENIED | CANCELED
  certificationDueBy  DateTime?
  certificationReceived DateTime?
  noticeIssuedAt      DateTime?
  noticeReference     String?
  denialReason        String?
  notes               String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?
  isDeleted           Boolean  @default(false)
  deletedAt           DateTime?

  usages              FMLAUsage[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([periodEnd])
  @@index([tenantId, employeeId, status])
  @@map("aura_fmla_case")
}

// One row per discrete day or block of FMLA-counted absence. Supports both
// continuous and intermittent patterns. The sum of hours across usages
// equals the case's usedHours.
model FMLAUsage {
  id            String   @id @default(uuid())
  caseId        String
  case          FMLACase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenantId      String
  employeeId    String
  usageDate     DateTime @db.Date
  hours         Int      // hours of FMLA used on this date (typically ≤ 8)
  pattern       String   @default("CONTINUOUS") // CONTINUOUS | INTERMITTENT | REDUCED_SCHEDULE
  leaveRequestId String?  // optional link back to the underlying LeaveRequest
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([caseId])
  @@index([tenantId, employeeId, usageDate])
  @@index([usageDate])
  @@map("aura_fmla_usage")
}

// ============================================================================
// GLOBAL PAYROLL OPS + GL INTEGRATION (#109)
// ============================================================================

// Chart of accounts entry. Per-tenant, hierarchical via parentId.
// Drives GL journal posting from payroll runs and expense claims.
model GLAccount {
  id            String   @id @default(uuid())
  tenantId      String
  code          String   // e.g., "6100", "2200"
  name          String   // e.g., "Salaries — Operations", "Income Tax Payable"
  type          String   // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  category      String?  // SALARY | TAX | BENEFITS | DEDUCTION | EMPLOYER_COST | PAYABLE
  parentId      String?
  parent        GLAccount? @relation("GLAccountHierarchy", fields: [parentId], references: [id])
  children      GLAccount[] @relation("GLAccountHierarchy")
  countryCode   String?  // optional jurisdictional scoping
  isActive      Boolean  @default(true)
  externalId    String?  // ID in the downstream accounting system (QB / Xero / SAP / Tally)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)

  mappings      PayrollAccountMapping[]
  journalLines  GLJournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([countryCode])
  @@map("aura_gl_account")
}

// Maps a payroll/expense component code → debit/credit GL account.
// Per-country override supported via countryCode.
model PayrollAccountMapping {
  id            String   @id @default(uuid())
  tenantId      String
  componentCode String   // BASIC | HRA | DA | PF | TDS | OT | BONUS | EXPENSE_REIMB | etc.
  componentKind String   // earning | deduction | employer_cost | reimbursement
  debitAccountId  String
  debitAccount    GLAccount @relation(fields: [debitAccountId], references: [id])
  creditAccountId String?
  // (creditAccount relation omitted to avoid Prisma's "Ambiguous relation" detection — second FK lookup done via service)
  countryCode   String?
  costCenterId  String?
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)

  @@unique([tenantId, componentCode, countryCode, effectiveFrom])
  @@index([tenantId])
  @@index([componentCode])
  @@index([countryCode])
  @@map("aura_payroll_account_mapping")
}

// One journal entry per source event (payroll run, F&F, expense pay, etc.).
// Header rows. The line items live in GLJournalLine.
model GLJournalEntry {
  id            String   @id @default(uuid())
  tenantId      String
  countryCode   String
  currency      String   @default("USD")
  entryDate     DateTime
  reference     String   // e.g., "PAYROLL-AE-2026-05"
  description   String?
  sourceType    String   // PAYROLL_RUN | FULL_FINAL | EXPENSE_PAY | ARREARS | BONUS_PAYOUT
  sourceId      String
  status        String   @default("DRAFT") // DRAFT | POSTED | EXPORTED | REVERSED
  totalDebit    Decimal  @default(0)
  totalCredit   Decimal  @default(0)
  postedAt      DateTime?
  postedById    String?
  exportedAt    DateTime?
  exportedToSystem String? // QUICKBOOKS | XERO | SAP | TALLY | ZOHO_BOOKS
  exportReference  String? // real ID returned by the downstream accounting system
  reversalOfId  String?
  metadata      Json     @default("{}")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)

  lines         GLJournalLine[]

  @@index([tenantId])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@index([countryCode])
  @@map("aura_gl_journal_entry")
}

model GLJournalLine {
  id            String   @id @default(uuid())
  entryId       String
  entry         GLJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId     String
  account       GLAccount @relation(fields: [accountId], references: [id])
  costCenterId  String?
  departmentId  String?
  description   String?
  debit         Decimal  @default(0)
  credit        Decimal  @default(0)
  currency      String   @default("USD")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("aura_gl_journal_line")
}

// Pay-equity finding — drives US/EU pay-transparency reporting (#109, P1).
// Captures the result of a Pay Equity Analyzer run against a job grade /
// gender / ethnicity / location cohort.
model PayEquityFinding {
  id             String   @id @default(uuid())
  tenantId       String
  analysisId     String   // ties findings to one analyzer run
  cohortKey      String   // e.g., "grade:L4|gender:F|country:US"
  populationSize Int
  medianPay      Decimal
  meanPay        Decimal
  benchmarkPay   Decimal  // comparable cohort median
  payGapPct      Float    // (medianPay - benchmarkPay) / benchmarkPay * 100
  status         String   @default("OPEN") // OPEN | UNDER_REVIEW | REMEDIATED | DISMISSED
  notes          String?  @db.Text
  remediatedAt   DateTime?
  remediatedById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([analysisId])
  @@index([status])
  @@map("aura_pay_equity_finding")
}

// Tenant-defined custom field for any supported entity (Employee, Department,
// Position, LeaveRequest, ExpenseReport). Used by /admin/custom-fields routes.
model CustomField {
  id              String   @id @default(uuid())
  tenantId        String
  entityType      String   // Employee | Department | Position | LeaveRequest | ExpenseReport
  fieldName       String
  fieldLabel      String
  fieldType       String   // TEXT | NUMBER | DATE | BOOLEAN | SELECT | MULTI_SELECT | FILE | TEXTAREA
  isRequired      Boolean  @default(false)
  isActive        Boolean  @default(true)
  defaultValue    String?
  placeholder     String?
  helpText        String?
  options         Json?    // for SELECT / MULTI_SELECT
  validationRules Json?
  displayOrder    Int      @default(0)
  section         String   @default("General")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId])
  @@index([entityType])
  @@index([isActive])
  @@map("aura_custom_field")
}

// Per-tenant feature flag with role-based rollout. Used by /admin/feature-flags routes.
model FeatureFlag {
  id                String   @id @default(uuid())
  tenantId          String
  key               String
  name              String
  description       String?  @db.Text
  isEnabled         Boolean  @default(false)
  module            String   @default("general")
  rolloutPercentage Int      @default(100)
  enabledForRoles   String[] @default([])
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([key])
  @@index([isEnabled])
  @@map("aura_feature_flag")
}

// Visa, permit, and identity-document tracking. Covers passports, visas,
// Emirates IDs, Iqamas, work permits, labor cards, medical certificates.
// Drives expiry alerts and renewal workflows.
model VisaPermit {
  id                String    @id @default(uuid())
  tenantId          String
  employeeId        String
  documentType      String    // passport | visa | emirates_id | iqama | work_permit | labor_card | medical | residence_permit
  documentNumber    String
  countryCode       String    // ISO-3166-1 alpha-2 — issuing country
  issuingAuthority  String?
  issueDate         DateTime
  expiryDate        DateTime
  category          String?   // employment / family / visit / business / etc.
  status            String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELED | RENEWED | REVOKED
  attachmentIds     Json      @default("[]")
  notes             String?   @db.Text
  metadata          Json      @default("{}")  // sponsor, visa class, etc.

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  renewals          VisaRenewal[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
  @@index([tenantId, expiryDate])
  @@map("aura_visa_permit")
}

model VisaRenewal {
  id                String    @id @default(uuid())
  tenantId          String
  visaPermitId      String
  visaPermit        VisaPermit @relation(fields: [visaPermitId], references: [id])
  employeeId        String
  status            String    @default("REQUESTED") // REQUESTED | IN_PROGRESS | COMPLETED | REJECTED | CANCELED
  requestedBy       String
  assignedTo        String?
  newDocumentNumber String?
  newIssueDate      DateTime?
  newExpiryDate     DateTime?
  estimatedCost     Decimal?
  actualCost        Decimal?
  vendorName        String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  notes             String?   @db.Text
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?

  @@index([tenantId])
  @@index([visaPermitId])
  @@index([employeeId])
  @@index([status])
  @@map("aura_visa_renewal")
}

// Full & Final settlement record. Computed at exit and frozen at PROCESSED.
// Per-jurisdiction rules (UAE/KSA/India/...) live in the FullFinalService;
// breakdown holds the explicit line items: unpaid salary, leave encashment,
// EOSB/gratuity, bonus pro-rata, loan recovery, notice period, tax.
model FullFinalSettlement {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  exitRequestId   String?
  countryCode     String    // ISO-3166-1 alpha-2, drives jurisdiction rules
  lastWorkingDay  DateTime
  joiningDate     DateTime
  serviceMonths   Int
  basicSalary     Decimal
  grossSalary     Decimal
  currency        String    @default("USD")

  // Line items
  unpaidSalary    Decimal   @default(0)
  leaveEncashment Decimal   @default(0)
  gratuity        Decimal   @default(0)
  bonusProRata    Decimal   @default(0)
  loanRecovery    Decimal   @default(0)
  noticeRecovery  Decimal   @default(0)
  otherEarnings   Decimal   @default(0)
  otherDeductions Decimal   @default(0)
  taxAmount       Decimal   @default(0)

  grossPayable    Decimal   @default(0)
  totalDeductions Decimal   @default(0)
  netPayable      Decimal   @default(0)

  breakdown       Json      @default("[]")  // [{ code, label, kind: "earning"|"deduction"|"tax", amount, source }]
  notes           String?   @db.Text
  status          String    @default("DRAFT") // DRAFT | CALCULATED | APPROVED | PROCESSED | CANCELED
  calculatedAt    DateTime?
  approvedById    String?
  approvedAt      DateTime?
  processedAt     DateTime?
  payrollRunId    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([countryCode])
  @@index([tenantId, status])
  @@map("aura_full_final_settlement")
}

// Employee-initiated profile change request (bank, address, emergency contact,
// dependents, personal). Two-step workflow: DRAFT → SUBMITTED → APPROVED/REJECTED,
// with APPLIED set once the underlying record is mutated. Cancel allowed by
// requester at any non-terminal state.
model ProfileChangeRequest {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  requestedById String
  category      String    // bank | address | emergency_contact | dependent | personal | tax
  fieldPath     String?   // dotted field path inside category, optional
  beforeValues  Json      @default("{}")
  afterValues   Json      @default("{}")
  justification String?   @db.Text
  attachmentIds Json      @default("[]")
  effectiveDate DateTime?
  status        String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | APPLIED | CANCELED
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?   @db.Text
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@index([tenantId, status])
  @@map("aura_profile_change_request")
}

// Multi-component salary structure (basic + HRA + DA + transport + ...).
// Referenced by /api/v1/payroll/salary-structures route. components is a JSON
// array of { code, name, type: "earning"|"deduction", calc: "fixed"|"percent"|"slab", value, basedOn? }.
model SalaryStructure {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  code          String
  gradeId       String?
  grade         Grade?    @relation(fields: [gradeId], references: [id])
  basicSalary   Decimal   @default(0)
  grossSalary   Decimal   @default(0)
  currency      String    @default("USD")
  components    Json      @default("[]")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  status        String    @default("Active")
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  employees Employee[] @relation("EmployeeSalaryStructure")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([gradeId])
  @@index([status])
  @@map("aura_salary_structure")
}

model CompensationBand {
  id            String    @id @default(uuid())
  tenantId      String
  bandName      String
  gradeId       String?
  minSalary     Decimal
  midSalary     Decimal?
  maxSalary     Decimal
  currency      String    @default("USD")
