  ratingLevelId String
  ratingLevel   ProficiencyLevel @relation(fields: [ratingLevelId], references: [id])
  comments      String?          @db.Text
  evidence      String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([assessmentId, competencyId, assessorId])
  @@map("aura_skill_assessment_result")
}

