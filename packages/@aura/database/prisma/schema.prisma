  accrued             Decimal  @default(0)
  taken               Decimal  @default(0)
  adjusted            Decimal  @default(0)
  encashed            Decimal  @default(0)
  carriedForward      Decimal  @default(0)
  lapsed              Decimal  @default(0)
  currentBalance      Decimal  @default(0)

  lastAccrualDate     DateTime?
  lastUpdated         DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, policyId, leaveYear])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveYear])
}

enum LeaveAccrualType {
  ANNUAL      // All at once at year start
  MONTHLY     // Pro-rata monthly
  QUARTERLY   // Pro-rata quarterly
  TENURE      // Based on years of service
}

