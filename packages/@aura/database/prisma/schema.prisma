// ============================================================================
// 33. COMPLIANCE AUDIT LOG
// ============================================================================

model ComplianceAuditLog {
  id        String  @id @default(uuid())
  tenantId  String
  companyId String?

  // Action Details
  action     String // SUBMISSION, VALIDATION, APPROVAL, REJECTION, etc.
  module     String // WPS, GOSI, PF, ESI, TDS, PT, EOSB, NITAQAT
  entityType String // Submission, Record, Configuration
  entityId   String

  // User Details
  performedBy     String
  performedByName String?

  // Change Details
  previousState Json?
  newState      Json?
  changes       Json? // Array of field changes

  // Context
  ipAddress String?
  userAgent String?
  notes     String?

  // Bilingual Messages
  message   String
  messageAr String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  tenantId       String
  employeeId     String?
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  // Document Details
  documentName   String
  documentNumber String?
  category       String

  // File Storage
  fileName String
  fileSize Int
  fileType String
  fileUrl  String

  // Versioning
  version  Int                @default(1)
  parentId String?
  parent   EmployeeDocument?  @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions EmployeeDocument[] @relation("DocumentVersions")

  // Expiry & Compliance
  issueDate       DateTime?
  expiryDate      DateTime?
  isExpired       Boolean   @default(false)
  expiryAlertDays Int       @default(30)

  // Verification
  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  // Access Control
  isConfidential Boolean @default(false)
  accessLevel    String  @default("EMPLOYEE")

  // Metadata
  description String?
  tags        String?
  uploadedBy  String

  // Status
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([documentTypeId])
  @@index([category])
  @@index([expiryDate])
  @@index([status])
}

// ========================================
// ASSET MANAGEMENT MODULE
// ========================================

model Asset {
  id       String @id @default(uuid())
  tenantId String

  // Asset Details
  assetCode   String // AST-001
  assetName   String
  description String?
  category    String // COMPUTER, FURNITURE, VEHICLE, MOBILE, EQUIPMENT, OTHER
  assetType   String // Laptop, Desktop, Chair, Car, etc.

  // Identification
  serialNumber String?
  modelNumber  String?
  manufacturer String?
  brand        String?

  // Financial
  purchaseDate     DateTime?
  purchasePrice    Decimal?  @db.Decimal(15, 2)
  currentValue     Decimal?  @db.Decimal(15, 2)
  depreciationRate Float? // Annual percentage
  salvageValue     Decimal?  @db.Decimal(15, 2)

  // Location & Status
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  status     String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, IN_REPAIR, RETIRED, DISPOSED
  condition  String? // EXCELLENT, GOOD, FAIR, POOR

  // Warranty
  warrantyStartDate DateTime?
  warrantyEndDate   DateTime?
  warrantyProvider  String?

  // Assignment
  currentEmployeeId String?
  currentAssignedAt DateTime?

  // Maintenance
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  maintenanceInterval Int? // Days

  // Metadata
  tags     String? // JSON array
  notes    String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignments  AssetAssignment[]
  maintenances AssetMaintenance[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([currentEmployeeId])
  @@index([locationId])
}

model AssetAssignment {
  id         String @id @default(uuid())
  tenantId   String
  assetId    String
  asset      Asset  @relation(fields: [assetId], references: [id])
  employeeId String

  // Assignment Details
  assignedDate       DateTime  @default(now())
  returnedDate       DateTime?
  expectedReturnDate DateTime?

  // Condition
  conditionAtAssignment String? // EXCELLENT, GOOD, FAIR, POOR
  conditionAtReturn     String?

  // Acknowledgment
  assignedBy     String
  acknowledgedBy String?
  acknowledgedAt DateTime?
  returnedBy     String?

  // Notes
  assignmentNotes String?
  returnNotes     String?

  status String @default("ACTIVE") // ACTIVE, RETURNED, LOST, DAMAGED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([assetId])
  @@index([employeeId])
  @@index([status])
}

model AssetMaintenance {
  id       String @id @default(uuid())
  tenantId String
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])

  // Maintenance Details
  maintenanceType String // PREVENTIVE, CORRECTIVE, INSPECTION, UPGRADE
  description     String
  scheduledDate   DateTime
  completedDate   DateTime?

  // Service Details
  serviceProvider String?
  cost            Decimal? @db.Decimal(15, 2)
  invoiceNumber   String?

  // Status
  status String @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  // Notes
  notes       String?
  performedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([assetId])
  @@index([scheduledDate])
  @@index([status])
}

model AssetCategory {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String?
  depreciationRate Float? // Default annual percentage
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ========================================
// EMPLOYMENT HISTORY MODULE
// ========================================

model EmploymentHistory {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  // Change Details
  changeType    String // PROMOTION, DEMOTION, TRANSFER, LATERAL_MOVE, NEW_HIRE, TERMINATION, REHIRE
  effectiveDate DateTime
  reason        String?
  notes         String?

  // Previous State (Before Change)
  previousDepartmentId   String?
  previousDepartment     Department? @relation("PreviousDepartment", fields: [previousDepartmentId], references: [id])
  previousPositionId     String?
  previousJobProfileId   String?
  previousJobProfile     JobProfile? @relation("PreviousJobProfile", fields: [previousJobProfileId], references: [id])
  previousGradeId        String?
  previousGrade          Grade?      @relation("PreviousGrade", fields: [previousGradeId], references: [id])
  previousLocationId     String?
  previousLocation       Location?   @relation("PreviousLocation", fields: [previousLocationId], references: [id])
  previousManagerId      String?
  previousSalary         Decimal?    @db.Decimal(15, 2)
  previousEmploymentType String?

  // New State (After Change)
  newDepartmentId   String?
  newDepartment     Department? @relation("NewDepartment", fields: [newDepartmentId], references: [id])
  newPositionId     String?
  newJobProfileId   String?
  newJobProfile     JobProfile? @relation("NewJobProfile", fields: [newJobProfileId], references: [id])
  newGradeId        String?
  newGrade          Grade?      @relation("NewGrade", fields: [newGradeId], references: [id])
  newLocationId     String?
  newLocation       Location?   @relation("NewLocation", fields: [newLocationId], references: [id])
  newManagerId      String?
  newSalary         Decimal?    @db.Decimal(15, 2)
  newEmploymentType String?

  // Approval Workflow
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  status      String    @default("COMPLETED") // PENDING, APPROVED, REJECTED, COMPLETED

  // Metadata
  isAutoGenerated Boolean  @default(false) // True if created by system trigger
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([changeType])
  @@index([effectiveDate])
  @@index([status])
}

// ========================================
// POSITION MANAGEMENT MODULE
// ========================================

model Position {
  id       String @id @default(uuid())
  tenantId String

  // Position Identity
  positionCode String // POS-ENG-001
  title        String
  description  String?

  // Organization Links
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  locationId   String?
  location     Location?  @relation(fields: [locationId], references: [id])

  // Hierarchy
  reportsToPositionId  String?
  reportsToPosition    Position?  @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinatePositions Position[] @relation("PositionHierarchy")

  // Job Profile Link
  jobProfileId String?
  jobProfile   JobProfile? @relation(fields: [jobProfileId], references: [id])
  gradeId      String?
  grade        Grade?      @relation(fields: [gradeId], references: [id])

  // Headcount & FTE
  headcount   Int     @default(1) // Number of positions
  fte         Decimal @default(1.0) @db.Decimal(5, 2) // Full-time equivalent
  filledCount Int     @default(0) // Currently filled
  vacantCount Int     @default(0) // Currently vacant

  // Compensation
  salaryMin      Decimal? @db.Decimal(15, 2)
  salaryMax      Decimal? @db.Decimal(15, 2)
  salaryCurrency String?  @default("USD")
  annualBudget   Decimal? @db.Decimal(15, 2)

  // Status & Dates
  status        String    @default("DRAFT") // DRAFT, OPEN, FILLED, FROZEN, CLOSED
  effectiveDate DateTime?
  closedDate    DateTime?

  // Approval
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?

  // Metadata
  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employees        Employee[]      @relation("CurrentPosition")
  Address          Address?        @relation(fields: [addressId], references: [id])
  addressId        String?
  EmployeeStatus   EmployeeStatus? @relation(fields: [employeeStatusId], references: [id])
  employeeStatusId String?
  EmploymentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  employmentTypeId String?

  @@unique([tenantId, positionCode])
  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
  @@index([reportsToPositionId])
}

// Life Events Schema Addition
// Add this to the main schema.prisma file

model EmployeeLifeEvent {
  id       String @id @default(uuid())
  tenantId String

  // Employee Reference
  employeeId String
  employee   Employee @relation("EmployeeLifeEvents", fields: [employeeId], references: [id], onDelete: Cascade)

  // Event Details
  eventType   String // MARRIAGE, BIRTH, ADOPTION, DEATH, DIVORCE, RELOCATION, EMERGENCY_CONTACT_CHANGE, etc.
  eventDate   DateTime
  title       String
  description String?

  // Related Person (if applicable)
  relatedPersonName     String?
  relatedPersonRelation String? // Spouse, Child, Parent, Sibling, etc.

  // Documentation
  documentUrl  String?
  documentType String?
  verified     Boolean   @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?

  // Impact Tracking
  impactsPayroll          Boolean @default(false)
  impactsBenefits         Boolean @default(false)
  impactsTax              Boolean @default(false)
  impactsEmergencyContact Boolean @default(false)

  // Workflow
  status      String    @default("PENDING") // PENDING, VERIFIED, PROCESSED, REJECTED
  processedBy String?
  processedAt DateTime?

  // Notifications
  notifyHR         Boolean @default(true)
  notifyManager    Boolean @default(false)
  notificationSent Boolean @default(false)

  // Metadata
  notes       String?
  attachments Json? // Array of attachment URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([tenantId])
  @@index([employeeId])
  @@index([eventType])
  @@index([eventDate])
  @@index([status])
}

model LifeEventType {
  id       String @id @default(uuid())
  tenantId String

  code        String
  name        String
  description String?
  category    String // FAMILY, PERSONAL, EMERGENCY, OTHER

  // Default Settings
  requiresDocument     Boolean @default(false)
  requiresVerification Boolean @default(true)
  impactsPayroll       Boolean @default(false)
  impactsBenefits      Boolean @default(false)
  impactsTax           Boolean @default(false)

  // Notifications
  notifyHR      Boolean @default(true)
  notifyManager Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
}

// ID Card Management
model IDCardTemplate {
  id       String @id @default(uuid())
  tenantId String

  name        String
  description String?
  cardType    String // EMPLOYEE, TEMPORARY, CONTRACTOR, VISITOR

  // Design
  designData    Json // Template design configuration
  logoUrl       String?
  backgroundUrl String?

  // Fields
  includePhoto   Boolean @default(true)
  includeQRCode  Boolean @default(true)
  includeBarcode Boolean @default(false)
  customFields   Json? // Additional fields to display

  // Settings
  validityDays Int? // Card validity in days
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  cards IDCard[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([cardType])
}

model IDCard {
  id       String @id @default(uuid())
  tenantId String

  employeeId String
  employee   Employee @relation("EmployeeIDCards", fields: [employeeId], references: [id], onDelete: Cascade)

  templateId String
  template   IDCardTemplate @relation(fields: [templateId], references: [id])

  // Card Details
  cardNumber String
  cardType   String // EMPLOYEE, TEMPORARY, CONTRACTOR, VISITOR

  // Validity
  issueDate  DateTime
  expiryDate DateTime?

  // Status
  status String @default("PENDING") // PENDING, APPROVED, ISSUED, EXPIRED, REVOKED, LOST

  // Photo
  photoUrl String?

  // Codes
  qrCodeData  String?
  barcodeData String?

  // Issuance
  issuedBy String?
  issuedAt DateTime?

  // Revocation
  revokedBy     String?
  revokedAt     DateTime?
  revokedReason String?

  // Print Tracking
  printedCount  Int       @default(0)
  lastPrintedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([tenantId, cardNumber])
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([expiryDate])
}

// Letter Generation
model LetterTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  letterType  String // OFFER, APPOINTMENT, CONFIRMATION, TRANSFER, PROMOTION, EXIT, EXPERIENCE
  content     String // Template with placeholders
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  letters     Letter[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Letter {
  id              String         @id @default(uuid())
  tenantId        String
  employeeId      String
  employee        Employee       @relation("EmployeeLetters", fields: [employeeId], references: [id])
  templateId      String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  letterType      String
  subject         String
  content         String
  generatedPdfUrl String?
  status          String         @default("DRAFT") // DRAFT, PENDING, APPROVED, ISSUED
  issuedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       String?

  @@index([tenantId])
  @@index([employeeId])
}

// Exit Management
model ExitRequest {
  id               String          @id @default(uuid())
  tenantId         String
  employeeId       String
  employee         Employee        @relation("EmployeeExits", fields: [employeeId], references: [id])
  exitType         String // RESIGNATION, TERMINATION, RETIREMENT, CONTRACT_END
  resignationDate  DateTime
  lastWorkingDate  DateTime
  noticePeriodDays Int
  reason           String?
  status           String          @default("PENDING") // PENDING, APPROVED, PROCESSING, COMPLETED
  clearanceStatus  String          @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  settlementAmount Decimal?        @db.Decimal(15, 2)
  rehireEligible   Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clearances       ExitClearance[]

  @@index([tenantId])
  @@index([employeeId])
}

model ExitClearance {
  id            String      @id @default(uuid())
  exitRequestId String
  exitRequest   ExitRequest @relation(fields: [exitRequestId], references: [id])
  department    String
  description   String
  status        String      @default("PENDING") // PENDING, APPROVED, REJECTED
  clearedBy     String?
  clearedAt     DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([exitRequestId])
}

// Probation Management
model ProbationTracking {
  id                    String            @id @default(uuid())
  tenantId              String
  employeeId            String
  employee              Employee          @relation("EmployeeProbation", fields: [employeeId], references: [id])
  startDate             DateTime
  endDate               DateTime
  extendedEndDate       DateTime?
  status                String            @default("ACTIVE") // ACTIVE, EXTENDED, CONFIRMED, TERMINATED
  performanceRating     String?
  managerRecommendation String?
  hrRecommendation      String?
  finalDecision         String? // CONFIRM, EXTEND, TERMINATE
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reviews               ProbationReview[]

  @@index([tenantId])
  @@index([employeeId])
}

model ProbationReview {
  id                String            @id @default(uuid())
  probationId       String
  probation         ProbationTracking @relation(fields: [probationId], references: [id])
  reviewDate        DateTime
  reviewerName      String
  performanceRating Int // 1-5
  comments          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([probationId])
}

// Confirmation Process
model ConfirmationRequest {
  id                    String    @id @default(uuid())
  tenantId              String
  employeeId            String
  employee              Employee  @relation("EmployeeConfirmation", fields: [employeeId], references: [id])
  eligibleDate          DateTime
  requestedDate         DateTime
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, CONFIRMED
  managerApproval       String? // PENDING, APPROVED, REJECTED
  hrApproval            String? // PENDING, APPROVED, REJECTED
  confirmationDate      DateTime?
  confirmationLetterUrl String?
  newSalary             Decimal?  @db.Decimal(15, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([employeeId])
}

// ============================================================================
// ANALYTICS & INTELLIGENCE
// ============================================================================

// Custom Report Definitions
model ReportDefinition {
  id       String @id @default(uuid())
  tenantId String

  // Report Details
  code        String
  name        String
  description String?
  category    String // HR, PAYROLL, LEAVE, ATTENDANCE, COMPLIANCE, etc.

  // Query Configuration
  dataSource String // TABLE_NAME or CUSTOM_QUERY
  columns    Json // Array of {field, label, type, aggregation}
  filters    Json? // Array of filter definitions
  groupBy    Json? // Array of grouping fields
  sortBy     Json? // Array of {field, direction}

  // Visualization
  chartType   String? // BAR, LINE, PIE, TABLE, etc.
  chartConfig Json? // Chart-specific configuration

  // Access Control
  isPublic   Boolean @default(false)
  createdBy  String
  sharedWith Json? // Array of user/role IDs

  // Schedule
  isScheduled    Boolean @default(false)
  scheduleConfig Json? // Cron expression, recipients

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions ReportExecution[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([category])
  @@index([createdBy])
}

// Report Execution History
model ReportExecution {
  id       String           @id @default(uuid())
  reportId String
  report   ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tenantId String

  // Execution Details
  executedBy String
  executedAt DateTime @default(now())
  parameters Json? // Filter values used

  // Results
  status        String // RUNNING, COMPLETED, FAILED
  recordCount   Int?
  executionTime Int? // Milliseconds
  errorMessage  String?

  // Output
  resultData   Json? // Cached results (if small)
  exportUrl    String? // S3/file path for large results
  exportFormat String? // CSV, EXCEL, PDF

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([tenantId])
  @@index([executedBy])
  @@index([executedAt])
}

// Analytics Dashboard Widgets
model DashboardWidget {
  id          String  @id @default(uuid())
  tenantId    String
  dashboardId String? // null for global widgets

  // Widget Details
  code        String
  title       String
  description String?
  type        String // KPI, CHART, TABLE, LIST, etc.

  // Data Source
  dataSource      String // API_ENDPOINT or REPORT_ID or CUSTOM_QUERY
  refreshInterval Int? // Minutes

  // Configuration
  config   Json // Widget-specific configuration
  position Json // {row, col, width, height}

  // Access
  roles Json? // Array of role codes

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([dashboardId])
}

// Predictive Analytics Models
model PredictiveModel {
  id       String @id @default(uuid())
  tenantId String

  // Model Details
  code        String
  name        String
  description String?
  modelType   String // ATTRITION, PERFORMANCE, HIRING_DEMAND, SALARY_PROJECTION, etc.
  algorithm   String // LINEAR_REGRESSION, RANDOM_FOREST, NEURAL_NETWORK, etc.

  // Training
  trainingDataset Json // Configuration for data extraction
  features        Json // Array of feature definitions
  targetVariable  String

  // Model Metadata
  version         String
  accuracy        Float? // Model accuracy/R2 score
  trainedAt       DateTime?
  trainingRecords Int?

  // Model Artifacts
  modelArtifactUrl String? // S3/file path to saved model
  parameters       Json? // Model hyperparameters

  // Deployment
  status     String    @default("DRAFT") // DRAFT, TRAINING, DEPLOYED, DEPRECATED
  deployedAt DateTime?

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions Prediction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([modelType])
  @@index([status])
}

// Prediction Results
model Prediction {
  id       String          @id @default(uuid())
  modelId  String
  model    PredictiveModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tenantId String

  // Prediction Target
  entityType String // EMPLOYEE, DEPARTMENT, COMPANY
  entityId   String?

  // Prediction
  predictedValue Float
  confidence     Float? // 0-1 confidence score
  predictedDate  DateTime

  // Input Features
  inputFeatures Json // Feature values used

  // Outcome Tracking
  actualValue Float?
  actualDate  DateTime?
  accuracy    Float? // Difference from actual

  createdAt DateTime @default(now())

  @@index([modelId])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([predictedDate])
}

// AI Agent Conversations
model AIAgentConversation {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  // Conversation Details
  title     String?
  agentType String // HR_ASSISTANT, POLICY_ADVISOR, ANALYTICS_BOT, etc.

  // Context
  sessionId String
  metadata  Json? // User context, preferences

  // Status
  status String @default("ACTIVE") // ACTIVE, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIAgentMessage[]

  @@index([tenantId])
  @@index([userId])
  @@index([sessionId])
}

// AI Agent Messages
model AIAgentMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   AIAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Message Details
  role    String // USER, ASSISTANT, SYSTEM
  content String @db.Text

  // Metadata
  tokens Int?
  model  String? // GPT-4, Claude, etc.

  // Actions
  actionTaken  String? // QUERY_DATABASE, GENERATE_REPORT, etc.
  actionResult Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

// Analytics Cache for performance
model AnalyticsCache {
  id       String @id @default(uuid())
  tenantId String

  // Cache Key
  cacheKey String // Unique identifier for cached data
  category String // DASHBOARD, REPORT, ANALYTICS

  // Data
  data Json // Cached analytics data

  // Metadata
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  recordCount Int?

  @@unique([tenantId, cacheKey])
  @@index([tenantId])
  @@index([expiresAt])
}

// ============================================================================
// BENEFITS MANAGEMENT MODULE
// ============================================================================

// Enums for Benefits Management
enum BenefitCategory {
  HEALTH_INSURANCE
  DENTAL
  VISION
  LIFE_INSURANCE
  DISABILITY
  RETIREMENT
  FSA_HSA
  WELLNESS
  EDUCATION
  TRANSPORTATION
  OTHER
}

enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
  EXECUTIVE
}

enum CoverageLevel {
  EMPLOYEE_ONLY
  EMPLOYEE_SPOUSE
  EMPLOYEE_CHILDREN
  FAMILY
}

enum BenefitEnrollmentStatus {
  DRAFT
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  CANCELLED
  TERMINATED
  WAIVED
}

enum BenefitEnrollmentType {
  NEW_HIRE
  OPEN_ENROLLMENT
  QUALIFYING_EVENT
  ANNUAL_RENEWAL
  SPECIAL_ENROLLMENT
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  PENDING_INFO
}

enum DependentRelationship {
  SPOUSE
  DOMESTIC_PARTNER
  CHILD
  STEPCHILD
  ADOPTED_CHILD
  FOSTER_CHILD
  PARENT
  OTHER
}

enum DependentStatus {
  ACTIVE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  INACTIVE
  AGED_OUT
}

enum ProviderType {
  HOSPITAL
  CLINIC
  PHYSICIAN
  SPECIALIST
  PHARMACY
  LABORATORY
  MENTAL_HEALTH
  DENTAL
  VISION
  OTHER
}

enum QualifyingEventType {
  MARRIAGE
  DIVORCE
  BIRTH
  ADOPTION
  DEATH
  EMPLOYMENT_CHANGE
  LOSS_OF_COVERAGE
  RELOCATION
  OTHER
}

enum PremiumPaymentFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY
  SEMI_MONTHLY
  ANNUALLY
}

enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING
  WAIVED
}

// Benefit Plans - Core benefit plan configuration
model BenefitPlan {
  id                     String            @id @default(uuid())
  tenantId               String
  planCode               String
  planName               String
  category               BenefitCategory
  planTier               PlanTier?
  carrierName            String
  carrierPolicyNumber    String?
  description            String?           @db.Text
  coverage               Json? // Coverage details
  exclusions             Json? // List of exclusions
  eligibilityCriteria    Json? // Eligibility rules
  employeePremium        Float             @default(0)
  employerPremium        Float             @default(0)
  spousePremium          Float?
  childPremium           Float?
  familyPremium          Float?
  deductible             Float?
  outOfPocketMax         Float?
  copay                  Float?
  coinsurance            Float?
  networkInfo            Json? // Network details
  documentUrls           Json? // Plan documents
  status                 BenefitPlanStatus @default(DRAFT)
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  waitingPeriodDays      Int               @default(0)
  isEmployeeContribution Boolean           @default(true)
  maxAge                 Int?
  displayOrder           Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  enrollments  BenefitEnrollment[]
  premiumRates PremiumRate[]

  @@unique([tenantId, planCode])
  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([effectiveFrom])
}

// Benefit Enrollments - Employee enrollment in benefit plans
model BenefitEnrollment {
  id                  String                  @id @default(uuid())
  tenantId            String
  employeeId          String
  employeeName        String
  employeeCode        String
  departmentId        String?
  departmentName      String?
  planId              String
  coverageLevel       CoverageLevel
  enrollmentType      BenefitEnrollmentType
  status              BenefitEnrollmentStatus @default(DRAFT)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  employeePremium     Float
  employerPremium     Float
  totalPremium        Float
  paymentFrequency    PremiumPaymentFrequency @default(MONTHLY)
  enrolledDependents  Json? // Array of dependent IDs
  enrollmentDate      DateTime                @default(now())
  approvedBy          String?
  approvedDate        DateTime?
  qualifyingEventId   String?
  qualifyingEventType QualifyingEventType?
  previousPlanId      String?
  cancellationReason  String?
  cancellationDate    DateTime?
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  plan              BenefitPlan        @relation(fields: [planId], references: [id])
  claims            BenefitClaim[]
  premiumDeductions PremiumDeduction[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([planId])
  @@index([status])
  @@index([effectiveFrom])
}

// Dependents - Employee dependents for benefit coverage
model Dependent {
  id                    String                @id @default(uuid())
  tenantId              String
  employeeId            String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  relationship          DependentRelationship
  gender                String?
  ssn                   String?
  email                 String?
  phone                 String?
  address               Json?
  isStudent             Boolean               @default(false)
  isDisabled            Boolean               @default(false)
  status                DependentStatus       @default(PENDING_VERIFICATION)
  verificationDocuments Json?
  verifiedBy            String?
  verifiedDate          DateTime?
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

// Benefit Claims - Claims submitted for benefits
model BenefitClaim {
  id                     String          @id @default(uuid())
  tenantId               String
  claimNumber            String
  enrollmentId           String
  employeeId             String
  employeeName           String
  planId                 String?
  planName               String?
  claimType              BenefitCategory
  claimDate              DateTime
  serviceDate            DateTime
  providerId             String?
  providerName           String?
  claimAmount            Float
  approvedAmount         Float?
  paidAmount             Float?
  employeeResponsibility Float?
  deductibleApplied      Float?
  coinsuranceApplied     Float?
  copayApplied           Float?
  status                 ClaimStatus     @default(SUBMITTED)
  submittedDate          DateTime        @default(now())
  reviewedBy             String?
  reviewedDate           DateTime?
  approvedBy             String?
  approvedDate           DateTime?
  paidDate               DateTime?
  paymentMethod          String?
  checkNumber            String?
  rejectionReason        String?
  documents              Json? // Supporting documents
  diagnosisCodes         Json? // ICD codes
  procedureCodes         Json? // CPT codes
  notes                  String?         @db.Text
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  enrollment BenefitEnrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([employeeId])
  @@index([enrollmentId])
  @@index([status])
  @@index([claimDate])
}

// Healthcare Providers - Provider directory
model HealthcareProvider {
  id                   String       @id @default(uuid())
  tenantId             String
  providerCode         String
  providerName         String
  providerType         ProviderType
  specialty            String?
  npiNumber            String?
  taxId                String?
  address              Json
  phone                String
  email                String?
  website              String?
  networkStatus        String? // In-network, Out-of-network
  acceptingNewPatients Boolean      @default(true)
  languages            Json?
  officeHours          Json?
  rating               Float?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([tenantId, providerCode])
  @@index([tenantId])
  @@index([providerType])
  @@index([specialty])
  @@index([isActive])
}

// Qualifying Events - Life events triggering benefit changes
model QualifyingEvent {
  id                  String              @id @default(uuid())
  tenantId            String
  employeeId          String
  employeeName        String
  eventType           QualifyingEventType
  eventDate           DateTime
  reportedDate        DateTime            @default(now())
  description         String              @db.Text
  supportingDocuments Json?
  allowsEnrollment    Boolean             @default(true)
  enrollmentDeadline  DateTime?
  verifiedBy          String?
  verifiedDate        DateTime?
  isActive            Boolean             @default(true)
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([eventType])
  @@index([eventDate])
}

// Enrollment Windows - Open enrollment periods
model EnrollmentWindow {
  id                 String   @id @default(uuid())
  tenantId           String
  windowName         String
  windowType         String // Open Enrollment, New Hire, Qualifying Event
  planYear           Int
  startDate          DateTime
  endDate            DateTime
  description        String?  @db.Text
  eligibleCategories Json? // Which benefit categories are available
  instructions       String?  @db.Text
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([planYear])
  @@index([startDate])
  @@index([isActive])
}

// Premium Rates - Age-based or tier-based premium rates
model PremiumRate {
  id              String        @id @default(uuid())
  tenantId        String
  planId          String
  coverageLevel   CoverageLevel
  ageMin          Int?
  ageMax          Int?
  employeePremium Float
  employerPremium Float
  totalPremium    Float
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  plan BenefitPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([effectiveFrom])
}

// Premium Deductions - Payroll deduction tracking
model PremiumDeduction {
  id              String    @id @default(uuid())
  tenantId        String
  enrollmentId    String
  employeeId      String
  payrollPeriodId String?
  payrollDate     DateTime
  deductionAmount Float
  paymentMethod   String?
  status          String    @default("PENDING")
  processedDate   DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollment BenefitEnrollment @relation(fields: [enrollmentId], references: [id])

  @@index([tenantId])
  @@index([enrollmentId])
  @@index([employeeId])
  @@index([payrollDate])
}

// ═══════════════════════════════════════════════════════════════════
