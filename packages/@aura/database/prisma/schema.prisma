// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. ORGANIZATION STRUCTURE (Multi-Entity, Multi-Tenant Support)
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., "ACME_CORP"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  userRoles UserRole[]
}

model Company {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  code     String // e.g., "US_HQ"
  name     String
  taxId    String? // EIN, VAT, etc.

  locations   Location[]
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, code])
}

model Department {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String
  name      String
  parentId  String? // For hierarchy (e.g., Engineering -> Backend)
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  employees Employee[]

  @@unique([companyId, code])
}

model CostCenter {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  departments Department[]
}

// ============================================================================
// 2. LOCATION MASTER
// ============================================================================

model Country {
  id       String @id @default(uuid())
  isoCode  String @unique // US, IN, UK
  name     String
  currency String // USD, INR

  states    State[]
  addresses Address[]
}

model State {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  code      String // CA, NY
  name      String

  cities    City[]
  addresses Address[]
}

model City {
  id      String @id @default(uuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  name    String

  addresses Address[]
}

model Address {
  id         String  @id @default(uuid())
  line1      String
  line2      String?
  postalCode String
  cityId     String
  city       City    @relation(fields: [cityId], references: [id])
  stateId    String
  state      State   @relation(fields: [stateId], references: [id])
  countryId  String
  country    Country @relation(fields: [countryId], references: [id])

  locations Location[]
  employees Employee[] // Home address
}

model Location {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String // e.g., "NYC_OFFICE"
  name      String
  type      LocationType // HEADQUARTERS, BRANCH, REMOTE_HUB
  addressId String
  address   Address      @relation(fields: [addressId], references: [id])

  employees Employee[]
}

enum LocationType {
  HEADQUARTERS
  BRANCH
  REMOTE_HUB
  WAREHOUSE
  PLANT
}

// ============================================================================
// 3. JOB ARCHITECTURE
// ============================================================================

model JobFunction {
  id   String @id @default(uuid())
  code String // e.g., "ENG"
  name String // e.g., "Engineering"

  jobFamilies JobFamily[]
}

model JobFamily {
  id         String      @id @default(uuid())
  functionId String
  function   JobFunction @relation(fields: [functionId], references: [id])
  code       String // e.g., "SW_DEV"
  name       String // e.g., "Software Development"

  jobProfiles JobProfile[]
}

model JobProfile {
  id          String    @id @default(uuid())
  familyId    String
  family      JobFamily @relation(fields: [familyId], references: [id])
  gradeId     String?
  grade       Grade?    @relation(fields: [gradeId], references: [id])
  code        String // e.g., "SENIOR_FE"
  title       String // e.g., "Senior Frontend Engineer"
  description String?
  status      String    @default("Active")

  employees Employee[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Grade {
  id    String @id @default(uuid())
  code  String // e.g., "L4"
  name  String // e.g., "Level 4"
  level Int // Numeric level for hierarchy comparison

  employees Employee[]
  profiles  JobProfile[]
}

// ============================================================================
// 4. EMPLOYEE MASTER (The Core)
// ============================================================================

model Employee {
  id     String  @id @default(uuid())
  userId String? @unique // Link to auth user
  user   User?   @relation(fields: [userId], references: [id])

  // Identity
  employeeCode String @unique
  firstName    String
  lastName     String
  email        String @unique

  // Organization Links (Normalized)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])

  // Job Links (Normalized)
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id])
  gradeId      String
  grade        Grade      @relation(fields: [gradeId], references: [id])

  // Manager (Self-Relation)
  managerId String?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id])
  reports   Employee[] @relation("ManagerReports")

  // Status
  // Status
  statusId    String
  status      EmployeeStatus @relation(fields: [statusId], references: [id])
  typeId      String
  type        EmploymentType @relation(fields: [typeId], references: [id])
  joiningDate DateTime

  // Personal
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeStatus {
  id          String  @id @default(uuid())
  code        String  @unique // ACTIVE, PROBATION
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
}

model EmploymentType {
  id          String  @id @default(uuid())
  code        String  @unique // FULL_TIME, PART_TIME
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
}

// ============================================================================
// 5. SYSTEM / AUTH
// ============================================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // Hashed
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employee Employee?

  // User Management Fields
  status     String    @default("Active") // Active, Inactive, Suspended
  mfaEnabled Boolean   @default(false)
  lastLogin  DateTime?

  // Relations
  sessions            UserSession[]
  auditLogs           AuditLog[]
  delegatedTo         UserDelegation[]      @relation("Delegator")
  delegatedFrom       UserDelegation[]      @relation("Delegatee")
  deactivations       UserDeactivation[]
  passwordResetTokens PasswordResetToken[]
  mfaSettings         UserMFA?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Role assignments
  roles UserRole[]
}

// ============================================================================
// 5B. ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  // null for system-wide roles
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  code        String   // SUPER_ADMIN, ADMIN, HR_MANAGER, etc.
  name        String
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  tenantId   String
  assignedBy String?  // User ID who assigned this role
  assignedAt DateTime @default(now())
  expiresAt  DateTime? // Optional: For temporary role assignments

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Permission {
  id          String   @id @default(uuid())
  resource    String   // users, employees, departments, etc.
  action      String   // create, read, update, delete, manage
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// 5C. Password Reset
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed token for security
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  ipAddress String?  // Track where reset was requested from

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// 5D. Multi-Factor Authentication (MFA)
model UserMFA {
  id            String   @id @default(uuid())
  userId        String   @unique
  totpSecret    String?  // Encrypted TOTP secret for authenticator apps
  backupCodes   Json?    // Array of hashed backup codes
  phoneNumber   String?  // For SMS-based MFA (future)
  method        String   @default("totp") // totp, sms, email
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// 6. MASTER DATA (General & System)
// ============================================================================

model Currency {
  id     String @id @default(uuid())
  code   String @unique // USD, EUR
  name   String
  symbol String
  status String @default("Active") // Active, Inactive
}

model Language {
  id     String  @id @default(uuid())
  code   String  @unique // en, es
  name   String
  isRTL  Boolean @default(false)
  status String  @default("Active")
}

model DocumentType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isRequired  Boolean @default(false)
  status      String  @default("Active")
}

// ============================================================================
// 7. ORGANIZATION MASTERS
// ============================================================================

model BusinessUnit {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  head   String?
  status String  @default("Active")
}

model Designation {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  gradeId     String?
  description String?
  status      String  @default("Active")
}

// ============================================================================
// 8. EMPLOYMENT MASTERS
// ============================================================================

model Skill {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  category    String?
  description String?
  status      String  @default("Active")
}

model Competency {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  status      String  @default("Active")
}

// ============================================================================
// 9. TIME & LEAVE MASTERS
// ============================================================================

model LeaveType {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  isPaid Boolean @default(true)
  status String  @default("Active")
}

model ShiftType {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  startTime String
  endTime   String
  status    String @default("Active")
}

model Holiday {
  id     String @id @default(uuid())
  name   String
  date   String // YYYY-MM-DD
  type   String // National, Regional
  status String @default("Active")
}

// ============================================================================
// 10. PAYROLL & FINANCE MASTERS
// ============================================================================

model TaxRegime {
  id      String @id @default(uuid())
  code    String @unique
  name    String
  country String
  status  String @default("Active")
}

model PayComponent {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  type   String // Earning, Deduction
  status String @default("Active")
}

model Bank {
  id         String  @id @default(uuid())
  name       String
  swiftCode  String
  branchName String?
  countryCode String? // ISO codde e.g. AE, IN (Optional for migration safety, backfill later)
  status     String  @default("Active")
}

// ============================================================================
// 11. SYSTEM MASTERS
// ============================================================================

// Note: Role model moved to section 5B (RBAC) for better organization

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  group       String
  description String?
}

// ============================================================================
// 12. EXTENDED MASTERS
// ============================================================================

model EducationLevel {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  status      String  @default("Active")
}

model Relationship {
  id     String @id @default(uuid())
  name   String @unique
  type   String // Immediate, Extended
  status String @default("Active")
}

model ExitReason {
  id     String @id @default(uuid())
  reason String @unique
  type   String // Voluntary, Involuntary
  status String @default("Active")
}

// ============================================================================
// 13. USER MANAGEMENT SUITE
// ============================================================================

model AccessControl {
  id        String   @id @default(uuid())
  name      String
  type      String // IP_RANGE, TIME_WINDOW
  value     String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordPolicy {
  id                  String   @id @default(uuid())
  minLength           Int      @default(8)
  requireUppercase    Boolean  @default(true)
  requireLowercase    Boolean  @default(true)
  requireNumbers      Boolean  @default(true)
  requireSpecialChars Boolean  @default(true)
  expiryDays          Int      @default(90)
  historyCount        Int      @default(5)
  lockoutAttempts     Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SSOConfig {
  id          String   @id @default(uuid())
  enabled     Boolean  @default(false)
  provider    String // SAML, OIDC
  issuerUrl   String?
  ssoUrl      String?
  certificate String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ipAddress  String
  device     String?
  browser    String?
  location   String?
  lastActive DateTime @default(now())
  status     String   @default("Active") // Active, Idle, Revoked
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // LOGIN, CREATE, UPDATE, DELETE
  module    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}

model UserDelegation {
  id          String   @id @default(uuid())
  delegatorId String
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegateeId String
  delegatee   User     @relation("Delegatee", fields: [delegateeId], references: [id])
  role        String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("Scheduled") // Active, Scheduled, Expired
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model License {
  id        String   @id @default(uuid())
  name      String   @unique // Core HR, Payroll
  total     Int
  used      Int      @default(0)
  type      String // Per User, Per Recruiter
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDeactivation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  reason        String?
  deactivatedBy String
  deactivatedAt DateTime @default(now())
}

model MFAConfig {
  id               String   @id @default(uuid())
  enabled          Boolean  @default(false)
  enforceForAdmins Boolean  @default(true)
  enforceForAll    Boolean  @default(false)
  methods          Json // { authenticatorApp: true, sms: false, ... }
  gracePeriodDays  Int      @default(7)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}



// ============================================================================
// 14. RECRUITMENT MODULE
// ============================================================================

model JobPosting {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String
  status      String   @default("Draft")
  description String?  
  postedDate  DateTime?
  
  // Metrics
  views       Int      @default(0)
  clicks      Int      @default(0)
  applies     Int      @default(0)
  
  // Channels (Stored as JSON)
  channels    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// 15. COMPETENCY LIBRARY MODULE
// ============================================================================

model CompetencyCategory {
  id          String   @id @default(uuid())
  code        String   @unique // TECHNICAL, LEADERSHIP, BEHAVIORAL, FUNCTIONAL, CORE
  name        String
  description String?
  icon        String?
  color       String?
  sortOrder   Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competencies     CompetencyCatalog[]
  subcategories    CompetencySubcategory[]
}

model CompetencySubcategory {
  id         String   @id @default(uuid())
  categoryId String
  category   CompetencyCategory @relation(fields: [categoryId], references: [id])
  code       String
  name       String
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  competencies CompetencyCatalog[]

  @@unique([categoryId, code])
}

model CompetencyCatalog {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  categoryId     String
  category       CompetencyCategory @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    CompetencySubcategory? @relation(fields: [subcategoryId], references: [id])
  description    String?  @db.Text
  status         String   @default("Active") // Active, Draft, Archived, Under Review
  version        String   @default("1.0")
  owner          String?
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  proficiencyDescriptors CompetencyProficiencyDescriptor[]
  applicableRoles        CompetencyRoleMapping[]
  relatedCompetencies    CompetencyRelation[]     @relation("SourceCompetency")
  relatedTo              CompetencyRelation[]     @relation("RelatedCompetency")
  assessmentCriteria     CompetencyAssessmentCriteria[]
  developmentResources   CompetencyDevelopmentResource[]
  jobCompetencyMappings  JobCompetencyMapping[]
  skillAssessments       SkillAssessmentCompetency[]
  gapAnalysisItems       GapAnalysisItem[]
}

model CompetencyProficiencyDescriptor {
  id            String   @id @default(uuid())
  competencyId  String
  competency    CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  levelId       String
  level         ProficiencyLevel @relation(fields: [levelId], references: [id])
  description   String?  @db.Text
  behaviors     Json?    // Array of behavior strings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([competencyId, levelId])
}

model CompetencyRelation {
  id                   String   @id @default(uuid())
  sourceCompetencyId   String
  sourceCompetency     CompetencyCatalog @relation("SourceCompetency", fields: [sourceCompetencyId], references: [id], onDelete: Cascade)
  relatedCompetencyId  String
  relatedCompetency    CompetencyCatalog @relation("RelatedCompetency", fields: [relatedCompetencyId], references: [id], onDelete: Cascade)
  relationType         String   @default("Related") // Related, Prerequisite, Complementary
  createdAt            DateTime @default(now())

  @@unique([sourceCompetencyId, relatedCompetencyId])
}

model CompetencyRoleMapping {
  id           String   @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  roleName     String   // Job role name
  createdAt    DateTime @default(now())

  @@unique([competencyId, roleName])
}

model CompetencyAssessmentCriteria {
  id           String   @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  criteria     String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model CompetencyDevelopmentResource {
  id           String   @id @default(uuid())
  competencyId String
  competency   CompetencyCatalog @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  title        String
  type         String   // Course, Book, Workshop, Certification, On-the-job
  url          String?
  provider     String?
  duration     String?
  cost         Float?
  createdAt    DateTime @default(now())
}

// ============================================================================
// 16. PROFICIENCY LEVELS / FRAMEWORKS
// ============================================================================

model ProficiencyFramework {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  type        String   @default("Standard") // Standard, Custom, Industry
  isDefault   Boolean  @default(false)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels ProficiencyLevel[]
}

model ProficiencyLevel {
  id            String   @id @default(uuid())
  frameworkId   String
  framework     ProficiencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code          String
  name          String   // Foundational, Developing, Proficient, Advanced, Expert
  levelNumber   Int      // 1, 2, 3, 4, 5
  description   String?  @db.Text
  color         String?  // For UI display
  icon          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competencyDescriptors CompetencyProficiencyDescriptor[]
  jobCompetencyMappings JobCompetencyMapping[]
  assessmentResults     SkillAssessmentResult[]
  gapAnalysisItems      GapAnalysisItem[]
  gapAnalysisTargets    GapAnalysisItem[]       @relation("TargetLevel")

  @@unique([frameworkId, levelNumber])
  @@unique([frameworkId, code])
}

// ============================================================================
// 17. JOB COMPETENCY MAPPING
// ============================================================================

model JobRole {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  departmentId String?
  description  String?  @db.Text
  level        String?  // Entry, Mid, Senior, Lead, Executive
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competencyMappings JobCompetencyMapping[]
  skillAssessments   SkillAssessment[]
}

model JobCompetencyMapping {
  id               String   @id @default(uuid())
  jobRoleId        String
  jobRole          JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  competencyId     String
  competency       CompetencyCatalog @relation(fields: [competencyId], references: [id])
  requiredLevelId  String
  requiredLevel    ProficiencyLevel @relation(fields: [requiredLevelId], references: [id])
  weight           Float    @default(1.0) // Importance weight 0-1
  isRequired       Boolean  @default(true) // Required vs Preferred
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([jobRoleId, competencyId])
}

// ============================================================================
// 18. SKILL ASSESSMENT
// ============================================================================

model SkillAssessment {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?  @db.Text
  type           String   // Self, Manager, 360, Peer
  status         String   @default("Draft") // Draft, In Progress, Completed, Cancelled
  employeeId     String?  // Target employee
  jobRoleId      String?
  jobRole        JobRole? @relation(fields: [jobRoleId], references: [id])
  cycleId        String?
  assessorIds    Json?    // Array of assessor IDs for 360/peer
  startDate      DateTime?
  endDate        DateTime?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  competencies SkillAssessmentCompetency[]
  results      SkillAssessmentResult[]
}

model SkillAssessmentCompetency {
  id             String   @id @default(uuid())
  assessmentId   String
  assessment     SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId   String
  competency     CompetencyCatalog @relation(fields: [competencyId], references: [id])
  weight         Float    @default(1.0)
  createdAt      DateTime @default(now())

  @@unique([assessmentId, competencyId])
}

model SkillAssessmentResult {
  id              String   @id @default(uuid())
  assessmentId    String
  assessment      SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competencyId    String
  assessorId      String?  // Who provided this rating
  assessorType    String?  // Self, Manager, Peer
  ratingLevelId   String
  ratingLevel     ProficiencyLevel @relation(fields: [ratingLevelId], references: [id])
  comments        String?  @db.Text
  evidence        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([assessmentId, competencyId, assessorId])
}

// ============================================================================
// 19. GAP ANALYSIS & DEVELOPMENT PLANS
// ============================================================================

model GapAnalysis {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  type         String   // Individual, Team, Department, Organization
  targetType   String?  // Employee, Department, Team
  targetId     String?  // ID of employee/department/team
  status       String   @default("Active")
  analysisDate DateTime @default(now())
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items           GapAnalysisItem[]
  developmentPlan DevelopmentPlan?
}

model GapAnalysisItem {
  id              String   @id @default(uuid())
  gapAnalysisId   String
  gapAnalysis     GapAnalysis @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)
  competencyId    String
  competency      CompetencyCatalog @relation(fields: [competencyId], references: [id])
  currentLevelId  String
  currentLevel    ProficiencyLevel @relation(fields: [currentLevelId], references: [id])
  targetLevelId   String
  targetLevel     ProficiencyLevel @relation("TargetLevel", fields: [targetLevelId], references: [id])
  gapScore        Float    // Calculated gap
  priority        String   @default("Medium") // Critical, High, Medium, Low
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([gapAnalysisId, competencyId])
}

model DevelopmentPlan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?  @db.Text
  type           String   // Individual, Team, Department, Organization
  targetType     String?  // Employee, Department, Team
  targetId       String?
  gapAnalysisId  String?  @unique
  gapAnalysis    GapAnalysis? @relation(fields: [gapAnalysisId], references: [id])
  status         String   @default("Draft") // Draft, Active, In Progress, Completed, Cancelled
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities DevelopmentActivity[]
  milestones DevelopmentMilestone[]
}

model DevelopmentActivity {
  id                String   @id @default(uuid())
  developmentPlanId String
  developmentPlan   DevelopmentPlan @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)
  name              String
  type              String   // Training, Course, Mentoring, Workshop, Certification, On-the-job
  provider          String?
  description       String?  @db.Text
  duration          String?
  estimatedCost     Float?
  actualCost        Float?
  startDate         DateTime?
  endDate           DateTime?
  completedAt       DateTime?
  status            String   @default("Planned") // Planned, In Progress, Completed, Cancelled
  competencyIds     Json?    // Array of competency IDs this activity addresses
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DevelopmentMilestone {
  id                String   @id @default(uuid())
  developmentPlanId String
  developmentPlan   DevelopmentPlan @relation(fields: [developmentPlanId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  targetDate        DateTime
  completedAt       DateTime?
  status            String   @default("Pending") // Pending, Achieved, Missed
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
