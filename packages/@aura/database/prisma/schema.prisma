  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  isDeleted         Boolean            @default(false)
  companies         Company[]
  roles             Role[]
  users             User[]
  userRoles         UserRole[]
  wpsAuditLogs      WPSAuditLog[]
  wpsConfigurations WPSConfiguration[]
  wpsRecords        WPSRecord[]
  wpsSubmissions    WPSSubmission[]
