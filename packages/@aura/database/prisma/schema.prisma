// Generated statutory report — UAE MOHRE/WPS, KSA GOSI/Mudad/Nitaqat, India
// Form-16/24Q/PF-ECR/ESI/PT, etc. Holds the payload + submission reference
// returned by the government portal.
model StatutoryReport {
  id                  String    @id @default(uuid())
  tenantId            String
  code                String    // UAE_MOHRE | UAE_WPS_RECON | KSA_GOSI_RECON | IND_FORM_16 | IND_PF_ECR | ...
  countryCode         String    // ISO-3166-1 alpha-2
  periodStart         DateTime
  periodEnd           DateTime
  format              String    @default("json")  // json | excel | pdf | csv | sif | fvu
  status              String    @default("DRAFT") // DRAFT | GENERATED | SUBMITTED | ACKNOWLEDGED | FAILED
  payload             Json      @default("{}")
  fileUrl             String?
  submissionReference String?   // real authority-issued reference, NOT a placeholder
  errorMessage        String?   @db.Text
  generatedAt         DateTime?
  submittedAt         DateTime?
  acknowledgedAt      DateTime?
  generatedById       String?
  submittedById       String?
  metadata            Json      @default("{}")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?

  @@index([tenantId])
  @@index([code])
  @@index([countryCode])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([tenantId, code, periodStart])
  @@map("aura_statutory_report")
}

// COBRA — Consolidated Omnibus Budget Reconciliation Act (US).
// A qualifying event (termination, divorce, dependent ageing out) opens a
// 60-day election window during which the former employee may elect to
// continue health coverage. Default 18-month coverage (longer for some
// secondary events). State machine on the enrollment row tracks the lifecycle.
model CobraQualifyingEvent {
  id                  String    @id @default(uuid())
  tenantId            String
  employeeId          String
  exitRequestId       String?
  eventType           String    // TERMINATION | REDUCED_HOURS | DIVORCE | DEPENDENT_LOSS | DEATH | MEDICARE_ELIGIBILITY
  qualifyingDate      DateTime
  electionDeadline    DateTime  // qualifyingDate + 60 days
  maxCoverageEndDate  DateTime  // typically qualifyingDate + 18 months (or 36 for non-termination events)
  noticeIssuedAt      DateTime?
  noticeReference     String?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?

  enrollments         CobraEnrollment[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([electionDeadline])
  @@index([maxCoverageEndDate])
  @@map("aura_cobra_qualifying_event")
}

model CobraEnrollment {
  id                  String                @id @default(uuid())
  tenantId            String
  qualifyingEventId   String
  qualifyingEvent     CobraQualifyingEvent  @relation(fields: [qualifyingEventId], references: [id])
  employeeId          String
  benefitPlanId       String
  monthlyPremium      Decimal               // includes the 2% admin uplift
  status              String                @default("PENDING_ELECTION")
  // PENDING_ELECTION | ELECTED | ACTIVE | TERMINATED_NONPAYMENT | EXPIRED | DECLINED | CANCELED
  electedAt           DateTime?
  coverageStart       DateTime?
  coverageEnd         DateTime?
  premiumsPaidThrough DateTime?
  totalPremiumsPaid   Decimal               @default(0)
  declineReason       String?
  terminationReason   String?
  notes               String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdBy           String?
  updatedBy           String?

  @@index([tenantId])
  @@index([qualifyingEventId])
  @@index([employeeId])
  @@index([status])
  @@index([coverageEnd])
  @@map("aura_cobra_enrollment")
}

// ============================================================================
// v2.0 — MENA/APAC COMPLIANCE DEEPENING (#97)
// ============================================================================

// GCC labour ministry submissions. Per-jurisdiction adapter pattern — the
// SubmissionAdapter knows whether to format SIF (UAE WPS), CSV (Mudad /
// GOSI batch), JSON (HRSD APIs), or FVU (India TDS).
model LabourMinistrySubmission {
  id              String   @id @default(uuid())
  tenantId        String
  countryCode     String   // ISO-3166-1 alpha-2
  authority       String   // MOHRE | MUDAD | GOSI | HRSD | EPFO | PFRDA | ESIC
  submissionType  String   // WPS | EOSB | NITAQAT_REPORT | SAUDIZATION_QUOTA | EPFO_KYC | ...
  periodStart     DateTime
  periodEnd       DateTime
  payload         Json     @default("{}")
  payloadHash     String?  // sha256 for tamper detection
  format          String   // SIF | CSV | XML | JSON | XBRL | FVU
  status          String   @default("DRAFT") // DRAFT | READY | SUBMITTED | ACKNOWLEDGED | REJECTED | RESUBMITTED
  authorityRef    String?  // real reference returned by the ministry portal
  submittedAt     DateTime?
  acknowledgedAt  DateTime?
  rejectedAt      DateTime?
  rejectionReason String?  @db.Text
  fileUrl         String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)

  @@index([tenantId])
  @@index([countryCode])
  @@index([authority])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("aura_labour_ministry_submission")
}

// Per-employee statutory identifier per country. One row per (employee,
// country, identifier-type) so an employee on rotation can have multiple
// GOSI + Emirates ID rows.
model StatutoryIdentifier {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String
  countryCode     String   // AE | SA | IN | OM | BH | QA | KW
  identifierType  String   // EMIRATES_ID | IQAMA | GOSI_NUMBER | UAN | AADHAAR | PAN | NPSAN | ...
  identifierValue String
  issuedDate      DateTime?
  expiryDate      DateTime?
  issuingAuthority String?
  validated       Boolean  @default(false)
  validatedAt     DateTime?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)

  @@unique([tenantId, employeeId, countryCode, identifierType])
  @@index([tenantId])
  @@index([employeeId])
  @@index([countryCode])
  @@index([identifierType])
  @@map("aura_statutory_identifier")
}

// ============================================================================
// v2.0 — AI/ML PREDICTIVE ANALYTICS (#98)
// ============================================================================

// One row per scored prediction. Used by attrition risk, performance
// prediction, succession-readiness, time-to-hire forecasting. Linked
// back to AIModelCard for full reproducibility under EU AI Act audits.
model PredictionResult {
  id              String   @id @default(uuid())
  tenantId        String
  modelCardId     String?
  modelCode       String   // ATTRITION_RISK | PERF_FORECAST | PROMOTION_READINESS | TIME_TO_HIRE | SOURCING_FUNNEL
  subjectType     String   // EMPLOYEE | CANDIDATE | REQUISITION | TEAM | DEPARTMENT
  subjectId       String
  scoredAt        DateTime @default(now())
  scoreValue      Float    // 0-1 risk for classifiers; raw forecast for regressors
  scoreBand       String?  // LOW | MEDIUM | HIGH | CRITICAL — derived bucket
  features        Json     @default("{}") // input features captured for reproducibility
  explanations    Json     @default("{}") // SHAP / feature-importance values per feature
  confidence      Float?
  confidenceInterval Json? // {lo, hi}
  modelVersion    String
  active          Boolean  @default(true) // false = superseded by a fresher prediction
  expiresAt       DateTime?
  metadata        Json     @default("{}")

  @@index([tenantId])
  @@index([modelCode])
  @@index([subjectType, subjectId])
  @@index([scoreBand])
  @@index([scoredAt])
  @@index([tenantId, modelCode, active])
  @@map("aura_prediction_result")
}

// Recommendation surfaced by the AI agent — distinct from a raw prediction
// because a recommendation is actionable (with a CTA).
model AIRecommendation {
  id              String   @id @default(uuid())
  tenantId        String
  category        String   // ATTRITION_INTERVENTION | LEARNING_PATH | INTERNAL_MOBILITY | TASK_AUTOMATION | INSIGHT
  subjectType     String
  subjectId       String
  title           String
  rationale       String   @db.Text
  recommendedAction Json   @default("{}")
  priority        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String   @default("OPEN") // OPEN | ACCEPTED | DISMISSED | EXPIRED
  acceptedAt      DateTime?
  acceptedById    String?
  dismissedAt     DateTime?
  dismissedById   String?
  dismissReason   String?
  generatingModelCardId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?
  isDeleted       Boolean  @default(false)

  @@index([tenantId])
  @@index([category])
  @@index([subjectType, subjectId])
  @@index([status])
  @@index([priority])
  @@map("aura_ai_recommendation")
}

