  netSalary           Decimal

  // Metadata
  workingDays         Int      @default(0)
  paidDays            Decimal  @default(0)
  lopDays             Decimal  @default(0)  // Loss of Pay
  overtimeHours       Decimal  @default(0)
  overtimeAmount      Decimal  @default(0)

  // Status
  status              PayslipStatus @default(DRAFT)
  pdfUrl              String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([status])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

