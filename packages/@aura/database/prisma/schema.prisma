  isActive        Boolean   @default(true)
  isTaxable       Boolean   @default(true)
  isStatutory     Boolean   @default(false)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, componentCode])
  @@index([tenantId])
}

model CompensationBand {
  id              String    @id @default(uuid())
  tenantId        String
  bandName        String
  gradeId         String?
  minSalary       Decimal
  midSalary       Decimal?
  maxSalary       Decimal
  currency        String    @default("USD")
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

model IncrementCycle {
  id              String    @id @default(uuid())
  tenantId        String
  cycleName       String
  effectiveDate   DateTime
  status          String    @default("draft")
  budgetAmount    Decimal?
  budgetPercentage Float?
  eligibilityCriteria Json?
  approvalWorkflow Json?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

// NOTIFICATION MODELS

model Notification {
  id           String    @id @default(uuid())
  tenantId     String
  title        String
  body         String    @db.Text
  type         String
  priority     String    @default("medium")
  targetType   String    @default("all")
  targetValue  String?
  status       String    @default("draft")
  scheduledAt  DateTime?
  sentAt       DateTime?
  sentCount    Int       @default(0)
  deliveredCount Int     @default(0)
  openedCount  Int       @default(0)
  metadata     Json?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recipients   NotificationRecipient[]

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  status         String    @default("pending")
  deliveredAt    DateTime?
  readAt         DateTime?
  channel        String    @default("push")

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([status])
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  subject     String
  body        String   @db.Text
  type        String
  category    String?
  variables   Json?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

// ============================================================================
// LEARNING & DEVELOPMENT MODELS
// ============================================================================

model Course {
  id            String   @id @default(uuid())
  tenantId      String
  title         String
  description   String?  @db.Text
  category      String?
  level         String   @default("beginner")
  type          String   @default("online")
  duration      Int?
  instructor    String?
  thumbnailUrl  String?
  contentUrl    String?
  modules       Json?
  skills        String[]
  prerequisites String[]
  maxEnrollment Int?
  status        String   @default("draft")
  rating        Float?
  enrollmentCount Int    @default(0)
  completionRate Float?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   CourseEnrollment[]

  @@index([tenantId])
  @@index([status])
  @@index([category])
}

model CourseEnrollment {
  id          String    @id @default(uuid())
  courseId     String
  employeeId  String
  tenantId    String
  status      String    @default("enrolled")
  progress    Float     @default(0)
  enrolledAt  DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  score       Float?
  certificateId String?

  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([employeeId])
  @@index([tenantId])
  @@unique([courseId, employeeId])
}

model TrainingSession {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String?  @db.Text
  type         String   @default("classroom")
  courseId     String?
  instructor   String?
  location     String?
  meetingUrl   String?
  startDate    DateTime
  endDate      DateTime
  maxCapacity  Int?
  status       String   @default("scheduled")
  materials    Json?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendees    SessionAttendee[]

  @@index([tenantId])
  @@index([startDate])
  @@index([status])
}

model SessionAttendee {
  id          String    @id @default(uuid())
  sessionId   String
  employeeId  String
  status      String    @default("registered")
  registeredAt DateTime @default(now())
  checkedInAt DateTime?
  feedback    String?   @db.Text
  rating      Int?

  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([employeeId])
  @@unique([sessionId, employeeId])
}

model Certification {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String
  name           String
  issuingBody    String?
  certificationId String?
  issueDate      DateTime
  expiryDate     DateTime?
  status         String    @default("active")
  credentialUrl  String?
  documentUrl    String?
  skills         String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([expiryDate])
}

model MentoringProgram {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?   @db.Text
  mentorId    String
  menteeId    String
  status      String    @default("active")
  startDate   DateTime
  endDate     DateTime?
  goals       Json?
  notes       String?   @db.Text
  meetingFrequency String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}
