  assignedBy     String
  acknowledgedBy String?
  acknowledgedAt DateTime?
  returnedBy     String?

  // Notes
  assignmentNotes String?
  returnNotes     String?

  status String @default("ACTIVE") // ACTIVE, RETURNED, LOST, DAMAGED

