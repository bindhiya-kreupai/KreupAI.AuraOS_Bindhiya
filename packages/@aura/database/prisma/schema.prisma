  basicSalary        Decimal
  housingAllowance   Decimal      @default(0)

  // Contribution Breakdown
  employeePension    Decimal      @default(0)  // 9.75% for Saudis
  employerPension    Decimal      @default(0)  // 9.75% for Saudis
  sanedEmployee      Decimal      @default(0)  // 0.75% for Saudis
  sanedEmployer      Decimal      @default(0)  // 0.75% for Saudis
  occupationalHazards Decimal     @default(0)  // 2% employer only
  totalEmployee      Decimal      @default(0)
  totalEmployer      Decimal      @default(0)

  // Status
  status             GOSIRecordStatus @default(PENDING)
  errorCode          String?
  errorMessage       String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([submissionId])
  @@index([employeeId])
  @@index([status])
}

enum GOSIStatus {
  PENDING
  VALIDATING
  VALIDATED
  SUBMITTED
  PROCESSING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  FAILED
}

enum GOSIRecordStatus {
  PENDING
  VALID
  INVALID
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ============================================================================
// 23. NITAQAT (SAUDIZATION) TRACKING - KSA
// ============================================================================

model NitaqatConfiguration {
  id              String   @id @default(uuid())
  tenantId        String
  companyId       String
  industryCode    String   // ISIC industry classification
  industryName    String
  companySizeBand String   // Small, Medium, Large, Giant

  // Nitaqat Requirements
  requiredSaudiRatio Decimal  // Required Saudization percentage
  targetRatio        Decimal? // Target ratio for incentives

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots       NitaqatSnapshot[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
}

model NitaqatSnapshot {
  id              String   @id @default(uuid())
  configId        String
  config          NitaqatConfiguration @relation(fields: [configId], references: [id])
  snapshotDate    DateTime @default(now())

  // Headcount
  totalEmployees  Int
  saudiEmployees  Int
  nonSaudiEmployees Int

  // Ratio & Band
  currentRatio    Decimal
  nitaqatBand     NitaqatBand
  previousBand    NitaqatBand?

  // Details
  deficit         Int      @default(0)  // How many Saudis needed to reach target
  surplus         Int      @default(0)  // Excess Saudis above requirement

  notes           String?
  createdAt       DateTime @default(now())

  @@index([configId])
  @@index([snapshotDate])
}

enum NitaqatBand {
  PLATINUM
  GREEN_HIGH
  GREEN_MEDIUM
  GREEN_LOW
  YELLOW
  RED
}

// ============================================================================
// 24. EOSB (END OF SERVICE BENEFITS) / GRATUITY
// ============================================================================

model EOSBCalculation {
  id              String   @id @default(uuid())
  tenantId        String
  employeeId      String
  calculationDate DateTime @default(now())
  calculationType EOSBCalculationType

  // Employee Details at Calculation
  countryCode     String
  joiningDate     DateTime
  lastWorkingDate DateTime?
  yearsOfService  Decimal
  monthsOfService Int
  daysOfService   Int

  // Salary Details
  basicSalary     Decimal
  totalSalary     Decimal
  dailyRate       Decimal

  // Calculation Breakdown
  firstPeriodYears   Decimal @default(0)
  firstPeriodAmount  Decimal @default(0)
  secondPeriodYears  Decimal @default(0)
  secondPeriodAmount Decimal @default(0)
  grossAmount        Decimal

  // Adjustments
  terminationType    TerminationType
  resignationFactor  Decimal @default(1)  // 1/3, 2/3, or 1
  deductions         Decimal @default(0)  // Any deductions

  // Final Amount
  netAmount          Decimal
  currency           String  @default("AED")

  // Status
  status             EOSBStatus @default(CALCULATED)
  approvedBy         String?
  approvedAt         DateTime?
  paidAt             DateTime?

  notes              String?
  calculationDetails Json?    // Detailed breakdown

  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

enum EOSBCalculationType {
  ESTIMATE       // For planning/preview
  FINAL          // Final calculation for settlement
  ADJUSTMENT     // Correction to previous calculation
}

enum TerminationType {
  RESIGNATION           // Employee-initiated
  TERMINATION           // Employer-initiated (with cause)
  TERMINATION_WITHOUT_CAUSE  // Employer-initiated (without cause)
  END_OF_CONTRACT       // Fixed-term contract expiry
  RETIREMENT            // Retirement
