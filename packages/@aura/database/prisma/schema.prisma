// Bonus Management
model BonusScheme {
  id                  String          @id @default(uuid())
  tenantId            String
  schemeCode          String
  schemeName          String
  bonusType           BonusType
  description         String          @db.Text
  fiscalYear          String
  eligibilityCriteria Json            // EligibilityCriteria
  payoutCriteria      Json            // PayoutCriteria
