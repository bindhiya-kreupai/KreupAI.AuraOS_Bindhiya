// ============================================================================
// BENEFITS MANAGEMENT MODULE
// ============================================================================

// Enums for Benefits Management
enum BenefitCategory {
  HEALTH_INSURANCE
  DENTAL
  VISION
  LIFE_INSURANCE
  DISABILITY
  RETIREMENT
  FSA_HSA
  WELLNESS
  EDUCATION
  TRANSPORTATION
  OTHER
}

enum PlanTier {
  BASIC
  STANDARD
  PREMIUM
  EXECUTIVE
}

enum CoverageLevel {
  EMPLOYEE_ONLY
  EMPLOYEE_SPOUSE
  EMPLOYEE_CHILDREN
  FAMILY
}

enum BenefitEnrollmentStatus {
  DRAFT
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  CANCELLED
  TERMINATED
  WAIVED
}

enum BenefitEnrollmentType {
  NEW_HIRE
  OPEN_ENROLLMENT
  QUALIFYING_EVENT
  ANNUAL_RENEWAL
  SPECIAL_ENROLLMENT
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  PENDING_INFO
}

enum DependentRelationship {
  SPOUSE
  DOMESTIC_PARTNER
  CHILD
  STEPCHILD
  ADOPTED_CHILD
  FOSTER_CHILD
  PARENT
  OTHER
}

enum DependentStatus {
  ACTIVE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  INACTIVE
  AGED_OUT
}

enum ProviderType {
  HOSPITAL
  CLINIC
  PHYSICIAN
  SPECIALIST
  PHARMACY
  LABORATORY
  MENTAL_HEALTH
  DENTAL
  VISION
  OTHER
}

enum QualifyingEventType {
  MARRIAGE
  DIVORCE
  BIRTH
  ADOPTION
  DEATH
  EMPLOYMENT_CHANGE
  LOSS_OF_COVERAGE
  RELOCATION
  OTHER
}

enum PremiumPaymentFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY
  SEMI_MONTHLY
  ANNUALLY
}

enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING
  WAIVED
}

// Benefit Plans - Core benefit plan configuration
model BenefitPlan {
  id                   String             @id @default(uuid())
  tenantId             String
  planCode             String
  planName             String
  category             BenefitCategory
  planTier             PlanTier?
  carrierName          String
  carrierPolicyNumber  String?
  description          String?            @db.Text
  coverage             Json?              // Coverage details
  exclusions           Json?              // List of exclusions
  eligibilityCriteria  Json?              // Eligibility rules
  employeePremium      Float              @default(0)
  employerPremium      Float              @default(0)
  spousePremium        Float?
  childPremium         Float?
  familyPremium        Float?
  deductible           Float?
  outOfPocketMax       Float?
  copay                Float?
  coinsurance          Float?
  networkInfo          Json?              // Network details
  documentUrls         Json?              // Plan documents
  status               BenefitPlanStatus  @default(DRAFT)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  waitingPeriodDays    Int                @default(0)
  isEmployeeContribution Boolean          @default(true)
  maxAge               Int?
  displayOrder         Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  enrollments          BenefitEnrollment[]
  premiumRates         PremiumRate[]

  @@unique([tenantId, planCode])
  @@index([tenantId])
  @@index([category])
  @@index([status])
  @@index([effectiveFrom])
}

// Benefit Enrollments - Employee enrollment in benefit plans
model BenefitEnrollment {
  id                    String                     @id @default(uuid())
  tenantId              String
  employeeId            String
  employeeName          String
  employeeCode          String
  departmentId          String?
  departmentName        String?
  planId                String
  coverageLevel         CoverageLevel
  enrollmentType        BenefitEnrollmentType
  status                BenefitEnrollmentStatus    @default(DRAFT)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  employeePremium       Float
  employerPremium       Float
  totalPremium          Float
  paymentFrequency      PremiumPaymentFrequency @default(MONTHLY)
  enrolledDependents    Json?             // Array of dependent IDs
  enrollmentDate        DateTime          @default(now())
  approvedBy            String?
  approvedDate          DateTime?
  qualifyingEventId     String?
  qualifyingEventType   QualifyingEventType?
  previousPlanId        String?
  cancellationReason    String?
  cancellationDate      DateTime?
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  plan                  BenefitPlan       @relation(fields: [planId], references: [id])
  claims                BenefitClaim[]
  premiumDeductions     PremiumDeduction[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([planId])
  @@index([status])
  @@index([effectiveFrom])
}

// Dependents - Employee dependents for benefit coverage
model Dependent {
  id                  String              @id @default(uuid())
  tenantId            String
  employeeId          String
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  relationship        DependentRelationship
  gender              String?
  ssn                 String?
  email               String?
  phone               String?
  address             Json?
  isStudent           Boolean             @default(false)
  isDisabled          Boolean             @default(false)
  status              DependentStatus     @default(PENDING_VERIFICATION)
  verificationDocuments Json?
  verifiedBy          String?
  verifiedDate        DateTime?
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

// Benefit Claims - Claims submitted for benefits
model BenefitClaim {
  id                  String            @id @default(uuid())
  tenantId            String
  claimNumber         String
  enrollmentId        String
  employeeId          String
  employeeName        String
  planId              String?
  planName            String?
  claimType           BenefitCategory
  claimDate           DateTime
  serviceDate         DateTime
  providerId          String?
  providerName        String?
  claimAmount         Float
  approvedAmount      Float?
  paidAmount          Float?
  employeeResponsibility Float?
  deductibleApplied   Float?
  coinsuranceApplied  Float?
  copayApplied        Float?
  status              ClaimStatus       @default(SUBMITTED)
  submittedDate       DateTime          @default(now())
  reviewedBy          String?
  reviewedDate        DateTime?
  approvedBy          String?
  approvedDate        DateTime?
  paidDate            DateTime?
  paymentMethod       String?
  checkNumber         String?
  rejectionReason     String?
  documents           Json?             // Supporting documents
  diagnosisCodes      Json?             // ICD codes
  procedureCodes      Json?             // CPT codes
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  enrollment          BenefitEnrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([employeeId])
  @@index([enrollmentId])
  @@index([status])
  @@index([claimDate])
}

// Healthcare Providers - Provider directory
model HealthcareProvider {
  id                  String        @id @default(uuid())
  tenantId            String
  providerCode        String
  providerName        String
  providerType        ProviderType
  specialty           String?
  npiNumber           String?
  taxId               String?
  address             Json
  phone               String
  email               String?
  website             String?
  networkStatus       String?       // In-network, Out-of-network
  acceptingNewPatients Boolean      @default(true)
  languages           Json?
  officeHours         Json?
  rating              Float?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([tenantId, providerCode])
  @@index([tenantId])
  @@index([providerType])
  @@index([specialty])
  @@index([isActive])
}

// Qualifying Events - Life events triggering benefit changes
model QualifyingEvent {
  id                  String              @id @default(uuid())
  tenantId            String
  employeeId          String
  employeeName        String
  eventType           QualifyingEventType
  eventDate           DateTime
  reportedDate        DateTime            @default(now())
  description         String              @db.Text
  supportingDocuments Json?
  allowsEnrollment    Boolean             @default(true)
  enrollmentDeadline  DateTime?
  verifiedBy          String?
  verifiedDate        DateTime?
  isActive            Boolean             @default(true)
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([eventType])
  @@index([eventDate])
}

// Enrollment Windows - Open enrollment periods
model EnrollmentWindow {
  id                  String      @id @default(uuid())
  tenantId            String
  windowName          String
  windowType          String      // Open Enrollment, New Hire, Qualifying Event
  planYear            Int
  startDate           DateTime
  endDate             DateTime
  description         String?     @db.Text
  eligibleCategories  Json?       // Which benefit categories are available
  instructions        String?     @db.Text
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([tenantId])
  @@index([planYear])
  @@index([startDate])
  @@index([isActive])
}

// Premium Rates - Age-based or tier-based premium rates
model PremiumRate {
  id                  String        @id @default(uuid())
  tenantId            String
  planId              String
  coverageLevel       CoverageLevel
  ageMin              Int?
  ageMax              Int?
  employeePremium     Float
  employerPremium     Float
  totalPremium        Float
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  plan                BenefitPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([effectiveFrom])
}

// Premium Deductions - Payroll deduction tracking
model PremiumDeduction {
  id                  String             @id @default(uuid())
  tenantId            String
  enrollmentId        String
  employeeId          String
  payrollPeriodId     String?
  payrollDate         DateTime
  deductionAmount     Float
  paymentMethod       String?
  status              String             @default("PENDING")
  processedDate       DateTime?
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  enrollment          BenefitEnrollment  @relation(fields: [enrollmentId], references: [id])

  @@index([tenantId])
  @@index([enrollmentId])
  @@index([employeeId])
  @@index([payrollDate])
}
