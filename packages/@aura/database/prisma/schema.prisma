// ============================================================================
// 30. ATTENDANCE CONFIGURATION (Phase 2 #35)
// ============================================================================
// Per-tenant configuration models that back the attendance/* admin routes.
// Convention (consistent across all 10 models in this section):
//   - tenantId required (multi-tenant scope)
//   - companyId nullable (null = applies to all companies in the tenant)
//   - name + description for the admin UI
//   - JSON `config` blob for policy-specific fields (avoids 10 schema migrations
//     when a domain detail changes; downside is no DB-level validation —
//     enforced at the zod layer instead)
//   - `version Int @default(1)` for optimistic locking when two admins edit
//   - soft-delete pair (isDeleted, deletedAt) matching the rest of the schema
//   - audit-trail columns (createdBy, updatedBy)
//   - @@unique([tenantId, name]) per resource so admin UI can show clean names

model TimeRoundingRule {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String?
  name         String
  description  String?
  applicableTo String // 'ALL' | 'DEPARTMENT' | 'DESIGNATION' | 'CUSTOM'
  config       Json
  isActive     Boolean   @default(true)
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String
  updatedBy    String
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  @@unique([tenantId, name])
  @@index([tenantId, companyId, isActive])
  @@map("aura_time_rounding_rule")
}

