  labourCardExpiry  DateTime?
  emiratesId        String?
  emiratesIdExpiry  DateTime?
  visaNumber        String?
  visaType          String?
  visaExpiry        DateTime?
  wpsPersonalNumber String?

  // KSA Specific
  iqamaNumber            String?
  iqamaExpiry            DateTime?
  nationalId             String? // For Saudis
  borderNumber           String?
  gosiSubscriptionNumber String?

