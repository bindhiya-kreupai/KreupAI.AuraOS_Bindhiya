  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================================
// 20. MENA COMPLIANCE - LABOUR LAW ENGINE
// ============================================================================

model LabourLawConfig {
  id                        String    @id @default(uuid())
  countryCode               String    // ISO country code: AE, SA, BH, QA, OM, KW, IN
  countryName               String
  countryNameAr             String?   // Arabic name
  effectiveFrom             DateTime
  effectiveTo               DateTime?

  // Working Hours Configuration
  standardHoursPerDay       Int       @default(8)
  standardHoursPerWeek      Int       @default(48)
  ramadanHoursPerDay        Int?      // Reduced hours during Ramadan
  ramadanHoursPerWeek       Int?
  maxOvertimeHoursPerDay    Int?
  maxOvertimeHoursPerYear   Int?

  // Overtime Rates (as percentage, e.g., 125 = 125%)
  overtimeRateNormal        Decimal   @default(125)
  overtimeRateNight         Decimal   @default(150)
  overtimeRateHoliday       Decimal   @default(150)
  overtimeRateFriday        Decimal?  // Friday work rate
  nightShiftStart           String?   // e.g., "21:00"
  nightShiftEnd             String?   // e.g., "04:00"

  // Probation
  maxProbationDays          Int       @default(90)
  probationExtensionDays    Int?
  probationNoticeDays       Int       @default(14)

  // Leave Entitlements (in days)
  annualLeaveFirstYear      Int       @default(21)
  annualLeaveAfterYears     Int       @default(30)
  annualLeaveThresholdYears Int       @default(5)  // Years after which higher entitlement
  sickLeaveFullPay          Int       @default(15)
  sickLeaveHalfPay          Int       @default(30)
  sickLeaveUnpaid           Int       @default(45)
  maternityLeaveDays        Int       @default(60)
  maternityLeaveFullPay     Int       @default(45)
  maternityLeaveHalfPay     Int       @default(15)
  paternityLeaveDays        Int       @default(5)
  bereavementLeaveSpouse    Int       @default(5)
  bereavementLeaveFamily    Int       @default(3)
  hajjLeaveDays             Int?      // Muslim pilgrimage leave
  hajjLeaveMinServiceYears  Int?
  studyLeaveDays            Int?
  marriageLeaveDays         Int?
  iddahLeaveDays            Int?      // Widow waiting period (4 months 10 days = 130)

  // EOSB / Gratuity Configuration
  eosbFirstPeriodYears      Int       @default(5)
  eosbFirstPeriodDays       Int       @default(21)  // Days per year for first period
  eosbAfterPeriodDays       Int       @default(30)  // Days per year after first period
  eosbMaxMonths             Int?      // Maximum cap in months (e.g., 24 = 2 years)
  eosbResignationFactor1    Decimal?  // Factor for resignation (1-3 years)
  eosbResignationFactor2    Decimal?  // Factor for resignation (3-5 years)
  eosbMinServiceMonths      Int       @default(12)  // Minimum service for eligibility

  // Social Insurance Rates (as percentage)
  socialInsuranceEmployeeRate   Decimal?
  socialInsuranceEmployerRate   Decimal?
  socialInsuranceMaxWage        Decimal?  // Contribution cap
  pensionEmployeeRate           Decimal?
  pensionEmployerRate           Decimal?
  unemploymentEmployeeRate      Decimal?
  unemploymentEmployerRate      Decimal?
  occupationalHazardsRate       Decimal?

  // Additional Settings
  weekendDays               Json?     // e.g., ["Friday", "Saturday"]
  workWeekStartDay          String    @default("Sunday")
  currencyCode              String

  status                    String    @default("Active")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([countryCode, effectiveFrom])
  @@index([countryCode])
  @@index([status])
}

// ============================================================================
// 21. WPS (WAGE PROTECTION SYSTEM) - UAE
// ============================================================================

model WPSConfiguration {
  id              String   @id @default(uuid())
  tenantId        String
  companyId       String
  wpsAgentCode    String   // WPS Agent/Bank code
  employerCode    String   // Ministry of Labour employer code
  bankCode        String   // Routing bank code
  bankBranchCode  String?
  molEstablishmentId String? // Ministry of Labour establishment ID
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     WPSSubmission[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
}

model WPSSubmission {
  id              String      @id @default(uuid())
  tenantId        String
  wpsConfigId     String
  wpsConfig       WPSConfiguration @relation(fields: [wpsConfigId], references: [id])
  payrollMonth    String      // YYYY-MM format
  submissionDate  DateTime?
  status          WPSStatus   @default(PENDING)

  // File Information
  sifFileName     String?
  sifFileUrl      String?
  responseFileName String?
  responseFileUrl String?

  // Summary
  totalRecords    Int         @default(0)
  totalAmount     Decimal     @default(0)
  successCount    Int         @default(0)
  failureCount    Int         @default(0)

  // Validation & Errors
  validationErrors Json?      // Array of validation issues
  rejectionReasons Json?      // Reasons if rejected by WPS

  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  records         WPSRecord[]

  @@index([tenantId])
  @@index([payrollMonth])
  @@index([status])
}

model WPSRecord {
  id              String        @id @default(uuid())
  submissionId    String
  submission      WPSSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  employeeId      String

  // Employee WPS Details
  labourCardNumber String
  personalNumber   String?      // MOL personal number
  bankRoutingCode  String
  accountNumber    String

  // Salary Details
  basicSalary      Decimal
  allowances       Decimal      @default(0)
  deductions       Decimal      @default(0)
  netSalary        Decimal
  leaveSalary      Decimal      @default(0)

  // Status
  status           WPSRecordStatus @default(PENDING)
  errorCode        String?
  errorMessage     String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([submissionId])
  @@index([employeeId])
  @@index([status])
}

enum WPSStatus {
  PENDING
  VALIDATING
  VALIDATED
  SUBMITTED
  PROCESSING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  FAILED
}

enum WPSRecordStatus {
  PENDING
  VALID
  INVALID
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ============================================================================
// 22. GOSI (GENERAL ORGANIZATION FOR SOCIAL INSURANCE) - KSA
// ============================================================================

model GOSIConfiguration {
  id                    String   @id @default(uuid())
  tenantId              String
  companyId             String
  gosiSubscriptionNumber String  // GOSI subscription/registration number
  establishmentNumber   String?  // Ministry of Labour establishment number
  bankAccountIBAN       String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

