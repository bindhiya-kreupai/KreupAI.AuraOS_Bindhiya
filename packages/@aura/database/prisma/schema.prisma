// ============================================================================
// 20. MENA COMPLIANCE - LABOUR LAW ENGINE
// ============================================================================

model LabourLawConfig {
  id            String    @id @default(uuid())
  countryCode   String // ISO country code: AE, SA, BH, QA, OM, KW, IN
  countryName   String
  countryNameAr String? // Arabic name
  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Working Hours Configuration
  standardHoursPerDay     Int  @default(8)
  standardHoursPerWeek    Int  @default(48)
  ramadanHoursPerDay      Int? // Reduced hours during Ramadan
  ramadanHoursPerWeek     Int?
  maxOvertimeHoursPerDay  Int?
  maxOvertimeHoursPerYear Int?

  // Overtime Rates (as percentage, e.g., 125 = 125%)
  overtimeRateNormal  Decimal  @default(125)
  overtimeRateNight   Decimal  @default(150)
  overtimeRateHoliday Decimal  @default(150)
  overtimeRateFriday  Decimal? // Friday work rate
  nightShiftStart     String? // e.g., "21:00"
  nightShiftEnd       String? // e.g., "04:00"

  // Probation
  maxProbationDays       Int  @default(90)
  probationExtensionDays Int?
  probationNoticeDays    Int  @default(14)

  // Leave Entitlements (in days)
  annualLeaveFirstYear      Int  @default(21)
  annualLeaveAfterYears     Int  @default(30)
  annualLeaveThresholdYears Int  @default(5) // Years after which higher entitlement
  sickLeaveFullPay          Int  @default(15)
  sickLeaveHalfPay          Int  @default(30)
  sickLeaveUnpaid           Int  @default(45)
  maternityLeaveDays        Int  @default(60)
  maternityLeaveFullPay     Int  @default(45)
  maternityLeaveHalfPay     Int  @default(15)
  paternityLeaveDays        Int  @default(5)
  bereavementLeaveSpouse    Int  @default(5)
  bereavementLeaveFamily    Int  @default(3)
  hajjLeaveDays             Int? // Muslim pilgrimage leave
  hajjLeaveMinServiceYears  Int?
  studyLeaveDays            Int?
  marriageLeaveDays         Int?
  iddahLeaveDays            Int? // Widow waiting period (4 months 10 days = 130)

  // EOSB / Gratuity Configuration
  eosbFirstPeriodYears   Int      @default(5)
  eosbFirstPeriodDays    Int      @default(21) // Days per year for first period
  eosbAfterPeriodDays    Int      @default(30) // Days per year after first period
  eosbMaxMonths          Int? // Maximum cap in months (e.g., 24 = 2 years)
  eosbResignationFactor1 Decimal? // Factor for resignation (1-3 years)
  eosbResignationFactor2 Decimal? // Factor for resignation (3-5 years)
  eosbMinServiceMonths   Int      @default(12) // Minimum service for eligibility

  // Social Insurance Rates (as percentage)
  socialInsuranceEmployeeRate Decimal?
  socialInsuranceEmployerRate Decimal?
  socialInsuranceMaxWage      Decimal? // Contribution cap
  pensionEmployeeRate         Decimal?
  pensionEmployerRate         Decimal?
  unemploymentEmployeeRate    Decimal?
  unemploymentEmployerRate    Decimal?
  occupationalHazardsRate     Decimal?

  // Additional Settings
  weekendDays      Json? // e.g., ["Friday", "Saturday"]
  workWeekStartDay String @default("Sunday")
  currencyCode     String

  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, effectiveFrom])
  @@index([countryCode])
  @@index([status])
  @@map("aura_labour_law_config")
}

// ============================================================================
// 21. WPS (WAGE PROTECTION SYSTEM) - UAE
// ============================================================================

model WPSConfiguration {
  id                 String  @id @default(uuid())
  tenantId           String
  companyId          String
  companyName        String  @db.VarChar(200)
  wpsAgentCode       String  @db.VarChar(50) // WPS Agent/Bank code
  employerCode       String  @db.VarChar(50) // Ministry of Labour employer code
  bankCode           String  @db.VarChar(10) // Routing bank code
  bankName           String  @db.VarChar(100)
  bankBranchCode     String? @db.VarChar(20)
  molEstablishmentId String? @db.VarChar(50) // Ministry of Labour establishment ID
  wpsFilePrefix      String  @default("WPS") @db.VarChar(10)

  // Contact Information
  contactPerson String @db.VarChar(100)
  contactEmail  String @db.VarChar(150)
  contactPhone  String @db.VarChar(20)

  // Configuration Settings
  isActive      Boolean @default(true)
  autoSubmit    Boolean @default(false) // Auto-submit to MoL portal
  submissionDay Int     @default(1) // Day of month for submission (1-28)
  reminderDays  Int     @default(3) // Days before to send reminder

  // Validation Rules
  maxSalaryAmount   Decimal @default(999999999.99) @db.Decimal(15, 2)
  minSalaryAmount   Decimal @default(0.01) @db.Decimal(15, 2)
  requireLabourCard Boolean @default(true)

  // Metadata
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions WPSSubmission[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@index([isActive])
  @@map("aura_wps_configuration")
}

model WPSSubmission {
  id             String           @id @default(uuid())
  tenantId       String
  wpsConfigId    String
  wpsConfig      WPSConfiguration @relation(fields: [wpsConfigId], references: [id])
  payrollRunId   String? // Link to PayrollRun if integrated
  payrollMonth   String           @db.VarChar(7) // YYYY-MM format
  payrollYear    Int
  salaryMonth    String           @db.VarChar(20) // "JAN2025" format for SIF
  submissionDate DateTime?
  status         WPSStatus        @default(PENDING)

  // File Information
  sifFileName        String?   @db.VarChar(255)
  sifFileUrl         String?   @db.Text
  sifFileSize        Int? // File size in bytes
  sifFileChecksum    String?   @db.VarChar(64) // MD5/SHA256 checksum
  responseFileName   String?   @db.VarChar(255)
  responseFileUrl    String?   @db.Text
  molReferenceNumber String?   @db.VarChar(100)
  molResponseDate    DateTime?

  // Summary Statistics
  totalRecords Int     @default(0)
  totalAmount  Decimal @default(0) @db.Decimal(15, 2)
  successCount Int     @default(0)
  failureCount Int     @default(0)

  // Status Management
  submittedBy String?
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?

  // Validation & Errors
  validationErrors Json? // Array of validation issues
  processingErrors Json? // Array of processing errors
  rejectionReasons Json? // Reasons if rejected by WPS
  errorSummary     String? @db.Text

  // Retry Logic
  retryCount  Int       @default(0)
  lastRetryAt DateTime?
  maxRetries  Int       @default(3)

  // Metadata
  notes       String?   @db.Text
  createdBy   String
  updatedBy   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records WPSRecord[]

  @@unique([tenantId, payrollRunId])
  @@index([tenantId])
  @@index([wpsConfigId])
  @@index([payrollRunId])
  @@index([payrollMonth])
  @@index([status])
  @@index([submissionDate])
  @@index([createdAt])
  @@map("aura_wps_submission")
}

model WPSRecord {
  id           String        @id @default(uuid())
  tenantId     String
  submissionId String
  submission   WPSSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  employeeId   String

  // Employee WPS Details (snapshot at submission time)
  agentId          String  @db.VarChar(50) // WPS Agent ID
  labourCardNumber String  @db.VarChar(50) // Employee Labour Card
  personCode       String  @db.VarChar(50) // Person Code from MoL
  employeeName     String  @db.VarChar(200)
  passportNumber   String? @db.VarChar(50)
  nationality      String  @db.VarChar(50)
  bankRoutingCode  String  @db.VarChar(20)
  accountNumber    String  @db.VarChar(50)
  ibanNumber       String? @db.VarChar(34) // IBAN if available

  // Salary Details
  basicSalary Decimal @db.Decimal(15, 2)
  allowances  Decimal @default(0) @db.Decimal(15, 2)
  deductions  Decimal @default(0) @db.Decimal(15, 2)
  netSalary   Decimal @db.Decimal(15, 2)
  leaveSalary Decimal @default(0) @db.Decimal(15, 2)

  // Payment Details
  salaryMonth String @db.VarChar(20) // "JAN2025" format
  workingDays Int    @default(30)
  actualDays  Int    @default(30)

  // Record Status
  status           WPSRecordStatus @default(PENDING)
  validationStatus String          @default("PENDING") @db.VarChar(20)
  validationErrors Json? // Array of field-level validation errors

  // MoL Response
  molStatus     String?   @db.VarChar(50)
  errorCode     String?   @db.VarChar(20)
  errorMessage  String?   @db.Text
  processedDate DateTime?

  // Line Number in SIF File
  lineNumber Int

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([submissionId, employeeId])
  @@index([tenantId])
  @@index([submissionId])
  @@index([employeeId])
  @@index([status])
  @@index([labourCardNumber])
  @@index([lineNumber])
  @@map("aura_wps_record")
}

model WPSAuditLog {
  id           String  @id @default(uuid())
  tenantId     String
  submissionId String?
  recordId     String?

  // Action Details
  action      String @db.VarChar(100) // CREATE, UPDATE, SUBMIT, APPROVE, REJECT
  actionType  String @db.VarChar(50) // CONFIGURATION, SUBMISSION, RECORD
  description String @db.Text

  // Actor Information
  userId    String
  userName  String  @db.VarChar(200)
  userRole  String  @db.VarChar(50)
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  // Change Tracking
  oldValue      Json?
  newValue      Json?
  changedFields Json? // Array of changed field names

  // Status Change
  oldStatus String? @db.VarChar(50)
  newStatus String? @db.VarChar(50)

  // Metadata
  timestamp DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([submissionId])
  @@index([recordId])
  @@index([action])
  @@index([userId])
  @@index([timestamp])
  @@map("aura_wps_audit_log")
}

enum WPSStatus {
  PENDING // Initial state, submission created
  VALIDATING // Running pre-submission validations
  VALIDATION_FAILED // Validation errors found
  VALIDATED // Passed all validations
  READY // Ready for submission
  SUBMITTED // Submitted to MoL portal
  PROCESSING // MoL is processing
  ACCEPTED // Fully accepted by MoL
  REJECTED // Fully rejected by MoL
  PARTIALLY_ACCEPTED // Partially accepted (some records failed)
  COMPLETED // Processing complete
  FAILED // System failure
  CANCELLED // Submission cancelled
}

enum WPSRecordStatus {
  PENDING // Record created, not validated
  VALID // Passed all validations
  INVALID // Failed validation
  SUBMITTED // Submitted to MoL
  ACCEPTED // Accepted by MoL
  REJECTED // Rejected by MoL
  CORRECTED // Corrected after rejection
}

// ============================================================================
