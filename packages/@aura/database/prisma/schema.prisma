  @@unique([tenantId, schemeCode])
  @@index([tenantId])
  @@index([status])
  @@index([fiscalYear])
}

enum BonusType {
  PERFORMANCE
  ANNUAL
  FESTIVAL
  RETENTION
  SIGNING
  REFERRAL
  PROJECT
}

enum BonusSchemeStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  APPROVED
  PROCESSED
  CANCELLED
}

model BonusPayout {
  id                          String               @id @default(uuid())
  tenantId                    String
  schemeId                    String
  scheme                      BonusScheme          @relation(fields: [schemeId], references: [id])
  schemeName                  String
  employeeId                  String
  employeeCompensation        EmployeeCompensation @relation(fields: [employeeId], references: [id])
  employeeName                String
  employeeCode                String
  departmentId                String
  departmentName              String
  gradeId                     String
  grade                       CompensationGrade    @relation(fields: [gradeId], references: [id])
  gradeName                   String
  targetAmount                Float
  achievedAmount              Float
  payoutAmount                Float
  payoutPercentage            Float
  performanceScore            Float?
  companyPerformanceScore     Float?
  individualPerformanceScore  Float?
  calculation                 String               @db.Text
  payoutDate                  DateTime
  status                      PayoutStatus         @default(DRAFT)
  approvedBy                  String?
  approvedDate                DateTime?
  processedDate               DateTime?
  paymentReference            String?
  notes                       String?              @db.Text
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([tenantId])
  @@index([schemeId])
  @@index([employeeId])
  @@index([status])
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PROCESSED
  PAID
  REJECTED
}

// Stock Options & Equity
model StockGrant {
  id                      String                @id @default(uuid())
  tenantId                String
  grantCode               String
  employeeId              String
  employeeCompensation    EmployeeCompensation  @relation(fields: [employeeId], references: [id])
  employeeName            String
  employeeCode            String
  stockType               StockType
  grantDate               DateTime
  numberOfUnits           Int
  grantPrice              Float
  fairMarketValue         Float
  totalValue              Float
  currency                String                @default("USD")
  vestingScheduleType     VestingSchedule
  vestingStartDate        DateTime
  vestingEndDate          DateTime
  vestingPeriodYears      Int
  cliffPeriodMonths       Int?
  vestingScheduleDetails  Json                  // Array of VestingScheduleDetail
  exercisePrice           Float?
  expirationDate          DateTime?
  status                  StockGrantStatus      @default(GRANTED)
  vestedUnits             Int                   @default(0)
  unvestedUnits           Int
  exercisedUnits          Int                   @default(0)
  forfeitedUnits          Int                   @default(0)
  reason                  String?               @db.Text
  grantedBy               String
  approvedBy              String?
  notes                   String?               @db.Text
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  exercises StockExercise[]

  @@unique([tenantId, grantCode])
  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

enum StockType {
  RSU
  ESOP
  STOCK_OPTIONS
  PHANTOM_STOCK
  SAR
}

enum VestingSchedule {
  IMMEDIATE
  CLIFF
  GRADED
  PERFORMANCE_BASED
}

enum StockGrantStatus {
  GRANTED
  VESTING
  VESTED
  EXERCISED
  FORFEITED
  EXPIRED
}

model StockExercise {
  id               String          @id @default(uuid())
  tenantId         String
  grantId          String
  grant            StockGrant      @relation(fields: [grantId], references: [id])
  employeeId       String
  employeeName     String
  exerciseDate     DateTime
  unitsExercised   Int
  exercisePrice    Float
  fairMarketValue  Float
  totalCost        Float
  totalValue       Float
  gain             Float
  tax              Float
  netProceeds      Float
  currency         String          @default("USD")
  paymentMethod    String
  status           ExerciseStatus  @default(REQUESTED)
  approvedBy       String?
  approvedDate     DateTime?
  executedDate     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId])
  @@index([grantId])
  @@index([employeeId])
  @@index([status])
}

enum ExerciseStatus {
  REQUESTED
  APPROVED
  EXECUTED
  REJECTED
}

// Loans & Advances
model LoanScheme {
  id                  String   @id @default(uuid())
  tenantId            String
  schemeCode          String
  schemeName          String
  loanType            LoanType
  description         String   @db.Text
  maxAmount           Float
  minAmount           Float
  maxTenureMonths     Int
  minTenureMonths     Int
  interestRate        Float
  isInterestBearing   Boolean  @default(true)
  eligibilityCriteria Json     // LoanEligibilityCriteria
  currency            String   @default("USD")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  loans EmployeeLoan[]

  @@unique([tenantId, schemeCode])
  @@index([tenantId])
  @@index([isActive])
}

enum LoanType {
  PERSONAL
  HOUSING
  VEHICLE
  EDUCATION
  EMERGENCY
}

model EmployeeLoan {
  id                   String               @id @default(uuid())
  tenantId             String
  loanCode             String
  schemeId             String
  scheme               LoanScheme           @relation(fields: [schemeId], references: [id])
  schemeName           String
  employeeId           String
  employeeCompensation EmployeeCompensation @relation(fields: [employeeId], references: [id])
  employeeName         String
  employeeCode         String
  loanType             LoanType
  applicationDate      DateTime
  principalAmount      Float
  interestRate         Float
  tenureMonths         Int
  emiAmount            Float
  totalRepayable       Float
  disbursementDate     DateTime?
  currency             String               @default("USD")
  purpose              String               @db.Text
  status               LoanStatus           @default(PENDING)
  outstandingPrincipal Float
  outstandingInterest  Float
  totalOutstanding     Float
  principalPaid        Float                @default(0)
  interestPaid         Float                @default(0)
  totalPaid            Float                @default(0)
  emiSchedule          Json                 // Array of EMISchedule
  guarantorId          String?
  guarantorName        String?
  collateralDetails    String?              @db.Text
  approvers            Json?                // Array of Approver
  submittedBy          String
  submittedDate        DateTime?
  approvedBy           String?
  approvedDate         DateTime?
  rejectedBy           String?
  rejectedDate         DateTime?
  rejectionReason      String?              @db.Text
  closedDate           DateTime?
  notes                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, loanCode])
  @@index([tenantId])
  @@index([schemeId])
  @@index([employeeId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  FULLY_REPAID
  WRITTEN_OFF
}

// Arrears Processing
model ArrearsRequest {
  id                   String               @id @default(uuid())
  tenantId             String
  requestCode          String
  employeeId           String
  employeeCompensation EmployeeCompensation @relation(fields: [employeeId], references: [id])
  employeeName         String
  employeeCode         String
