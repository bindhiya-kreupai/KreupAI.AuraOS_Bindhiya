  totalGrossSalary    Decimal  @default(0)
  totalDeductions     Decimal  @default(0)
  totalNetSalary      Decimal  @default(0)
  totalEmployerCost   Decimal  @default(0)  // Including employer contributions
  currency            String   @default("AED")

  notes               String?
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payslips            Payslip[]

  @@unique([tenantId, configId, payrollMonth])
  @@index([tenantId])
  @@index([payrollMonth])
  @@index([status])
}

model Payslip {
  id                  String   @id @default(uuid())
  payrollRunId        String
  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId          String
  employeeCode        String
  employeeName        String

  // Salary Structure
  basicSalary         Decimal

  // Earnings (stored as JSON for flexibility)
  earnings            Json     // Array of { code, name, amount }
  totalEarnings       Decimal

  // Deductions
  deductions          Json     // Array of { code, name, amount }
  totalDeductions     Decimal

  // Statutory (separate for clarity)
  employeePF          Decimal  @default(0)
  employeeESI         Decimal  @default(0)
  employeePension     Decimal  @default(0)
  employeeTDS         Decimal  @default(0)
  employeeSaned       Decimal  @default(0)
  totalStatutoryEmployee Decimal @default(0)

  employerPF          Decimal  @default(0)
  employerESI         Decimal  @default(0)
  employerPension     Decimal  @default(0)
  employerGOSI        Decimal  @default(0)
  totalStatutoryEmployer Decimal @default(0)

  // Net
  grossSalary         Decimal
  netSalary           Decimal

  // Metadata
  workingDays         Int      @default(0)
  paidDays            Decimal  @default(0)
  lopDays             Decimal  @default(0)  // Loss of Pay
  overtimeHours       Decimal  @default(0)
  overtimeAmount      Decimal  @default(0)

  // Status
  status              PayslipStatus @default(DRAFT)
  pdfUrl              String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([status])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

