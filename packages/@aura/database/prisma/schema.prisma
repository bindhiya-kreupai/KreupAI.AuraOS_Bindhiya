// Salary Components - Building blocks of salary structures
model SalaryComponent {
  id              String            @id @default(uuid())
  tenantId        String
  componentCode   String
  componentName   String
  type            ComponentType
  calculationType CalculationType
  isStatutory     Boolean           @default(false)
  isTaxable       Boolean           @default(true)
  isPartOfCTC     Boolean           @default(true)
  isPartOfGross   Boolean           @default(true)
  isPartOfBasic   Boolean           @default(false)
  defaultValue    Float?
  formula         String?           @db.Text
  minValue        Float?
  maxValue        Float?
  displayOrder    Int               @default(0)
  isActive        Boolean           @default(true)
  description     String?           @db.Text
  glCode          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tenantId, componentCode])
  @@index([tenantId])
  @@index([isActive])
}

enum ComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum CalculationType {
  FIXED
  PERCENTAGE_OF_BASIC
  PERCENTAGE_OF_GROSS
  PERCENTAGE_OF_CTC
  FORMULA
}

// Grades & Salary Bands for Compensation
model CompensationGrade {
  id                String        @id @default(uuid())
  tenantId          String
  gradeCode         String
  gradeName         String
  gradeType         GradeType
  level             Int
  description       String        @db.Text
  competencies      Json?
  responsibilities  Json?
  minimumExperience Int           @default(0)
  educationRequired String?
  reportingLevel    Int           @default(0)
  employeeCount     Int           @default(0)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bands                  SalaryBand[]
  salaryStructures       SalaryStructure[]
  employeeCompensations  EmployeeCompensation[]
  incrementProposals     IncrementProposal[]
  bonusPayouts           BonusPayout[]

  @@unique([tenantId, gradeCode])
  @@index([tenantId])
  @@index([isActive])
}

enum GradeType {
  EXECUTIVE
  MANAGEMENT
  PROFESSIONAL
  OPERATIONAL
  ENTRY_LEVEL
}

model SalaryBand {
  id                    String              @id @default(uuid())
  tenantId              String
  gradeId               String
  grade                 CompensationGrade   @relation(fields: [gradeId], references: [id])
  bandName              String
  currency              String    @default("USD")
  minSalary             Float
  midSalary             Float
  maxSalary             Float
  spreadPercentage      Float
  market25thPercentile  Float?
  market50thPercentile  Float?
  market75thPercentile  Float?
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  employeeCount         Int       @default(0)
  averageSalary         Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
  @@index([gradeId])
}

// Salary Structure - Templates for compensation
model SalaryStructure {
  id                String              @id @default(uuid())
  tenantId          String
  structureCode     String
  structureName     String
  description       String              @db.Text
  gradeId           String
  grade             CompensationGrade   @relation(fields: [gradeId], references: [id])
  gradeName         String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  currency          String    @default("USD")
  payFrequency      PayFrequency @default(MONTHLY)
  components        Json      // Array of StructureComponent
  isTemplate        Boolean   @default(true)
  isActive          Boolean   @default(true)
  applicableCount   Int       @default(0)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employeeCompensations EmployeeCompensation[]

  @@unique([tenantId, structureCode])
  @@index([tenantId])
  @@index([gradeId])
  @@index([isActive])
}

enum PayFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY
  QUARTERLY
  ANNUALLY
}

// Employee Compensation - Individual employee compensation records
model EmployeeCompensation {
  id               String              @id @default(uuid())
  tenantId         String
  employeeId       String
  employeeName     String
  employeeCode     String
  departmentId     String
  departmentName   String
  positionId       String
  positionTitle    String
  gradeId          String
  grade            CompensationGrade   @relation(fields: [gradeId], references: [id])
  gradeName        String
  structureId      String
  structure        SalaryStructure  @relation(fields: [structureId], references: [id])
  structureName    String
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  currency         String           @default("USD")
  payFrequency     PayFrequency     @default(MONTHLY)
  annualCTC        Float
  monthlyCTC       Float
  annualGross      Float
  monthlyGross     Float
  annualBasic      Float
  monthlyBasic     Float
  components       Json             // Array of CompensationComponent
  lastRevisionDate DateTime?
  nextReviewDate   DateTime?
  isActive         Boolean          @default(true)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  incrementProposals IncrementProposal[]
  bonusPayouts       BonusPayout[]
  stockGrants        StockGrant[]
  loans              EmployeeLoan[]
  arrearsRequests    ArrearsRequest[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([gradeId])
  @@index([isActive])
}

// Increment Cycles & Proposals
model IncrementCycle {
  id                  String              @id @default(uuid())
  tenantId            String
  cycleCode           String
  cycleName           String
  fiscalYear          String
  incrementType       IncrementType
  effectiveDate       DateTime
  budgetAmount        Float
  budgetPercentage    Float
  currency            String              @default("USD")
  status              IncrementCycleStatus @default(DRAFT)
  eligibilityCriteria Json                // EligibilityCriteria
  departments         Json                // Array of DepartmentBudget
  totalAllocated      Float               @default(0)
  totalUsed           Float               @default(0)
  employeesEligible   Int                 @default(0)
  employeesProcessed  Int                 @default(0)
  approvers           Json?               // Array of Approver
  startDate           DateTime
  endDate             DateTime
  processedDate       DateTime?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  proposals IncrementProposal[]

  @@unique([tenantId, cycleCode])
  @@index([tenantId])
  @@index([status])
  @@index([fiscalYear])
}

enum IncrementType {
  MERIT
  PROMOTION
  MARKET_ADJUSTMENT
  COST_OF_LIVING
  RETENTION
}

enum IncrementCycleStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  CANCELLED
}

model IncrementProposal {
