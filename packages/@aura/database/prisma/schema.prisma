  employeeESI         Decimal  @default(0)
  employeePension     Decimal  @default(0)
  employeeTDS         Decimal  @default(0)
  employeeSaned       Decimal  @default(0)
  totalStatutoryEmployee Decimal @default(0)

  employerPF          Decimal  @default(0)
  employerESI         Decimal  @default(0)
  employerPension     Decimal  @default(0)
  employerGOSI        Decimal  @default(0)
  totalStatutoryEmployer Decimal @default(0)

  // Net
