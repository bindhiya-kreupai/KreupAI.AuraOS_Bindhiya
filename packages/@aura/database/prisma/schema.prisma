// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. ORGANIZATION STRUCTURE (Multi-Entity, Multi-Tenant Support)
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., "ACME_CORP"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  userRoles UserRole[]

  // WPS Relations
  wpsConfigurations WPSConfiguration[]
  wpsSubmissions    WPSSubmission[]
  wpsRecords        WPSRecord[]
  wpsAuditLogs      WPSAuditLog[]
  @@map("aura_tenant")
}

model Company {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  code      String // e.g., "US_HQ"
  name      String
  taxId     String? // EIN, VAT, etc.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  locations   Location[]
  departments Department[]
  employees   Employee[]

  // Transfers
  transfersFrom InterCompanyTransfer[] @relation("TransferFrom")
  transfersTo   InterCompanyTransfer[] @relation("TransferTo")

  @@unique([tenantId, code])
  @@index([tenantId])

  @@map("aura_company")
}

model Department {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String
  name      String
  parentId  String? // For hierarchy (e.g., Engineering -> Backend)
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  employees                 Employee[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousDepartment")
  newEmploymentHistory      EmploymentHistory[] @relation("NewDepartment")
  Position                  Position[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@index([isDeleted])
  @@map("aura_department")
}

model CostCenter {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  departments Department[]

  @@map("aura_cost_center")
}

// ============================================================================
// 2. LOCATION MASTER
// ============================================================================

model Country {
  id       String @id @default(uuid())
  isoCode  String @unique // US, IN, UK
  name     String
  currency String // USD, INR

  states    State[]
  addresses Address[]

  @@map("aura_country")
}

model State {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  code      String // CA, NY
  name      String

  cities    City[]
  addresses Address[]

  @@index([countryId])
  @@map("aura_state")
}

model City {
  id      String @id @default(uuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id])
  name    String

  addresses Address[]

  @@index([stateId])

  @@map("aura_city")
}

model Address {
  id         String  @id @default(uuid())
  line1      String
  line2      String?
  postalCode String
  cityId     String
  city       City    @relation(fields: [cityId], references: [id])
  stateId    String
  state      State   @relation(fields: [stateId], references: [id])
  countryId  String
  country    Country @relation(fields: [countryId], references: [id])

  locations Location[]
  employees Employee[] // Home address
  positions Position[]

  @@map("aura_address")
}

model Location {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  code      String // e.g., "NYC_OFFICE"
  name      String
  type      LocationType // HEADQUARTERS, BRANCH, REMOTE_HUB
  addressId String
  address   Address      @relation(fields: [addressId], references: [id])

  employees                 Employee[]
  assets                    Asset[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousLocation")
  newEmploymentHistory      EmploymentHistory[] @relation("NewLocation")
  Position                  Position[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([type])
  @@index([isDeleted])
  @@map("aura_location")
}

enum LocationType {
  HEADQUARTERS
  BRANCH
  REMOTE_HUB
  WAREHOUSE
  PLANT
}

// ============================================================================
// 3. JOB ARCHITECTURE
// ============================================================================

model JobFunction {
  id   String @id @default(uuid())
  code String // e.g., "ENG"
  name String // e.g., "Engineering"

  jobFamilies JobFamily[]

  @@map("aura_job_function")
}

model JobFamily {
  id         String      @id @default(uuid())
  functionId String
  function   JobFunction @relation(fields: [functionId], references: [id])
  code       String // e.g., "SW_DEV"
  name       String // e.g., "Software Development"

  jobProfiles JobProfile[]
  @@map("aura_job_family")
}

model JobProfile {
  id          String    @id @default(uuid())
  familyId    String
  family      JobFamily @relation(fields: [familyId], references: [id])
  gradeId     String?
  grade       Grade?    @relation(fields: [gradeId], references: [id])
  code        String // e.g., "SENIOR_FE"
  title       String // e.g., "Senior Frontend Engineer"
  description String?
  status      String    @default("Active")

  employees                 Employee[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousJobProfile")
  newEmploymentHistory      EmploymentHistory[] @relation("NewJobProfile")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Position  Position[]

  @@index([familyId])
  @@index([gradeId])
  @@index([status])

  @@map("aura_job_profile")
}

model Grade {
  id        String    @id @default(uuid())
  tenantId  String?
  code      String // e.g., "L4"
  name      String // e.g., "Level 4"
  level     Int // Numeric level for hierarchy comparison
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  employees                 Employee[]
  profiles                  JobProfile[]
  previousEmploymentHistory EmploymentHistory[] @relation("PreviousGrade")
  newEmploymentHistory      EmploymentHistory[] @relation("NewGrade")
  Position                  Position[]
  salaryStructures          SalaryStructure[]

  @@index([tenantId])
  @@map("aura_grade")
}

// ============================================================================
// 4. EMPLOYEE MASTER (The Core)
// ============================================================================

model Employee {
  id     String  @id @default(uuid())
  userId String? @unique // Link to auth user
  user   User?   @relation(fields: [userId], references: [id])

  // Identity
  employeeCode String @unique
  firstName    String
  lastName     String
  email        String @unique

  // Organization Links (Normalized)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id])

  // Job Links (Normalized)
  jobProfileId String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id])
  gradeId      String
  grade        Grade      @relation(fields: [gradeId], references: [id])

  // Manager (Self-Relation)
  managerId String?
  manager   Employee?  @relation("ManagerReports", fields: [managerId], references: [id])
  reports   Employee[] @relation("ManagerReports")

  // Position
  positionId String?
  position   Position? @relation("CurrentPosition", fields: [positionId], references: [id])

  // Status
  // Status
  statusId    String
  status      EmployeeStatus @relation(fields: [statusId], references: [id])
  typeId      String
  type        EmploymentType @relation(fields: [typeId], references: [id])
  joiningDate DateTime

  // Personal
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // Relations to other modules
  employeeLifeEvents   EmployeeLifeEvent[]   @relation("EmployeeLifeEvents")
  employmentHistory    EmploymentHistory[]    @relation("EmployeeHistory")
  idcards              IDCard[]              @relation("EmployeeIDCards")
  letters              Letter[]              @relation("EmployeeLetters")
  exitRequests         ExitRequest[]         @relation("EmployeeExits")
  probationTrackings   ProbationTracking[]   @relation("EmployeeProbation")
  confirmationRequests ConfirmationRequest[] @relation("EmployeeConfirmation")

  // WPS Relations
  wpsRecords WPSRecord[]

  // Additional Relations
  emergencyContacts EmergencyContact[]
  garnishments      Garnishment[]
  hsaFsaAccounts    HSAFSAAccount[]
  taxDocuments      TaxDocument[]

  // Leadership Upgrades
  transfers             InterCompanyTransfer[]
  sharedServiceRequests SharedServiceRequest[] @relation("ServiceRequestor")
  assignedServices      SharedServiceRequest[] @relation("ServiceAssignee")

  // Compensation
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation("EmployeeSalaryStructure", fields: [salaryStructureId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@index([companyId])
  @@index([departmentId])
  @@index([locationId])
  @@index([statusId])
  @@index([managerId])
  @@index([jobProfileId])
  @@index([gradeId])
  @@index([companyId, statusId])
  @@index([joiningDate])
  @@index([isDeleted])
  @@index([email])
  @@index([employeeCode])
  @@index([companyId, isDeleted])
  @@index([salaryStructureId])
  @@map("aura_employee")
}

model EmployeeStatus {
  id          String  @id @default(uuid())
  code        String  @unique // ACTIVE, PROBATION
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
  positions Position[]

  @@map("aura_employee_status")
}

model EmploymentType {
  id          String  @id @default(uuid())
  code        String  @unique // FULL_TIME, PART_TIME
  name        String
  description String?
  status      String  @default("Active")

  employees Employee[]
  positions Position[]

  @@map("aura_employment_type")
}

model EmployeeNumberSequence {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  prefix      String
  nextNumber  Int      @default(1)
  padding     Int      @default(5)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, companyId])
  @@index([tenantId])
  @@index([companyId])
  @@map("aura_employee_number_sequence")
}

model EmployeeMasterDataDraft {
  id                    String   @id @default(uuid())
  tenantId              String
  onboardingInstanceId  String?
  offerId               String?
  employeeId            String?
  status                String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ACTIVATED | REJECTED
  masterData            Json
  validationSnapshot    Json
  duplicateSnapshot     Json?
  submittedBy           String?
  submittedAt           DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  activatedBy           String?
  activatedAt           DateTime?
  rejectionReason       String?  @db.Text
  createdBy             String
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  isDeleted             Boolean  @default(false)
  deletedAt             DateTime?

  @@index([tenantId])
  @@index([onboardingInstanceId])
  @@index([offerId])
  @@index([employeeId])
  @@index([status])
  @@map("aura_employee_master_data_draft")
}

model EmployeeIdentification {
  id             String   @id @default(uuid())
  tenantId       String
  employeeId     String
  countryCode    String
  identifierType String   // PASSPORT | EMIRATES_ID | IQAMA | CPR | QID | NATIONAL_ID | CIVIL_ID
  identifierValue String
  issueDate      DateTime?
  expiryDate     DateTime?
  isPrimary      Boolean  @default(false)
  sourceDraftId  String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?

  @@unique([tenantId, identifierType, identifierValue])
  @@index([tenantId])
  @@index([employeeId])
  @@index([countryCode])
  @@index([identifierType])
  @@map("aura_employee_identification")
}

model EmployeeLifecycleEvent {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String
  eventType      String
  payload        Json
  status         String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  publishedAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?   @db.Text
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([eventType])
  @@index([status])
  @@map("aura_employee_lifecycle_event")
}

// ============================================================================
// 5. SYSTEM / AUTH
// ============================================================================

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String // Hashed
  firstName String?
  lastName  String?
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  employee Employee?

  // User Management Fields
  status     String    @default("Active") // Active, Inactive, Suspended
  mfaEnabled Boolean   @default(false)
  lastLogin  DateTime?

  // Relations
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  delegatedTo         UserDelegation[]     @relation("Delegator")
  delegatedFrom       UserDelegation[]     @relation("Delegatee")
  deactivations       UserDeactivation[]
  passwordResetTokens PasswordResetToken[]
  mfaSecret           MFASecret?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  // Role assignments
  roles UserRole[]

  @@index([tenantId])
  @@index([email, tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([email])
  @@index([lastLogin])
  @@map("aura_user")
}

// ============================================================================
// 5B. ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================================================

model Role {
  id          String    @id @default(uuid())
  tenantId    String? // null for system-wide roles
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  code        String // SUPER_ADMIN, ADMIN, HR_MANAGER, etc.
  name        String
  description String?
  isSystem    Boolean   @default(false) // System roles cannot be deleted
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  // Relations
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@map("aura_role")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  tenantId   String
  assignedBy String? // User ID who assigned this role
  assignedAt DateTime  @default(now())
  expiresAt  DateTime? // Optional: For temporary role assignments

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([expiresAt])

  @@map("aura_user_role")
}

model Permission {
  id          String    @id @default(uuid())
  resource    String // users, employees, departments, etc.
  action      String // create, read, update, delete, manage
  description String?
  createdAt   DateTime  @default(now())
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("aura_permission")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])

  @@map("aura_role_permission")
}

// 5C. Password Reset
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // Hashed token for security
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  ipAddress String? // Track where reset was requested from

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("aura_password_reset_token")
}

// 5D. Multi-Factor Authentication (MFA)
model MFASecret {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String? // Encrypted TOTP secret for authenticator apps
  backupCodes Json? // Array of hashed backup codes
  phoneNumber String? // For SMS-based MFA (future)
  method      String    @default("totp") // totp, sms, email
  isEnabled   Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("aura_mfa_secret")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("aura_refresh_token")
}

// ============================================================================
// 6. MASTER DATA (General & System)
// ============================================================================

model Currency {
  id     String @id @default(uuid())
  code   String @unique // USD, EUR
  name   String
  symbol String
  status String @default("Active") // Active, Inactive

  @@map("aura_currency")
}

model Language {
  id     String  @id @default(uuid())
  code   String  @unique // en, es
  name   String
  isRTL  Boolean @default(false)
  status String  @default("Active")

  @@map("aura_language")
}

model DocumentType {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  description String?
  isRequired  Boolean            @default(false)
  status      String             @default("Active")
  documents   EmployeeDocument[]
  @@map("aura_document_type")
}

// ============================================================================
// 7. ORGANIZATION MASTERS
// ============================================================================

model BusinessUnit {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  head   String?
  status String  @default("Active")

  @@map("aura_business_unit")
}

model Designation {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  gradeId     String?
  description String?
  status      String  @default("Active")

  @@map("aura_designation")
}

// ============================================================================
// 8. EMPLOYMENT MASTERS
// ============================================================================

model Skill {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  category    String?
  description String?
  status      String    @default("Active")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  @@map("aura_skill")
}

model Competency {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  status      String  @default("Active")

  @@map("aura_competency")
}

// ============================================================================
// 9. TIME & LEAVE MASTERS
// ============================================================================

model LeaveType {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  isPaid    Boolean   @default(true)
  status    String    @default("Active")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@map("aura_leave_type")
}

model ShiftType {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  startTime String
  endTime   String
  status    String @default("Active")
  @@map("aura_shift_type")
}

model Holiday {
  id     String @id @default(uuid())
  name   String
  date   String // YYYY-MM-DD
  type   String // National, Regional
  status String @default("Active")

  @@map("aura_holiday")
}

// ============================================================================
// 9.5 ATTENDANCE & WORKFORCE MANAGEMENT
// ============================================================================

// Time Tracking - Clock In/Out Records
model AttendancePunch {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  punchDate  DateTime
  punchTime  DateTime
  punchType  String // CLOCK_IN, CLOCK_OUT, BREAK_START, BREAK_END
  location   String? // GPS coordinates or location name
  device     String? // Mobile, Web, Biometric
  ipAddress  String?
  photo      String? // Photo capture URL
  notes      String?

  // Verification
  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?

  // Regularization
  isRegularized        Boolean @default(false)
  regularizedBy        String?
  regularizationReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([tenantId])
  @@index([employeeId])
  @@index([punchDate])
  @@index([punchType])
  @@index([punchTime])
  @@index([employeeId, punchTime])
  @@map("aura_attendance_punch")
}

// Daily Attendance Summary
model AttendanceRecord {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  date       DateTime

  // Shift Info
  shiftId        String?
  shiftStartTime DateTime?
  shiftEndTime   DateTime?

  // Actual Times
  clockIn  DateTime?
  clockOut DateTime?

  // Calculated Hours
  workHours     Float @default(0)
  breakHours    Float @default(0)
  overtimeHours Float @default(0)

  // Status
  status     String // PRESENT, ABSENT, HALF_DAY, LATE, EARLY_OUT, ON_LEAVE, HOLIDAY, WEEK_OFF
  isLate     Boolean @default(false)
  isEarlyOut Boolean @default(false)

  // Regularization
  isRegularized    Boolean @default(false)
  regularizationId String?

  // Approval
  approvalStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     String?
  approvedAt     DateTime?

  remarks String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
  @@map("aura_attendance_record")
}

// Shift Definitions
model Shift {
  id          String  @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?

  // Timing
  startTime       String // HH:MM format
  endTime         String // HH:MM format
  graceInMinutes  Int    @default(0)
  graceOutMinutes Int    @default(0)

  // Break Configuration
  breakDuration Int     @default(0) // Minutes
  isPaidBreak   Boolean @default(true)

  // Work Hours
  workHours   Float // Standard work hours
  weekendDays String[] // e.g., ["Saturday", "Sunday"]

  // Overtime
  overtimeAllowed  Boolean @default(false)
  maxOvertimeHours Float   @default(0)

  // Flexibility
  isFlexible Boolean @default(false)
  flexWindow Int     @default(0) // Minutes of flex allowed

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignments ShiftAssignment[]
  rosters     ShiftRoster[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
  @@map("aura_shift")
}

// Employee Shift Assignments
model ShiftAssignment {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String
  shiftId    String
  shift      Shift  @relation(fields: [shiftId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive   Boolean @default(true)
  assignedBy String?
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([effectiveFrom])

  @@map("aura_shift_assignment")
}

// Shift Roster (Weekly/Monthly Planning)
model ShiftRoster {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String
  shiftId    String
  shift      Shift  @relation(fields: [shiftId], references: [id])

  rosterDate DateTime

  // Override shift times if needed
  customStartTime String?
  customEndTime   String?

  isWeekOff Boolean @default(false)
  isHoliday Boolean @default(false)

  status String @default("SCHEDULED") // SCHEDULED, COMPLETED, SWAPPED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId, rosterDate])
  @@index([tenantId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([rosterDate])
  @@map("aura_shift_roster")
}

// Shift Swap Requests
model ShiftSwapRequest {
  id          String @id @default(uuid())
  tenantId    String
  requestorId String // Employee requesting swap
  swapWithId  String // Employee to swap with

  requestorDate    DateTime
  requestorShiftId String

  swapWithDate    DateTime
  swapWithShiftId String

  reason String

  // Approval Workflow
  status           String    @default("PENDING") // PENDING, APPROVED_BY_PEER, APPROVED_BY_MANAGER, REJECTED, COMPLETED
  swapWithApproval String    @default("PENDING") // PENDING, APPROVED, REJECTED
  managerApproval  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([requestorId])
  @@index([swapWithId])
  @@index([status])
  @@map("aura_shift_swap_request")
}

// Overtime Management
model OvertimeRequest {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  overtimeDate DateTime
  startTime    DateTime
  endTime      DateTime

  totalHours Float

  // Type
  overtimeType String // REGULAR, HOLIDAY, WEEKEND

  // Justification
  reason          String
  workDescription String?
  project         String?

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  // Compensation
  compensationType String? // PAID, COMP_OFF
  isCompensated    Boolean   @default(false)
  compensatedAt    DateTime?

  // Actual
  actualHours Float?
  verifiedBy  String?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([overtimeDate])
  @@index([status])
  @@map("aura_overtime_request")
}

// Attendance Regularization Requests
model AttendanceRegularization {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  date DateTime

  // What needs regularization
  regularizationType String // MISSED_PUNCH, EARLY_OUT, LATE_IN, WRONG_PUNCH

  // Requested Times
  requestedClockIn  DateTime?
  requestedClockOut DateTime?

  // Justification
  reason      String
  attachments String[] @default([])

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("aura_attendance_regularization")
}

// Comp-Off (Compensatory Off) Management
model CompOffRequest {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  // Earned from overtime/holiday work
  earnedDate  DateTime
  earnedHours Float

  // Usage
  status String @default("EARNED") // EARNED, APPLIED, APPROVED, AVAILED, EXPIRED, CANCELLED

  // When applying comp-off as leave
  appliedDate DateTime?
  expiryDate  DateTime

  // Approval
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([expiryDate])
  @@map("aura_comp_off_request")
}

