  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ============================================================================
// 29. INDIA STATUTORY COMPLIANCE - PF (PROVIDENT FUND)
// ============================================================================

model IndiaPFConfiguration {
  id        String @id @default(uuid())
  tenantId  String
  companyId String

  // EPFO Registration
  epfoEstablishmentId    String // Establishment ID
  epfoRegistrationNumber String // PF Code

  // Rates (can be customized per company)
  employeeContributionRate Decimal @default(12) // 12%
  employerContributionRate Decimal @default(12) // 12%
  adminChargesRate         Decimal @default(0.5) // 0.50%
  edliChargesRate          Decimal @default(0.5) // 0.50%
  wageCeiling              Decimal @default(15000) // PF wage ceiling
  pensionWageCeiling       Decimal @default(15000) // EPS ceiling

  // Settings
  isVoluntaryHigherAllowed Boolean @default(true)
  isActive                 Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions IndiaPFSubmission[]

  @@unique([tenantId, companyId])
  @@index([tenantId])
}

model IndiaPFSubmission {
  id                String               @id @default(uuid())
  tenantId          String
  configId          String
  config            IndiaPFConfiguration @relation(fields: [configId], references: [id])
  contributionMonth String // YYYY-MM format

  // Status
  status         IndiaPFStatus @default(DRAFT)
  submissionDate DateTime?

  // Totals
  totalEmployees            Int     @default(0)
  totalWages                Decimal @default(0)
  totalEmployeeContribution Decimal @default(0)
  totalEmployerPF           Decimal @default(0)
  totalEmployerEPS          Decimal @default(0)
  totalAdminCharges         Decimal @default(0)
  totalEDLI                 Decimal @default(0)
  grandTotal                Decimal @default(0)

  // File Info
  ecrFileName   String?
  ecrFileUrl    String?
  challanNumber String?
  trrn          String? // Transaction Reference Number

  // Validation
  validationErrors Json?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  records IndiaPFRecord[]

  @@index([tenantId])
  @@index([contributionMonth])
  @@index([status])
}

model IndiaPFRecord {
  id           String            @id @default(uuid())
  submissionId String
  submission   IndiaPFSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  employeeId   String

  // Employee Details
  uanNumber         String
  pfAccountNumber   String?
  employeeName      String
  fatherHusbandName String?
  dateOfJoining     DateTime?
  dateOfExit        DateTime?
  gender            String?

  // Salary Details
  basicWages         Decimal
  dearnessAllowance  Decimal @default(0)
  contributableWages Decimal

  // Contributions
  employeeContribution    Decimal
  employerPFContribution  Decimal
  employerEPSContribution Decimal
  isVoluntaryHigher       Boolean @default(false)

  // NCP Days (Non-Contributing Period)
  ncpDays Int @default(0)

  // Status
  status       IndiaPFRecordStatus @default(PENDING)
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([employeeId])
  @@index([uanNumber])
}

enum IndiaPFStatus {
  DRAFT
  VALIDATING
  VALIDATED
  SUBMITTED
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

enum IndiaPFRecordStatus {
  PENDING
  VALID
  INVALID
  SUBMITTED
  ACCEPTED
  REJECTED
}

