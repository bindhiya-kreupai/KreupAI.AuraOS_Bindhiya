// ============================================================================
// 27. LEAVE POLICY & ACCRUAL ENGINE
// ============================================================================

model LeavePolicy {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String? // null for tenant-wide policy
  countryCode String?

  // Policy Details
  code        String
  name        String
  nameAr      String?
  leaveTypeId String

  // Eligibility
  employmentTypes  Json? // Array of employment type codes
  minServiceMonths Int   @default(0)

  // Entitlement
  annualEntitlement Decimal
  accrualType       LeaveAccrualType @default(MONTHLY)
  accrualRate       Decimal? // For monthly accrual

  // Carry Forward
  allowCarryForward        Boolean  @default(true)
  maxCarryForwardDays      Decimal?
  carryForwardExpiryMonths Int?

  // Encashment
  allowEncashment   Boolean  @default(false)
  maxEncashmentDays Decimal?
  encashmentRate    Decimal  @default(100) // Percentage of salary

  // Negative Balance
  allowNegativeBalance Boolean  @default(false)
  maxNegativeDays      Decimal?

  // Rules
  minConsecutiveDays Int?
  maxConsecutiveDays Int?
  advanceNoticeDays  Int     @default(0)
  requiresApproval   Boolean @default(true)
  requiresDocument   Boolean @default(false) // e.g., medical certificate

  // Pro-rata
  proRataOnJoining Boolean @default(true)
  proRataOnExit    Boolean @default(true)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances LeaveBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([countryCode])
  @@map("aura_leave_policy")
}

model LeaveBalance {
  id         String      @id @default(uuid())
  tenantId   String
  employeeId String
  policyId   String
  policy     LeavePolicy @relation(fields: [policyId], references: [id])
  leaveYear  Int // e.g., 2025

  // Balance Tracking
  openingBalance Decimal @default(0)
  accrued        Decimal @default(0)
  taken          Decimal @default(0)
  adjusted       Decimal @default(0)
  encashed       Decimal @default(0)
  carriedForward Decimal @default(0)
  lapsed         Decimal @default(0)
  currentBalance Decimal @default(0)

  lastAccrualDate DateTime?
  lastUpdated     DateTime  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([employeeId, policyId, leaveYear])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveYear])
  @@map("aura_leave_balance")
}

enum LeaveAccrualType {
  ANNUAL // All at once at year start
  MONTHLY // Pro-rata monthly
  QUARTERLY // Pro-rata quarterly
  TENURE // Based on years of service
}

// Leave Request - Employee leave applications
model LeaveRequest {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  // Leave Details
  leaveTypeId  String
  policyId     String?
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal
  halfDayStart Boolean  @default(false)
  halfDayEnd   Boolean  @default(false)

  // Application Details
  reason               String  @db.Text
  contactNumber        String?
