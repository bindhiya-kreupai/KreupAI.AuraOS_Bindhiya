  paymentReference String?
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([payrollMonth])
}

// Leave Accrual History - Track monthly/annual accruals
model LeaveAccrual {
  id           String @id @default(uuid())
  tenantId     String
  employeeId   String
  policyId     String
  leaveYear    Int
  accrualMonth Int? // 1-12, null for annual

  // Accrual Details
  accrualDate DateTime
  accruedDays Decimal
  runId       String? // Reference to batch accrual run

  // Pro-rata Factors
  daysWorked    Int?
  proRataFactor Decimal? @default(1.0)

  // Calculation Notes
  calculationNote String? @db.Text

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([policyId])
  @@index([leaveYear])
  @@index([accrualDate])
}

// Leave Carry Forward - Track year-end carry forwards
model LeaveCarryForward {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String
  policyId   String

  // Year Transition
  fromYear Int
  toYear   Int

  // Carry Forward Details
  previousYearBalance  Decimal
  carryForwardEligible Decimal
  carryForwardApplied  Decimal
  lapsed               Decimal

  // Expiry
  expiryDate  DateTime?
  isExpired   Boolean   @default(false)
  expiredDays Decimal   @default(0)

  processedAt DateTime @default(now())
  runId       String? // Reference to batch carry forward run

  createdAt DateTime @default(now())

  @@unique([employeeId, policyId, fromYear, toYear])
  @@index([tenantId])
  @@index([employeeId])
  @@index([toYear])
}

// Comp-Off (Compensatory Off) - Earned time off for working on holidays/weekends
model CompOffEarned {
  id         String @id @default(uuid())
  tenantId   String
  employeeId String

  // Worked Day Details
  workedDate        DateTime
  workedHours       Decimal
  reason            String   @db.Text
  projectCode       String?
  overtimeRequestId String? // Link to OvertimeRequest if applicable

  // Comp Off Credit
  creditedDays Decimal // 0.5 or 1.0
  expiryDate   DateTime

  // Usage
  isUsed             Boolean   @default(false)
  usedDate           DateTime?
  usedLeaveRequestId String?
  remainingDays      Decimal

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED, USED
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@index([workedDate])
  @@index([expiryDate])
}

// ============================================================================
// 28. LOCALIZATION & TRANSLATIONS
// ============================================================================

model Translation {
  id        String  @id @default(uuid())
  tenantId  String? // null for system-wide
  locale    String // en-US, ar-SA, ar-AE, etc.
  namespace String // common, employee, payroll, leave, etc.
  key       String
  value     String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locale, namespace, key])
  @@index([locale])
  @@index([namespace])
}

model LocalizationConfig {
  id       String @id @default(uuid())
  tenantId String @unique

  // Language Settings
  defaultLocale    String @default("en-US")
  supportedLocales Json   @default("[\"en-US\", \"ar-SA\"]")
  fallbackLocale   String @default("en-US")

  // Regional Settings
  defaultTimezone String  @default("Asia/Dubai")
  defaultCurrency String  @default("AED")
  defaultCalendar String  @default("gregorian") // gregorian, hijri
  showHijriDates  Boolean @default(false)

  // Date/Time Format
  dateFormat     String @default("DD/MM/YYYY")
  timeFormat     String @default("12h") // 12h, 24h
