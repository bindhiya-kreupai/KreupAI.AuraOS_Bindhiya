  code      String    @unique(map: "BusinessUnit_code_key")
  name      String
  head      String?
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  @@map("aura_business_unit")
}

model Designation {
