model LeavePolicy {
  id                  String   @id @default(uuid())
  tenantId            String
  companyId           String?  // null for tenant-wide policy
  countryCode         String?

  // Policy Details
  code                String
  name                String
  nameAr              String?
  leaveTypeId         String

