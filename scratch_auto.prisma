
// ==========================================
// AUTOMOTIVE MODULE
// ==========================================

model Technician {
  id                   String   @id @default(uuid())
  technicianId         String   @unique
  name                 String
  email                String
  phone                String
  role                 String
  status               String
  certifications       Json
  skills               Json
  hireDate             DateTime
  hourlyRate           Float
  availability         Json
  performance          Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TechnicianShift {
  id                   String   @id @default(uuid())
  shiftId              String   @unique
  technicianId         String
  technicianName       String
  date                 DateTime
  startTime            String
  endTime              String
  type                 String
  status               String
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RosterTemplate {
  id                   String   @id @default(uuid())
  templateId           String   @unique
  name                 String
  description          String
  department           String
  weeks                Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ShiftSwapRequest {
  id                   String   @id @default(uuid())
  requestId            String   @unique
  requestingTechId     String
  requestingTechName   String
  targetTechId         String
  targetTechName       String
  originalShiftId      String
  targetShiftId        String
  date                 DateTime
  reason               String
  status               String
  approvedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TimeOffRequest {
  id                   String   @id @default(uuid())
  requestId            String   @unique
  technicianId         String
  technicianName       String
  type                 String
  startDate            DateTime
  endDate              DateTime
  status               String
  reason               String
  approvedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SalesPerson {
  id                   String   @id @default(uuid())
  salesPersonId        String   @unique
  name                 String
  email                String
  department           String
  baseSalary           Float
  commissionRate       Float
  status               String
  performance          Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SalesCommission {
  id                   String   @id @default(uuid())
  commissionId         String   @unique
  salesPersonId        String
  salesPersonName      String
  period               String
  totalSales           Float
  commissionAmount     Float
  bonusAmount          Float
  deductions           Float
  netCommission        Float
  status               String
  salesDetails         Json
  bonuses              Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model VehicleSale {
  id                   String   @id @default(uuid())
  saleId               String   @unique
  salesPersonId        String
  vin                  String
  make                 String
  model                String
  year                 Int
  salePrice            Float
  costPrice            Float
  grossProfit          Float
  saleDate             DateTime
  customerName         String
  status               String
  commissionAmount     Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ServiceSale {
  id                   String   @id @default(uuid())
  saleId               String   @unique
  advisorId            String
  technicianId         String
  repairOrderId        String
  serviceType          String
  laborAmount          Float
  partsAmount          Float
  totalAmount          Float
  saleDate             DateTime
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CommissionStructure {
  id                   String   @id @default(uuid())
  structureId          String   @unique
  name                 String
  department           String
  type                 String
  tiers                Json
  rules                Json
  effectiveDate        DateTime
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Part {
  id                   String   @id @default(uuid())
  partId               String   @unique
  partNumber           String
  name                 String
  description          String
  category             String
  manufacturer         String
  costPrice            Float
  retailPrice          Float
  quantityOnHand       Int
  reorderPoint         Int
  reorderQuantity      Int
  location             Json
  applicableVehicles   Json
  suppliers            Json
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model InventoryMovement {
  id                   String   @id @default(uuid())
  movementId           String   @unique
  partId               String
  partNumber           String
  type                 String
  quantity             Int
  date                 DateTime
  reference            String
  notes                String?
  performedBy          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PurchaseOrder {
  id                   String   @id @default(uuid())
  orderId              String   @unique
  supplierId           String
  supplierName         String
  date                 DateTime
  expectedDeliveryDate DateTime?
  status               String
  totalAmount          Float
  items                Json
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model StockAdjustment {
  id                   String   @id @default(uuid())
  adjustmentId         String   @unique
  date                 DateTime
  type                 String
  reason               String
  items                Json
  status               String
  approvedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
