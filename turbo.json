{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": [
        "NODE_ENV"
    ],
    "globalDependencies": [
        ".env"
    ],
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "test": {}
    }
}