/// Benefit notification campaign — an HR-authored message (reminder / info) that
/// is queued for delivery to employees over one or more channels. Persists the
/// "Create New Campaign" action from /dashboard/benefits/notification.
model BenefitCampaign {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  /// 'Urgent' | 'Info'
  type      String   @default("Info")
  /// Free-text delivery channel, e.g. "Email & Push", "Email".
  channel   String   @default("Email")
  message   String
  /// 'DRAFT' | 'QUEUED' | 'SENT' | 'CANCELLED'
  status    String   @default("QUEUED")
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  deletedAt DateTime?

  @@index([tenantId])
  @@index([status])
  @@map("aura_benefit_campaign")
}
