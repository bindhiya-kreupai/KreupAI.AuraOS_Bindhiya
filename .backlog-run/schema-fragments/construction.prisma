// Construction & Real Estate module models.
// Each entity keeps a stable set of query/filter columns plus a `data` JSON
// blob that carries the rich nested payload defined in
// apps/web/src/app/dashboard/construction/types.ts. All models are tenant
// scoped. Access from route code via (prisma as any).<camelCaseModelName>.

model ConstructionProject {
  id            String    @id @default(uuid())
  tenantId      String
  projectName   String
  projectNumber String
  projectType   String
  status        String    @default("planning")
  clientName    String?
  data          Json      @default("{}")
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([status])
  @@map("aura_construction_project")
}

model ConstructionTask {
  id        String    @id @default(uuid())
  tenantId  String
  projectId String
  taskName  String
  status    String    @default("not_started")
  priority  String    @default("medium")
  data      Json      @default("{}")
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
  @@index([projectId])
  @@map("aura_construction_task")
}

