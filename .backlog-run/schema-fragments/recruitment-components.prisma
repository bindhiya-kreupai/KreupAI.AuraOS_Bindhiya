// Access at runtime via (prisma as any).candidateMessage.

/// Candidate outbound/inbound communication log (email / SMS) for the
/// Candidate Communication Hub. Threads are derived by grouping on candidateId.
model CandidateMessage {
  id            String    @id @default(uuid())
  tenantId      String
  candidateId   String
  applicationId String?
  channel       String    @default("email") // 'email' | 'sms'
  direction     String    @default("outbound") // 'outbound' | 'inbound'
  status        String    @default("sent") // pending | sent | delivered | read | failed
  subject       String?
  body          String
  sender        String?
  senderRole    String?
  sentAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  deletedAt     DateTime?
  isDeleted     Boolean   @default(false)

  @@index([tenantId])
  @@index([tenantId, candidateId])
  @@map("aura_candidate_message")
}
