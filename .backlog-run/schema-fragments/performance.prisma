// Performance Module backlog schema fragments.
// These are documented here (NOT added to schema.prisma per SCHEMA RULE) and
// accessed at runtime via (prisma as any).<delegate>. Backed by the defensive
// migration 20260702170000_add_performance_rewards_nominations_goaltemplates.

// delegate: (prisma as any).rewardCatalog
model RewardCatalog {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    String    @default("Perks")
  cost        Int       @default(0)
  image       String?
  stock       Int?
  isActive    Boolean   @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([category])
  @@map("aura_reward_catalog")
}

// delegate: (prisma as any).rewardPointLedger
// Employee balance = SUM(points) grouped by employeeId.
model RewardPointLedger {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  points      Int      @default(0)
  reason      String?
  source      String   @default("manual")
  referenceId String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, employeeId])
  @@map("aura_reward_point_ledger")
}

// delegate: (prisma as any).rewardRedemption
model RewardRedemption {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  rewardId   String
  rewardName String
  cost       Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, employeeId])
  @@map("aura_reward_redemption")
}

// delegate: (prisma as any).feedback360Nomination
model Feedback360Nomination {
  id          String   @id @default(cuid())
  tenantId    String
  nominatorId String
  nomineeId   String?
  nomineeName String
  cycleId     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([tenantId, nominatorId])
  @@map("aura_feedback360_nomination")
}

// delegate: (prisma as any).goalTemplate
model GoalTemplate {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  category        String    @default("General")
  metric          String?
  suggestedTarget String?
  tags            String[]  @default([])
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([category])
  @@map("aura_goal_template")
}
